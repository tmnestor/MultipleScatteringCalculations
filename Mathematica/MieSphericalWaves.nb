         " ", 
        RowBox[{"u", " ", "->", " ", 
         RowBox[{"z", "/", 
          RowBox[{"rX", "[", 
           RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}]}]}]}], ")"}]}], 
     " ", "*", " ", 
     RowBox[{"(", 

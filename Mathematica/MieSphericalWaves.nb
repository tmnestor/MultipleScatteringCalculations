         RowBox[{"G", " ", "+", " ", 
          RowBox[{"Transpose", "[", "G", "]"}]}], ")"}]}]}]}], "]"}]}], ";"}],
   "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"tau_", "3"}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"sigma", " ", ".", " ", "zhat", ".", "  ", "Equivalently"}], " ",
        "Tn", " ", "from", " ", "the", " ", "archive", " ", "with", " ", 
       "norm"}], " ", "=", " ", "zhat"}]}], ",", "\n", "   ", 
    RowBox[{"which", " ", "Section", " ", "3", " ", 
     RowBox[{"checks", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"tau3Of", "[", 
     RowBox[{
     "u_", ",", " ", "lam_", ",", " ", "mu_", ",", " ", "x_", ",", " ", "y_", 
      ",", " ", "z_"}], "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{"stressOf", "[", 
      RowBox[{
      "u", ",", " ", "lam", ",", " ", "mu", ",", " ", "x", ",", " ", "y", ",",
        " ", "z"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", " ", "3"}], "]"}], "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Exact", " ", 
     RowBox[{"rationals", ":", " ", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{"expr", ",", " ", "30"}], "]"}], " ", "cannot", " ", 
       "manufacture", " ", "precision", " ", "the", " ", "inputs", " ", 
       "lack"}]}]}], ",", "\n", "   ", 

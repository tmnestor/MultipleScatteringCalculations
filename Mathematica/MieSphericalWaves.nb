                 RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], ",", " ", "30"}], 
            "]"}], "]"}]}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"nm", ",", " ", "$nm"}], "}"}]}], "]"}], ";", "\n", "  ", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<        real direction, worst absolute: \>\"", ",", " ", 
       RowBox[{"N", "[", 
        RowBox[{"worst", ",", " ", "3"}], "]"}]}], "]"}], ";", "\n", "  ", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<        complex direction stays finite: \>\"", ",", "\n", 
       "    ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{"$nm", ",", " ", 
         RowBox[{
          RowBox[{"FreeQ", "[", 
           RowBox[{
            RowBox[{"N", "[", 
             RowBox[{"Y", "[", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
               RowBox[{"3", "/", "10"}], ",", " ", 
               RowBox[{
                RowBox[{"-", "1"}], "/", "5"}], ",", " ", 
               RowBox[{"2", " ", "I"}]}], "]"}], "]"}], ",", " ", 
            RowBox[{"DirectedInfinity", " ", "|", " ", "Indeterminate"}]}], 
           "]"}], " ", "&"}]}], "]"}]}], "]"}]}]}], "]"}], ";"}]}], "Input",Ex\
pressionUUID->"dfc399c9-9aa9-4788-9bf8-8034394a8134"],

Cell["\<\
SECTION 2.  The elastic Mie field: potentials, stress, traction.

   Everything Cartesian.  Deriving in spherical components and rotating
   afterwards invites curvilinear basis factors and a representation
   conversion, which is where this project's defects have historically lived.

   Angular factors are polynomial in z/r and carry no removable singularity \
on
   the axis:
     m = 0:  P_n(cos theta)
     m = 1:  P_n^1(cos theta) cos(phi) = -P_n'(z/r) (x/r), using the
             Condon-Shortley relation and Sqrt[1-u^2] cos(phi) = x/r.\
\>", "Text",ExpressionUUID->"fe1ed8de-b6b7-4968-9db3-62ed34930e33"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", "\"\<\\n[2] the elastic Mie field\>\"", "]"}], ";"}],
   "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"angF", "[", 
     RowBox[{"n_", ",", " ", "0"}], "]"}], "[", 
    RowBox[{"x_", ",", " ", "y_", ",", " ", "z_"}], "]"}], " ", ":=", " ", 
   RowBox[{"LegendreP", "[", 
    RowBox[{"n", ",", " ", 
     RowBox[{"z", "/", 
      RowBox[{"rX", "[", 
       RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{

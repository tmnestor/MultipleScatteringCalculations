      RowBox[{"L", "-", "type"}], ")"}]}], ",", " ", 
    RowBox[{"SV", " ", 
     RowBox[{"(", 
      RowBox[{"N", "-", "type"}], ")"}]}], ",", " ", 
    RowBox[{
     RowBox[{"SH", " ", 
      RowBox[{"(", 
       RowBox[{"M", "-", "type"}], ")"}]}], ";", " ", 
     RowBox[{"r", " ", "is", " ", "the", " ", "POSITION", " ", 
      RowBox[{"vector", "."}]}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"uP", "[", 
     RowBox[{"n_", ",", " ", "m_", ",", " ", "kP_"}], "]"}], "[", 
    RowBox[{"x_", ",", " ", "y_", ",", " ", "z_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Grad", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"potF", "[", 
       RowBox[{"n", ",", " ", "m", ",", " ", "kP"}], "]"}], "[", 

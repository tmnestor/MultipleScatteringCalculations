       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"uSH", "[", 
      RowBox[{"n_", ",", " ", "m_", ",", " ", "kS_"}], "]"}], "[", 
     RowBox[{"x_", ",", " ", "y_", ",", " ", "z_"}], "]"}], " ", ":=", "\n", 
    "  ", 
    RowBox[{"Curl", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], " ", 
       RowBox[{
        RowBox[{"potF", "[", 
         RowBox[{"n", ",", " ", "m", ",", " ", "kS"}], "]"}], "[", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stressOf", "[", 
     RowBox[{
     "u_", ",", " ", "lam_", ",", " ", "mu_", ",", " ", "x_", ",", " ", "y_", 
      ",", " ", "z_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"G", " ", "=", " ", 
        RowBox[{"Grad", "[", 
         RowBox[{"u", ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}]}], "]"}]}], 
       "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"lam", " ", 
        RowBox[{"Tr", "[", "G", "]"}], " ", 
        RowBox[{"IdentityMatrix", "[", "3", "]"}]}], " ", "+", " ", 
       RowBox[{"mu", " ", 

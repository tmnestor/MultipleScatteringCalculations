ionUUID->"6881d991-64fc-4717-b722-ef7cc2ff0b27"],

Cell["\<\
SECTION 3.  Validation of the field: divergence, Navier, and Tn.

   [A] div u = -kP^2 phi for the P family and 0 for both shear families.
   [B] Navier, div sigma + rho omega^2 u = 0, in the exterior.  A physics
       identity a wrong component cannot accidentally satisfy, testing every
       component at once.  Normalised by the TERM scale, not by |u|: the two
       terms cancel, so an absolute residual would look small for a wrong
       stress simply because both sides are small.
   [C] the archive's Tn with norm = zhat reproduces tau_3, which ties the two
       independent routes together.\
\>", "Text",ExpressionUUID->"b2cbc449-da65-4ef9-b584-c876c147bb04"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Print", "[", "\"\<\\n[3] validation\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"evalAt", "[", 
     RowBox[{"e_", ",", " ", "x_", ",", " ", "y_", ",", " ", "z_"}], "]"}], 
    " ", ":=", " ", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"e", " ", "/.", " ", 
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], " ", "->", " ", 
         "$p"}], "]"}]}], ",", " ", "30"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "want"}], "}"}], ",",
      "\n", "  ", 
     RowBox[{
      RowBox[{"Print", "[", "\"\<      [A] divergence identities\>\"", "]"}], 
      ";", "\n", "  ", 
      RowBox[{"Do", "[", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"want", " ", "=", " ", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"$kP", "^", "2"}]}], " ", 
           RowBox[{
            RowBox[{"potF", "[", 
             RowBox[{"n", ",", " ", "m", ",", " ", "$kP"}], "]"}], "[", 
            RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}]}]}], ";", "\n",
          "    ", 
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<        n=\>\"", ",", " ", "n", ",", " ", "\"\< m=\>\"",
            ",", " ", "m", ",", "\n", 
           "      ", "\"\<  |div uP + kP^2 phi| \>\"", ",", " ", 
           RowBox[{"Abs", "[", 
            RowBox[{"evalAt", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Div", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"uP", "[", 
                   RowBox[{"n", ",", " ", "m", ",", " ", "$kP"}], "]"}], "[", 
                  
                  RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}], ",", 
                 " ", 
                 RowBox[{"{", 
                  RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}]}], "]"}],
                " ", "-", " ", "want"}], ",", " ", "x", ",", " ", "y", ",", 
              " ", "z"}], "]"}], "]"}], ",", "\n", 
           "      ", "\"\<  |div uSV| \>\"", ",", " ", 
           RowBox[{"Abs", "[", 
            RowBox[{"evalAt", "[", 
             RowBox[{
              RowBox[{"Div", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"uSV", "[", 
                  RowBox[{"n", ",", " ", "m", ",", " ", "$kS"}], "]"}], "[", 
                 RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}]}], "]"}], 
              ",", " ", "x", ",", " ", "y", ",", " ", "z"}], "]"}], "]"}], ",",
            "\n", "      ", "\"\<  |div uSH| \>\"", ",", " ", 
           RowBox[{"Abs", "[", 
            RowBox[{"evalAt", "[", 
             RowBox[{
              RowBox[{"Div", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"uSH", "[", 
                  RowBox[{"n", ",", " ", "m", ",", " ", "$kS"}], "]"}], "[", 
                 RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}]}], "]"}], 
              ",", " ", "x", ",", " ", "y", ",", " ", "z"}], "]"}], "]"}]}], 
          "]"}]}], ",", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "1", ",", " ", "2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}]}], 
    "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "x", ",", " ", "y", ",", " ", "z", ",", " ", "u", ",", " ", "sig", ",", 
       " ", "res", ",", " ", "scale"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{
      "Print", "[", "\"\<      [B] Navier residual (relative)\>\"", "]"}], ";",
       "\n", "  ", 
      RowBox[{"Do", "[", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"u", " ", "=", " ", 
          RowBox[{"Switch", "[", 
           RowBox[{"fam", ",", " ", "\"\<P\>\"", ",", " ", 
            RowBox[{
             RowBox[{"uP", "[", 
              RowBox[{"n", ",", " ", "m", ",", " ", "$kP"}], "]"}], "[", 
             RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}], ",", "\n", 
            "      ", "\"\<SV\>\"", ",", " ", 
            RowBox[{
             RowBox[{"uSV", "[", 
              RowBox[{"n", ",", " ", "m", ",", " ", "$kS"}], "]"}], "[", 
             RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}], ",", 
            " ", "\"\<SH\>\"", ",", " ", 
            RowBox[{
             RowBox[{"uSH", "[", 
              RowBox[{"n", ",", " ", "m", ",", " ", "$kS"}], "]"}], "[", 
             RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}]}], "]"}]}], ";",
          "\n", "    ", 
         RowBox[{"sig", " ", "=", " ", 
          RowBox[{"stressOf", "[", 
           RowBox[{
           "u", ",", " ", "$lam", ",", " ", "$mu", ",", " ", "x", ",", " ", 
            "y", ",", " ", "z"}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"res", " ", "=", " ", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{"sig", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], ",", " ", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}], " ", "+", " ", 
           RowBox[{"$rho", " ", 
            RowBox[{"$om", "^", "2"}], " ", "u"}]}]}], ";", "\n", "    ", 
         RowBox[{"scale", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"evalAt", "[", 
             RowBox[{
              RowBox[{"$rho", " ", 
               RowBox[{"$om", "^", "2"}], " ", "u"}], ",", " ", "x", ",", " ",
               "y", ",", " ", "z"}], "]"}], "]"}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<        \>\"", ",", " ", "fam", ",", " ", "\"\< n=\>\"",
            ",", " ", "n", ",", " ", "\"\< m=\>\"", ",", " ", "m", ",", 
           " ", "\"\<  \>\"", ",", " ", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{"evalAt", "[", 
               RowBox[{"res", ",", " ", "x", ",", " ", "y", ",", " ", "z"}], 
               "]"}], "]"}], "]"}], "/", "scale"}]}], "]"}]}], ",", "\n", 
        "    ", 
        RowBox[{"{", 
         RowBox[{"fam", ",", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<P\>\"", ",", " ", "\"\<SV\>\"", ",", 
            " ", "\"\<SH\>\""}], "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "1", ",", " ", "2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}]}], 
    "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "x", ",", " ", "y", ",", " ", "z", ",", " ", "u", ",", " ", "G", ",", 
      " ", "uu", ",", " ", "viaTn", ",", " ", "viaSig", ",", " ", 
      RowBox[{"worst", " ", "=", " ", "0"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{
     "Print", "[", "\"\<      [C] the archive traction operator Tn against \
tau_3\>\"", "]"}], ";", "\n", "  ", 
     RowBox[{"Do", "[", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"u", " ", "=", " ", 
         RowBox[{"Switch", "[", 
          RowBox[{"fam", ",", " ", "\"\<P\>\"", ",", " ", 
           RowBox[{
            RowBox[{"uP", "[", 
             RowBox[{"n", ",", " ", "0", ",", " ", "$kP"}], "]"}], "[", 
            RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}], ",", "\n", 
           "      ", "\"\<SV\>\"", ",", " ", 
           RowBox[{
            RowBox[{"uSV", "[", 
             RowBox[{"n", ",", " ", "0", ",", " ", "$kS"}], "]"}], "[", 
            RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}], ",", 
           " ", "\"\<SH\>\"", ",", " ", 
           RowBox[{
            RowBox[{"uSH", "[", 
             RowBox[{"n", ",", " ", "0", ",", " ", "$kS"}], "]"}], "[", 
            RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}]}], "]"}]}], ";",
         "\n", "    ", 
        RowBox[{"G", " ", "=", " ", 
         RowBox[{"Grad", "[", 
          RowBox[{"u", ",", " ", 
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}]}], "]"}]}], ";",
         "\n", "    ", 
        RowBox[{
         RowBox[{"uu", "[", 
          RowBox[{"i_", ",", " ", "j_"}], "]"}], " ", ":=", " ", 
         RowBox[{"G", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", " ", "j"}], "]"}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"viaTn", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Tn", "[", 
             RowBox[{"i", ",", " ", "uu", ",", " ", 
              RowBox[{"{", 
               RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], 
            " ", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[Lambda]", " ", "->", " ", "$lam"}], ",", " ", 
              RowBox[{"\[Mu]", " ", "->", " ", "$mu"}]}], "}"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"viaSig", " ", "=", " ", 
         RowBox[{"tau3Of", "[", 
          RowBox[{
          "u", ",", " ", "$lam", ",", " ", "$mu", ",", " ", "x", ",", " ", 
           "y", ",", " ", "z"}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"worst", " ", "=", " ", 
         RowBox[{"Max", "[", 
          RowBox[{"worst", ",", " ", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{"evalAt", "[", 
               RowBox[{
                RowBox[{"viaTn", " ", "-", " ", "viaSig"}], ",", " ", "x", ",",
                 " ", "y", ",", " ", "z"}], "]"}], "]"}], "]"}], " ", "/", 
            "\n", "       ", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{"evalAt", "[", 
               RowBox[{
               "viaSig", ",", " ", "x", ",", " ", "y", ",", " ", "z"}], "]"}],
               "]"}], "]"}]}]}], "]"}]}]}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"fam", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<P\>\"", ",", " ", "\"\<SV\>\"", ",", 
           " ", "\"\<SH\>\""}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "1", ",", " ", "2"}], "}"}]}], "]"}], ";", 
     "\n", "  ", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<        worst relative difference: \>\"", ",", " ", 
       RowBox[{"N", "[", 
        RowBox[{"worst", ",", " ", "3"}], "]"}]}], "]"}]}]}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"9151e226-b914-45ac-9d24-9ff853419a2c"],

Cell["\<\
SECTION 4.  The plane-wave (Weyl) spectrum.

   PW2H0.nb verifies numerically that h_0(K R) is a superposition of plane
   waves with kz on the branch Im(kz) >= 0 -- propagating inside the light
   circle, evanescent outside.  The multipole generalisation replaces the
   constant angular factor by the harmonic evaluated at the PLANE-WAVE
   DIRECTION.

   THE SUBTLETY, MEASURED.  Outside the light circle kz is imaginary, so that
   direction is COMPLEX and its polar angle is complex.  Evaluating the
   harmonic through real angles silently discards the evanescent content: a
   probe done that way reproduced n = 0 to quadrature accuracy and then \
failed
   progressively for n = 1, 2, 3.  The solid harmonic Y[n,m,x,y,z] is
   polynomial in its arguments and takes the complex direction without
   complaint, which is exactly why the archive form is the one to use.\
\>", "Text",ExpressionUUID->"12a6a211-9b72-4dba-9308-be310f43fc04"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<\\n[4] the Weyl spectrum: branch and the complex \
direction\>\"", "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"kzOf", "[", 
     RowBox[{"K_", ",", " ", "kx_", ",", " ", "ky_"}], "]"}], " ", ":=", " ", 
    
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"s", " ", "=", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"K", "^", "2"}], " ", "-", " ", 
          RowBox[{"kx", "^", "2"}], " ", "-", " ", 
          RowBox[{"ky", "^", "2"}]}], "]"}]}], "}"}], ",", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Im", "[", "s", "]"}], " ", "<", " ", "0"}], ",", " ", 
        RowBox[{"-", "s"}], ",", " ", "s"}], "]"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"K", " ", "=", " ", 
       RowBox[{"1", " ", "+", " ", 
        RowBox[{
         RowBox[{"4", "/", "1000"}], " ", "I"}]}]}], ",", " ", "prop", ",", 
      " ", "evan"}], "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"prop", " ", "=", " ", 
      RowBox[{"kzOf", "[", 
       RowBox[{"K", ",", " ", 
        RowBox[{"1", "/", "5"}], ",", " ", 
        RowBox[{"1", "/", "10"}]}], "]"}]}], ";", "\n", "  ", 
     RowBox[{"evan", " ", "=", " ", 
      RowBox[{"kzOf", "[", 
       RowBox[{"K", ",", " ", "3", ",", " ", "1"}], "]"}]}], ";", "\n", "  ", 
     
     RowBox[{"Print", "[", 
      RowBox[{"\"\<      inside the light circle, kz  = \>\"", ",", " ", 
       RowBox[{"N", "[", 
        RowBox[{"prop", ",", " ", "10"}], "]"}], ",", 
       " ", "\"\<  (propagating)\>\""}], "]"}], ";", "\n", "  ", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<      outside, kz                  = \>\"", ",", " ", 
       RowBox[{"N", "[", 
        RowBox[{"evan", ",", " ", "10"}], "]"}], ",", 
       " ", "\"\<  (Im >= 0: decaying)\>\""}], "]"}], ";", "\n", "  ", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<      solid harmonic at the complex direction is finite: \
\>\"", ",", "\n", "    ", 
       RowBox[{"FreeQ", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"Y", "[", 
           RowBox[{"2", ",", " ", "1", ",", " ", "3", ",", " ", "1", ",", " ", 
            RowBox[{"evan", "/", "K"}]}], "]"}], "]"}], ",", " ", 
         RowBox[{"DirectedInfinity", " ", "|", " ", "Indeterminate"}]}], 
        "]"}]}], "]"}]}]}], "]"}], ";"}]}], "Input",ExpressionUUID->"bdce35db-\
b996-46da-b3df-43e5599267fb"],

Cell["SECTION 5.  Reference export for the Python implementation.", "Text",ExpressionUUID->"4ca7aaac-735f-4553-a553-5ddc68327e6a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Print", "[", "\"\<\\n[5] reference export\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", 
       RowBox[{"out", " ", "=", " ", 
        RowBox[{"{", "}"}]}], ",", " ", "u", ",", " ", "t3", ",", " ", "pts", 
       ",", " ", "p"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"pts", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"37", "/", "100"}], ",", " ", 
            RowBox[{
             RowBox[{"-", "61"}], "/", "100"}], ",", " ", 
            RowBox[{"83", "/", "100"}]}], "}"}], " ", "3"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"110", "/", "100"}], ",", " ", 
           RowBox[{"40", "/", "100"}], ",", " ", 
           RowBox[{
            RowBox[{"-", "230"}], "/", "100"}]}], "}"}], ",", "\n", 
         "         ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "90"}], "/", "100"}], ",", " ", 
           RowBox[{"170", "/", "100"}], ",", " ", 
           RowBox[{"110", "/", "100"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"5", "/", "100"}], ",", " ", 
           RowBox[{"2", "/", "100"}], ",", " ", "4"}], "}"}]}], "}"}]}], ";", 
      "\n", "  ", 
      RowBox[{"Do", "[", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"u", " ", "=", " ", 
          RowBox[{"Switch", "[", 
           RowBox[{"fam", ",", " ", "\"\<P\>\"", ",", " ", 
            RowBox[{
             RowBox[{"uP", "[", 
              RowBox[{"n", ",", " ", "m", ",", " ", "$kP"}], "]"}], "[", 
             RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}], ",", "\n", 
            "      ", "\"\<SV\>\"", ",", " ", 
            RowBox[{
             RowBox[{"uSV", "[", 
              RowBox[{"n", ",", " ", "m", ",", " ", "$kS"}], "]"}], "[", 
             RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}], ",", 
            " ", "\"\<SH\>\"", ",", " ", 
            RowBox[{
             RowBox[{"uSH", "[", 
              RowBox[{"n", ",", " ", "m", ",", " ", "$kS"}], "]"}], "[", 
             RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}]}], "]"}]}], ";",
          "\n", "    ", 
         RowBox[{"t3", " ", "=", " ", 
          RowBox[{"tau3Of", "[", 
           RowBox[{
           "u", ",", " ", "$lam", ",", " ", "$mu", ",", " ", "x", ",", " ", 
            "y", ",", " ", "z"}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"p", " ", "=", " ", 
             RowBox[{"pts", "[", 
              RowBox[{"[", "ip", "]"}], "]"}]}], ";", "\n", "      ", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"out", ",", " ", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<family\>\"", " ", "->", " ", "fam"}], ",", " ", 
                RowBox[{"\"\<n\>\"", " ", "->", " ", "n"}], ",", " ", 
                RowBox[{"\"\<m\>\"", " ", "->", " ", "m"}], ",", " ", 
                RowBox[{"\"\<point\>\"", " ", "->", " ", 
                 RowBox[{"N", "[", 
                  RowBox[{"p", ",", " ", "20"}], "]"}]}], ",", "\n", 
                "        ", 
                RowBox[{"\"\<u\>\"", " ", "->", " ", 
                 RowBox[{"(", 
                  RowBox[{"ReIm", " ", "/@", " ", 
                   RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"u", " ", "/.", " ", 
                    RowBox[{"Thread", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], " ", "->",
                     " ", "p"}], "]"}]}], ",", " ", "30"}], "]"}]}], ")"}]}], 
                ",", "\n", "        ", 
                RowBox[{"\"\<tau3\>\"", " ", "->", " ", 
                 RowBox[{"(", 
                  RowBox[{"ReIm", " ", "/@", " ", 
                   RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"t3", " ", "/.", " ", 
                    RowBox[{"Thread", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], " ", "->",
                     " ", "p"}], "]"}]}], ",", " ", "30"}], "]"}]}], 
                  ")"}]}]}], "|>"}]}], "]"}]}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{"ip", ",", " ", 
             RowBox[{"Length", "[", "pts", "]"}]}], "}"}]}], "]"}]}], ",", 
        "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"fam", ",", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<P\>\"", ",", " ", "\"\<SV\>\"", ",", 
            " ", "\"\<SH\>\""}], "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "1", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], ";", 
      "\n", "  ", 
      RowBox[{"Export", "[", 
       RowBox[{"\"\<Mathematica/MieSphericalWaves_reference.json\>\"", ",", 
        "\n", "    ", 
        RowBox[{"<|", 
         RowBox[{
          
          RowBox[{"\"\<note\>\"", " ", "->", 
           " ", "\"\<Cartesian (x,y,z), wave along +z. Python orders axes \
(z,x,y).\>\""}], ",", "\n", "      ", 
          RowBox[{"\"\<lam\>\"", " ", "->", " ", 
           RowBox[{"N", "[", 
            RowBox[{"$lam", ",", " ", "20"}], "]"}]}], ",", " ", 
          RowBox[{"\"\<mu\>\"", " ", "->", " ", 
           RowBox[{"N", "[", 
            RowBox[{"$mu", ",", " ", "20"}], "]"}]}], ",", " ", 
          RowBox[{"\"\<rho\>\"", " ", "->", " ", 
           RowBox[{"N", "[", 
            RowBox[{"$rho", ",", " ", "20"}], "]"}]}], ",", "\n", "      ", 
          RowBox[{"\"\<omega\>\"", " ", "->", " ", 
           RowBox[{"N", "[", 
            RowBox[{"$om", ",", " ", "20"}], "]"}]}], ",", " ", 
          RowBox[{"\"\<kP\>\"", " ", "->", " ", 
           RowBox[{"N", "[", 
            RowBox[{"$kP", ",", " ", "20"}], "]"}]}], ",", " ", 
          RowBox[{"\"\<kS\>\"", " ", "->", " ", 
           RowBox[{"N", "[", 
            RowBox[{"$kS", ",", " ", "20"}], "]"}]}], ",", "\n", "      ", 
          RowBox[{"\"\<cases\>\"", " ", "->", " ", "out"}]}], "|>"}]}], "]"}],
       ";", "\n", "  ", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<      wrote \>\"", ",", " ", 
        RowBox[{"Length", "[", "out", "]"}], ",", " ", "\"\< cases\>\""}], 
       "]"}]}]}], "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\\n=== done ===\>\"", "]"}], ";"}]}], "Input",Exp\
ressionUUID->"5e2d55dd-7f0e-4449-bb5b-bb5a4028ff3f"]
},
WindowSize->{1100, 800},

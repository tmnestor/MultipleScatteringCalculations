Cell["\<\
the degree-7 cell integral, by the hierarchy script's own formula\
\>", "Text",ExpressionUUID->"b6d45623-177b-42f9-a475-276645675688"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"hier`fInt", "[", 
      RowBox[{"7", ",", " ", "s"}], "]"}], " ", "=", " ", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"kk", ",", " ", "lo", ",", " ", "hi"}], "}"}], ",", " ", 
       RowBox[{"Evaluate", "[", "\n", "     ", 
        RowBox[{
         RowBox[{"Integrate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "I"}], " ", "s", " ", "kq", " ", "xq"}], "]"}], " ", 
            RowBox[{
             RowBox[{"xq", "^", "7"}], "/", 
             RowBox[{"7", "!"}]}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"xq", ",", " ", "loq", ",", " ", "hiq"}], "}"}]}], "]"}], 
         " ", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"kq", " ", "->", " ", "kk"}], ",", " ", 
           RowBox[{"loq", " ", "->", " ", "lo"}], ",", " ", 
           RowBox[{"hiq", " ", "->", " ", "hi"}]}], "}"}]}], "]"}]}], "]"}]}],
     ",", " ", 
    RowBox[{"{", 
     RowBox[{"s", ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", 
        RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "]"}], ";"}]], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"957f9e9e-e085-4d24-be60-6b6f08cdd1e9"],

Cell["[1] one model", "Section",ExpressionUUID->"94881ee1-1b43-4ab7-80cd-532f0daecdd2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"eqaOm", " ", "=", " ", "300"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"same", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"hier`al", " ", "==", " ", "gal`al"}], ",", " ", 
     RowBox[{"hier`rho", " ", "==", " ", "gal`rho"}], ",", " ", 
     RowBox[{"hier`dLayer", " ", "==", " ", "gal`dLayer"}], ",", " ", 
     RowBox[{"hier`dRho0", " ", "==", " ", "gal`dRho"}], ",", "\n", "   ", 
     RowBox[{"hier`dM0", " ", "==", " ", "gal`dM"}], ",", " ", 
     RowBox[{"hier`zR", " ", "==", " ", "gal`zObsR"}], ",", " ", 
     RowBox[{"hier`zT", " ", "==", " ", "gal`zObsT"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exH", " ", "=", " ", 
   RowBox[{"hier`exactScat", "[", 
    RowBox[{"eqaOm", ",", " ", "hier`dRho0", ",", " ", "hier`dM0"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"exG", " ", "=", " ", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"gal`exactScat", "[", "eqaOm", "]"}], ",", " ", "40"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"44b27cd5-1f25-4be5-b058-d9d87aa9bf99"],

Cell["\<\
the incident waves differ in amplitude and phase reference, which cancels in \
|R / T| and in every relative error\
\>", "Text",ExpressionUUID->"7a2b0fa5-0a27-41d6-a3df-350e21715cf7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ratioDiff", " ", "=", " ", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"exH", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "/", 
        RowBox[{"exH", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "]"}], " ", "-", " ", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"exG", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "/", 
        RowBox[{"exG", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "]"}], "/", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"exG", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "/", 
      RowBox[{"exG", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  [1] the two scripts' layers are one model (constants equal; \
|R/T| of their exact solutions to \>\"", ",", "\n", "  ", 
    RowBox[{"eqaSci", "[", "ratioDiff", "]"}], ",", " ", "\"\<): \>\"", ",", 
    " ", 
    RowBox[{"eqaChk", "[", 
     RowBox[{
      RowBox[{"And", " ", "@@", " ", "same"}], " ", "&&", " ", 
      RowBox[{"ratioDiff", " ", "<", " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "30"}]}]}]}], "]"}]}], "]"}], ";"}]}], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"6b5133ea-4ea9-435c-9ff8-03608617dfbe"],

Cell[BoxData[
 TemplateBox[{
  "\"  [1] the two scripts' layers are one model (constants equal; |R/T| of \
their exact solutions to \"", "\"0\"", "\"): \"", "\"PASS\""},
  "RowDefault"]], "Print",ExpressionUUID->"8736f622-cc6b-4f89-9ebd-\
80ded00f880a"],

Cell["[2] the ladders", "Section",ExpressionUUID->"5eecc174-3a9a-4679-8fb6-a204e61643bd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"grids", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", "6", ",", " ",
      "8", ",", " ", "12", ",", " ", "16", ",", " ", "24", ",", " ", "32", ",",
      " ", "48", ",", " ", "64"}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"18f5d716-adbf-4d19-acc1-82fe945443d3"],

Cell["\<\
a ladder stops once its error passes 1e-25, well above the 40-digit floor of \
the Galerkin chain: at omega = 300 the eighth-order schemes are already near \
1e-15 on one cell\
\>", "Text",ExpressionUUID->"0537d7c7-7625-45f2-b304-ccfd06474883"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"floor", " ", "=", " ", 
   RowBox[{"10", "^", 
    RowBox[{"-", "25"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"runGal", "[", 
    RowBox[{"p_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Max", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"gal`solveLayerP", "[", 
        RowBox[{"eqaOm", ",", " ", "n", ",", " ", 
         RowBox[{"p", " ", "+", " ", "1"}]}], "]"}], "/", "exG"}], " ", "-", 
      " ", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"runHier", "[", 
    RowBox[{"q_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Max", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"hier`solveHier", "[", 
        RowBox[{
        "eqaOm", ",", " ", "n", ",", " ", "q", ",", " ", "hier`dRho0", ",", 
         " ", "hier`dM0"}], "]"}], "/", "exH"}], " ", "-", " ", "1"}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ladderOf", "[", "run_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rows", " ", "=", " ", 
        RowBox[{"{", "}"}]}], ",", " ", "e"}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"e", " ", "=", " ", 
          RowBox[{"run", "[", "n", "]"}]}], ";", " ", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"rows", ",", " ", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<n\>\"", " ", "->", " ", "n"}], ",", " ", 
             RowBox[{"\"\<error\>\"", " ", "->", " ", 
              RowBox[{"N", "[", 
               RowBox[{"e", ",", " ", "20"}], "]"}]}]}], "|>"}]}], "]"}], ";",
          " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"e", " ", "<", " ", "floor"}], ",", " ", 
           RowBox[{"Break", "[", "]"}]}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "grids"}], "}"}]}], "]"}], ";", "\n", "   ", 
      "rows"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"c472ded5-0c7c-44e0-b500-e56498dcaaf9"],

Cell["\<\
the apparent order: the mean over the two finest pairs of the ladder (at \
least three grids; Missing if fewer)\
\>", "Text",ExpressionUUID->"e6e9590a-8cac-4f24-8cd8-43b30d5881ca"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"orderOf", "[", "rows_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r", " ", "=", " ", "rows"}], ",", " ", "o"}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "r", "]"}], " ", "<", " ", "3"}], ",", " ", 
        RowBox[{"Return", "[", 
         RowBox[{"Missing", "[", "\"\<fewer than three grids\>\"", "]"}], 
         "]"}]}], "]"}], ";", "\n", "   ", 
      RowBox[{"o", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Log", "[", 
           RowBox[{
            RowBox[{"r", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", " ", "\"\<error\>\""}], "]"}], "]"}], "/", 
            RowBox[{"r", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "\"\<error\>\""}],
               "]"}], "]"}]}], "]"}], "/", 
          RowBox[{"Log", "[", 
           RowBox[{
            RowBox[{"r", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "\"\<n\>\""}], 
              "]"}], "]"}], "/", 
            RowBox[{"r", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", " ", "\"\<n\>\""}], "]"}], "]"}]}], "]"}]}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{
            RowBox[{"Length", "[", "r", "]"}], " ", "-", " ", "1"}]}], 
          "}"}]}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"N", "[", 
       RowBox[{"Mean", "[", 
        RowBox[{"Take", "[", 
         RowBox[{"o", ",", " ", 
          RowBox[{"-", "2"}]}], "]"}], "]"}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"ad1d54b9-f09f-41cb-a433-c47aac628696"],

Cell[BoxData[
 RowBox[{
  RowBox[{"schemes", " ", "=", " ", 
   RowBox[{"{", "\n", "   ", 
    RowBox[{

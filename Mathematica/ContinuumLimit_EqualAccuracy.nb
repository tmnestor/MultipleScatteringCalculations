Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  [3] at equal error (cells; unknowns = cells x unknowns \
a cell):\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"equal", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"g", " ", "=", " ", 
            RowBox[{"SelectFirst", "[", 
             RowBox[{"results", ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"#scheme", " ", "==", " ", "\"\<galerkin\>\""}], " ", 
                "&&", " ", 
                RowBox[{"#order", " ", "==", " ", "ord"}]}], " ", "&"}]}], 
             "]"}]}], ",", "\n", "      ", 
           RowBox[{"h", " ", "=", " ", 
            RowBox[{"SelectFirst", "[", 
             RowBox[{"results", ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"#scheme", " ", "==", " ", "\"\<hierarchy\>\""}], " ",
                 "&&", " ", 
                RowBox[{"#order", " ", "==", " ", "ord"}]}], " ", "&"}]}], 
             "]"}]}]}], "}"}], ",", "\n", "     ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"cg", ",", " ", "ch", ",", " ", "rec"}], "}"}], ",", 
             "\n", "     ", 
             RowBox[{
              RowBox[{"cg", " ", "=", " ", 
               RowBox[{"cellsAt", "[", 
                RowBox[{
                 RowBox[{"g", "[", "\"\<rows\>\"", "]"}], ",", " ", "t"}], 
                "]"}]}], ";", " ", 
              RowBox[{"ch", " ", "=", " ", 
               RowBox[{"cellsAt", "[", 
                RowBox[{
                 RowBox[{"h", "[", "\"\<rows\>\"", "]"}], ",", " ", "t"}], 
                "]"}]}], ";", "\n", "     ", 
              RowBox[{"rec", " ", "=", " ", 
               RowBox[{"<|", 
                RowBox[{
                 RowBox[{"\"\<order\>\"", " ", "->", " ", "ord"}], ",", " ", 
                 RowBox[{"\"\<target\>\"", " ", "->", " ", 
                  RowBox[{"N", "[", "t", "]"}]}], ",", "\n", "       ", 
                 RowBox[{"\"\<galerkin_cells\>\"", " ", "->", " ", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"MissingQ", "[", "cg", "]"}], ",", " ", "Null", ",",
                     " ", 
                    RowBox[{"cg", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ",", " ", 
                 RowBox[{"\"\<galerkin_status\>\"", " ", "->", " ", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"MissingQ", "[", "cg", "]"}], ",", " ", 
                    RowBox[{"First", "[", "cg", "]"}], ",", " ", 
                    RowBox[{"cg", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ",", "\n", 
                 "       ", 
                 RowBox[{"\"\<galerkin_unknowns\>\"", " ", "->", " ", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"MissingQ", "[", "cg", "]"}], ",", " ", "Null", ",",
                     " ", 
                    RowBox[{
                    RowBox[{"cg", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], " ", 
                    RowBox[{"g", "[", "\"\<perCell\>\"", "]"}]}]}], "]"}]}], ",",
                  "\n", "       ", 
                 RowBox[{"\"\<hierarchy_cells\>\"", " ", "->", " ", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"MissingQ", "[", "ch", "]"}], ",", " ", "Null", ",",
                     " ", 
                    RowBox[{"ch", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ",", " ", 
                 RowBox[{"\"\<hierarchy_status\>\"", " ", "->", " ", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"MissingQ", "[", "ch", "]"}], ",", " ", 
                    RowBox[{"First", "[", "ch", "]"}], ",", " ", 
                    RowBox[{"ch", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ",", "\n", 
                 "       ", 
                 RowBox[{"\"\<hierarchy_unknowns\>\"", " ", "->", " ", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"MissingQ", "[", "ch", "]"}], ",", " ", "Null", ",",
                     " ", 
                    RowBox[{
                    RowBox[{"ch", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], " ", 
                    RowBox[{"h", "[", "\"\<perCell\>\"", "]"}]}]}], "]"}]}]}],
                 "|>"}]}], ";", "\n", "     ", 
              RowBox[{"Print", "[", 
               
               RowBox[{"\"\<    order \>\"", ",", " ", "ord", ",", 
                " ", "\"\<, error \>\"", ",", " ", 
                RowBox[{"eqaSci", "[", "t", "]"}], ",", 
                " ", "\"\<:  Galerkin \>\"", ",", "\n", "      ", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"MissingQ", "[", "cg", "]"}], ",", " ", 
                  RowBox[{"First", "[", "cg", "]"}], ",", " ", 
                  RowBox[{
                   RowBox[{"ToString", "[", 
                    RowBox[{"NumberForm", "[", 
                    RowBox[{
                    RowBox[{"cg", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", " ", "3"}], "]"}], 
                    "]"}], " ", "<>", " ", "\"\< cells (\>\"", " ", "<>", " ", 
                   RowBox[{"cg", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], " ", "<>", 
                   " ", "\"\<)\>\""}]}], "]"}], ",", "\n", 
                "      ", "\"\<   hierarchy \>\"", ",", " ", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"MissingQ", "[", "ch", "]"}], ",", " ", 
                  RowBox[{"First", "[", "ch", "]"}], ",", " ", 
                  RowBox[{
                   RowBox[{"ToString", "[", 
                    RowBox[{"NumberForm", "[", 
                    RowBox[{
                    RowBox[{"ch", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", " ", "3"}], "]"}], 
                    "]"}], " ", "<>", " ", "\"\< cells (\>\"", " ", "<>", " ", 
                   RowBox[{"ch", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], " ", "<>", 
                   " ", "\"\<)\>\""}]}], "]"}]}], "]"}], ";", "\n", "     ", 
              "rec"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"t", ",", " ", 
             RowBox[{"targetsOf", "[", 
              RowBox[{"g", ",", " ", "h"}], "]"}]}], "}"}]}], "]"}]}], "]"}], 
       ",", " ", 
       RowBox[{"{", 
        RowBox[{"ord", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4", ",", " ", "6", ",", " ", "8"}], "}"}]}],
         "}"}]}], "]"}], ",", " ", "1"}], "]"}]}], ";"}]}], "Input",

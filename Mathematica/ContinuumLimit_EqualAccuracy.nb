Cell["[3] cells and unknowns at equal error", "Section",ExpressionUUID->"be08a2e1-3bb4-4ac3-9a1a-cafb666bbe42"],

Cell["\<\
the targets of an order: every decade inside the error range that both of its \
ladders reach\
\>", "Text",ExpressionUUID->"64415408-4eff-4785-b6b4-8f055f449883"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"targetsOf", "[", 
    RowBox[{"g_", ",", " ", "h_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"lo", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{"Min", "[", 
           RowBox[{
            RowBox[{"#error", " ", "&"}], " ", "/@", " ", 
            RowBox[{"g", "[", "\"\<rows\>\"", "]"}]}], "]"}], ",", " ", 
          RowBox[{"Min", "[", 
           RowBox[{
            RowBox[{"#error", " ", "&"}], " ", "/@", " ", 
            RowBox[{"h", "[", "\"\<rows\>\"", "]"}]}], "]"}]}], "]"}]}], ",", 
       "\n", "    ", 
       RowBox[{"hi", " ", "=", " ", 
        RowBox[{"Min", "[", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{"#error", " ", "&"}], " ", "/@", " ", 
            RowBox[{"g", "[", "\"\<rows\>\"", "]"}]}], "]"}], ",", " ", 
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{"#error", " ", "&"}], " ", "/@", " ", 
            RowBox[{"h", "[", "\"\<rows\>\"", "]"}]}], "]"}]}], "]"}]}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"lo", " ", ">", " ", "hi"}], ",", " ", 
       RowBox[{"{", "}"}], ",", " ", 
       RowBox[{"10", "^", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"Ceiling", "[", 
           RowBox[{"Log10", "[", 
            RowBox[{"N", "[", "lo", "]"}], "]"}], "]"}], ",", " ", 
          RowBox[{"Floor", "[", 
           RowBox[{"Log10", "[", 
            RowBox[{"N", "[", "hi", "]"}], "]"}], "]"}]}], "]"}]}]}], "]"}]}],
     "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cellsAt", "[", 
    RowBox[{"rows_", ",", " ", "target_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"lad", " ", "=", " ", 
        RowBox[{"SortBy", "[", 
         RowBox[{"rows", ",", " ", 
          RowBox[{"#n", " ", "&"}]}], "]"}]}], ",", " ", "errs", ",", " ", 
       "br"}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"errs", " ", "=", " ", 
       RowBox[{
        RowBox[{"#error", " ", "&"}], " ", "/@", " ", "lad"}]}], ";", "\n", 
      "   ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"target", " ", "<", " ", 
          RowBox[{"Min", "[", "errs", "]"}]}], " ", "||", " ", 
         RowBox[{"target", " ", ">", " ", 
          RowBox[{"Max", "[", "errs", "]"}]}]}], ",", " ", 
        RowBox[{"Return", "[", 
         RowBox[{"Missing", "[", "\"\<outside the ladder\>\"", "]"}], "]"}]}],
        "]"}], ";", "\n", "   ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"r", "[", "\"\<error\>\"", "]"}], "/", "target"}], " ", 
             "-", " ", "1"}], "]"}], " ", "<=", " ", 
           RowBox[{"1", "/", "50"}]}], ",", " ", 
          RowBox[{"Return", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"r", "[", "\"\<n\>\"", "]"}], ",", 
              " ", "\"\<measured\>\""}], "}"}], ",", " ", "Module"}], "]"}]}],
          "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"r", ",", " ", "lad"}], "}"}]}], "]"}], ";", "\n", "   ", 
      RowBox[{"br", " ", "=", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Partition", "[", 
          RowBox[{"lad", ",", " ", "2", ",", " ", "1"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Min", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "\"\<error\>\""}], "]"}], "]"}], ",", 
             " ", 
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", " ", "\"\<error\>\""}], "]"}], "]"}]}], 
            "]"}], " ", "<=", " ", "target", " ", "<=", " ", 
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "\"\<error\>\""}], "]"}], "]"}], ",", 
             " ", 
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", " ", "\"\<error\>\""}], "]"}], "]"}]}], 
            "]"}]}], " ", "&"}]}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "br", "]"}], " ", "!=", " ", "1"}], " ", "||",
          " ", 
         RowBox[{
          RowBox[{"br", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", " ", "2", ",", " ", "\"\<error\>\""}], "]"}], 
           "]"}], " ", ">=", " ", 
          RowBox[{"br", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", " ", "1", ",", " ", "\"\<error\>\""}], "]"}], 
           "]"}]}]}], ",", " ", 
        RowBox[{"Return", "[", 
         RowBox[{"Missing", "[", "\"\<not monotone\>\"", "]"}], "]"}]}], 
       "]"}], ";", "\n", "   ", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"a", " ", "=", " ", 
           RowBox[{"br", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}], ",", " ", 
          RowBox[{"b", " ", "=", " ", 
           RowBox[{"br", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}]}], "}"}], ",", "\n",
         "    ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"Log", "[", 
               RowBox[{"a", "[", "\"\<n\>\"", "]"}], "]"}], " ", "+", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Log", "[", "target", "]"}], " ", "-", " ", 
                 RowBox[{"Log", "[", 
                  RowBox[{"a", "[", "\"\<error\>\"", "]"}], "]"}]}], ")"}], " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Log", "[", 
                   RowBox[{"b", "[", "\"\<n\>\"", "]"}], "]"}], " ", "-", " ", 
                  RowBox[{"Log", "[", 
                   RowBox[{"a", "[", "\"\<n\>\"", "]"}], "]"}]}], ")"}], "/", 
                
                RowBox[{"(", 

         RowBox[{"\"\<dM\>\"", " ", "->", " ", "gal`dM"}], ",", " ", 
         RowBox[{"\"\<zR\>\"", " ", "->", " ", "gal`zObsR"}], ",", " ", 
         RowBox[{"\"\<zT\>\"", " ", "->", " ", "gal`zObsT"}]}], "|>"}]}], ",",
       "\n", "   ", 
      RowBox[{"\"\<rows\>\"", " ", "->", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Join", "[", 
               RowBox[{
                RowBox[{"KeyDrop", "[", 
                 RowBox[{"sc", ",", " ", 
                  RowBox[{"{", 
                   
                   RowBox[{"\"\<rows\>\"", ",", 
                    " ", "\"\<measured_order\>\""}], "}"}]}], "]"}], ",", " ",
                 "#"}], "]"}], " ", "&"}], ",", " ", 
             RowBox[{"sc", "[", "\"\<rows\>\"", "]"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"sc", ",", " ", "results"}], "}"}]}], "]"}], ",", " ", 
         "1"}], "]"}]}], ",", "\n", "   ", 
      RowBox[{"\"\<orders\>\"", " ", "->", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"KeyDrop", "[", 
           RowBox[{"#", ",", " ", "\"\<rows\>\""}], "]"}], " ", "&"}], " ", "/@",
          " ", "results"}], ")"}]}], ",", "\n", "   ", 
      RowBox[{"\"\<equal_accuracy\>\"", " ", "->", " ", "equal"}]}], "|>"}], ",",
     " ", "\"\<JSON\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  exported ContinuumLimit_equal_accuracy.json\>\"", 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"And", " ", "@@", " ", "eqaOks"}], ",", " ", "\"\<ALL PASS\>\"", 
     ",", " ", "\"\<SOME FAILED\>\""}], "]"}], "]"}], ";"}]}], "Input",

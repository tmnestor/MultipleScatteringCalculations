 RowBox[{
  RowBox[{
  "Print", "[", "\"\<==== ContinuumLimit_EqualAccuracy :: the Galerkin voxel \
against the gradient hierarchy on the layer ====\>\"", "]"}], ";"}]}], "Input",\


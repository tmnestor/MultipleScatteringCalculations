Cell["\<\
unknowns a cell, from the solvers' own definitions: 2 nb for the Galerkin \
chain (field and strain, nb Legendre functions each), q + 1 Taylor \
coefficients for the hierarchy\
\>", "Text",ExpressionUUID->"ffdbfacb-59e7-40c0-8472-cffaa92e5949"],

Cell[BoxData[
 RowBox[{
  RowBox[{"schemes", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"sc", " ", "=", " ", "s0"}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"sc", "[", "\"\<perCell\>\"", "]"}], " ", "=", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"sc", "[", "\"\<scheme\>\"", "]"}], " ", "==", 
            " ", "\"\<galerkin\>\""}], ",", " ", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"sc", "[", "\"\<degree\>\"", "]"}], " ", "+", " ", 
              "1"}], ")"}]}], ",", " ", 
           RowBox[{
            RowBox[{"sc", "[", "\"\<q\>\"", "]"}], " ", "+", " ", "1"}]}], 
          "]"}]}], ";", " ", "sc"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"s0", ",", " ", "schemes"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"7af42cd3-7c9c-4e66-b37d-ac49295bc0c1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  [2] ladders, error = max over R and T of \
|discrete/exact - 1|:\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"results", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rows", ",", " ", "ord", ",", " ", "ok", ",", " ", 
         RowBox[{"t0", " ", "=", " ", 
          RowBox[{"AbsoluteTime", "[", "]"}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"rows", " ", "=", " ", 
         RowBox[{"ladderOf", "[", 
          RowBox[{"sc", "[", "\"\<run\>\"", "]"}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"ord", " ", "=", " ", 
         RowBox[{"orderOf", "[", "rows", "]"}]}], ";", "\n", "    ", 
        RowBox[{"ok", " ", "=", " ", 
         RowBox[{
          RowBox[{"!", " ", 
           RowBox[{"MissingQ", "[", "ord", "]"}]}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"ord", " ", "-", " ", 
             RowBox[{"sc", "[", "\"\<order\>\"", "]"}]}], "]"}], " ", "<", 
           " ", "0.15"}]}]}], ";", "\n", "    ", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<    \>\"", ",", " ", 
          RowBox[{"sc", "[", "\"\<scheme\>\"", "]"}], ",", " ", "\"\< \>\"", ",",
           " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"sc", "[", "\"\<scheme\>\"", "]"}], " ", "==", 
             " ", "\"\<galerkin\>\""}], ",", " ", 
            RowBox[{"\"\<p = \>\"", " ", "<>", " ", 
             RowBox[{"ToString", "[", 
              RowBox[{"sc", "[", "\"\<degree\>\"", "]"}], "]"}]}], ",", " ", 
            RowBox[{"\"\<q = \>\"", " ", "<>", " ", 
             RowBox[{"ToString", "[", 
              RowBox[{"sc", "[", "\"\<q\>\"", "]"}], "]"}]}]}], "]"}], ",", 
          "\n", "     ", "\"\< (\>\"", ",", " ", 
          RowBox[{"sc", "[", "\"\<perCell\>\"", "]"}], ",", 
          " ", "\"\< unknowns a cell):  \>\"", ",", "\n", "     ", 
          RowBox[{"StringRiffle", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"\"\<n \>\"", " ", "<>", " ", 
                RowBox[{"ToString", "[", "#n", "]"}], " ", "<>", 
                " ", "\"\< \>\"", " ", "<>", " ", 
                RowBox[{"eqaSci", "[", "#error", "]"}]}], ")"}], " ", "&"}], 
             " ", "/@", " ", "rows"}], ",", " ", "\"\<, \>\""}], "]"}], ",", 
          "\n", "     ", "\"\<   order \>\"", ",", " ", 
          RowBox[{"NumberForm", "[", 
           RowBox[{"ord", ",", " ", "3"}], "]"}], ",", 
          " ", "\"\< (predicted \>\"", ",", " ", 
          RowBox[{"sc", "[", "\"\<order\>\"", "]"}], ",", " ", "\"\<) \>\"", ",",
           " ", 
          RowBox[{"eqaChk", "[", "ok", "]"}], ",", " ", "\"\<   \>\"", ",", 
          " ", 
          RowBox[{"Round", "[", 
           RowBox[{
            RowBox[{"AbsoluteTime", "[", "]"}], " ", "-", " ", "t0"}], "]"}], 
          ",", " ", "\"\< s\>\""}], "]"}], ";", "\n", "    ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"KeyDrop", "[", 
           RowBox[{"sc", ",", " ", "\"\<run\>\""}], "]"}], ",", " ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<rows\>\"", " ", "->", " ", "rows"}], ",", " ", 
            RowBox[{"\"\<measured_order\>\"", " ", "->", " ", "ord"}]}], 
           "|>"}]}], "]"}]}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"sc", ",", " ", "schemes"}], "}"}]}], "]"}]}], ";"}]}], "Input",\

 CellLabel->"In[16]:=",ExpressionUUID->"eefa3035-50a5-4225-be1a-6b184b5cdfef"],


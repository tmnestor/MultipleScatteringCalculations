Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"eqaPass", "[", "b_", "]"}], " ", ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"TrueQ", "[", "b", "]"}], ",", " ", "\"\<PASS\>\"", ",", 
     " ", "\"\<****FAIL****\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"eqaSci", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"N", "[", "x", "]"}], " ", "==", " ", "0"}], ",", 
     " ", "\"\<0\>\"", ",", "\n", "   ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"e", " ", "=", " ", 
         RowBox[{"Floor", "[", 
          RowBox[{"Log10", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"N", "[", "x", "]"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
       " ", 
       RowBox[{
        RowBox[{"ToString", "[", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"N", "[", "x", "]"}], "/", 
            RowBox[{"10", "^", "e"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"3", ",", " ", "2"}], "}"}]}], "]"}], "]"}], " ", "<>", 
        " ", "\"\<e\>\"", " ", "<>", " ", 
        RowBox[{"ToString", "[", "e", "]"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"eqaOks", " ", "=", " ", 

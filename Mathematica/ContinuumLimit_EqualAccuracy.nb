Cell[BoxData[{
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
      "eqaBase", ",", " ", "\"\<ContinuumLimit_equal_accuracy.json\>\""}], 
      "}"}], "]"}], ",", "\n", "  ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<model\>\"", " ", "->", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<omega\>\"", " ", "->", " ", "eqaOm"}], ",", " ", 
         RowBox[{"\"\<layer_m\>\"", " ", "->", " ", "gal`dLayer"}], ",", " ", 
         
         RowBox[{"\"\<alpha\>\"", " ", "->", " ", "gal`al"}], ",", " ", 

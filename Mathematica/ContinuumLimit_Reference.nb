  "RowDefault"]], "Print",ExpressionUUID->"d25e7058-0864-41ae-844e-\
1e1387216049"],

Cell["thin layer: the first-order reflection vs D, symbolic", "Text",ExpressionUUID->"226ee6b5-d8a1-4aaa-9a32-ab6a50aa54ab"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"dz0", ",", " ", "kx"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"firstOrderThin", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{"c1", " ", "/.", " ", 
       RowBox[{"dLayer", " ", "->", " ", "dz0"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"dz0", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}], "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<      first-order term, D -> 0 (leading orders shown \
numerically for D = 2 m): \>\"", ",", "\n", "  ", 
    RowBox[{"sci", "[", 
     RowBox[{
      RowBox[{"Normal", "[", "firstOrderThin", "]"}], " ", "/.", " ", 
      RowBox[{"dz0", " ", "->", " ", "dLayer"}]}], "]"}], ",", 
    " ", "\"\< vs exact first order \>\"", ",", " ", 
    RowBox[{"sci", "[", 
     RowBox[{"N", "[", "c1", "]"}], "]"}]}], "]"}], ";"}]}], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"7a21368c-0cfc-4b1c-8a44-2a4051ff5e5a"],

Cell[BoxData[
 TemplateBox[{
  "\"      first-order term, D -> 0 (leading orders shown numerically for D = \
2 m): \"", "\"-7.92e-13 - 2.55e-13 I\"", "\" vs exact first order \"", 
   "\"-7.92e-13 - 2.55e-13 I\""},
  "RowDefault"]], "Print",ExpressionUUID->"2e0309b8-12cd-4ae4-9ac4-\
81a9254e1b54"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"allPass", " ", "=", " ", 
   RowBox[{
    RowBox[{"worst1", " ", "<", " ", 
     RowBox[{"10", "^", 
      RowBox[{"-", "6"}]}]}], " ", "&&", " ", 
    RowBox[{"worst3", " ", "<", " ", 
     RowBox[{"10", "^", 
      RowBox[{"-", "6"}]}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<==== ContinuumLimit_Reference: \>\"", ",", " ", 
    RowBox[{"If", "[", 
     RowBox[{
     "allPass", ",", " ", "\"\<ALL CHECKS PASS\>\"", ",", 
      " ", "\"\<CHECKS FAILED\>\""}], "]"}], ",", " ", "\"\< ====\>\""}], 
   "]"}], ";"}]}], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"60961bf2-2c95-4c0b-9e39-a9003064a6d9"],


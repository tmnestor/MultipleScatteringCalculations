Cell["[1] whole space, dz != 0.", "Section",ExpressionUUID->"50ce82df-25a2-40ec-9bac-a2054b69356a"],

Cell["\<\
Package rows/cols: 0 u_z, 1 u_x, 3 e_zz, 8 2e_zx; col 0 = force z, col 1 = \
force x.  2 e_zx = d u_x / dz at zero lateral wavenumber.\
\>", "Text",ExpressionUUID->"94123907-61de-4119-9a26-d6ce0372bfb7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"kp0", " ", "=", " ", 
   RowBox[{"kOf", "[", "a0", "]"}]}], ";", " ", 
  RowBox[{"ks0", " ", "=", " ", 
   RowBox[{"kOf", "[", "b0", "]"}]}], ";", " ", 
  RowBox[{"mp0", " ", "=", " ", 
   RowBox[{"mP", "[", 
    RowBox[{"a0", ",", " ", "r0"}], "]"}]}], ";", " ", 
  RowBox[{"ms0", " ", "=", " ", 
   RowBox[{"mS", "[", 
    RowBox[{"b0", ",", " ", "r0"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"checks1", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"dz", " ", "=", " ", 
           RowBox[{"e", "[", "\"\<dz\>\"", "]"}]}], ",", " ", 
          RowBox[{"gm", " ", "=", " ", 
           RowBox[{"mat", "[", 
            RowBox[{"e", "[", "\"\<G\>\"", "]"}], "]"}]}]}], "}"}], ",", "\n",
         "     ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"dz", " ", "==", " ", "0"}], ",", " ", "Nothing", ",", " ", 
          
          RowBox[{"{", "\n", "       ", 
           RowBox[{
            RowBox[{"relErr", "[", 
             RowBox[{
              RowBox[{"g1", "[", 
               RowBox[{"mp0", ",", " ", "kp0", ",", " ", "dz"}], "]"}], ",", 
              " ", 
              RowBox[{"gm", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}], "]"}], ",", 
            "     ", 
            RowBox[{"(*", " ", 
             RowBox[{"u_z", " ", "from", " ", "f_z"}], " ", "*)"}], "\n", 
            "       ", 
            RowBox[{"relErr", "[", 
             RowBox[{
              RowBox[{"dg1", "[", 
               RowBox[{"mp0", ",", " ", "kp0", ",", " ", "dz"}], "]"}], ",", 
              " ", 
              RowBox[{"gm", "[", 
               RowBox[{"[", 
                RowBox[{"4", ",", " ", "1"}], "]"}], "]"}]}], "]"}], ",", 
            "    ", 
            RowBox[{"(*", " ", 
             RowBox[{"e_zz", " ", "from", " ", "f_z"}], " ", "*)"}], "\n", 
            "       ", 
            RowBox[{"relErr", "[", 
             RowBox[{
              RowBox[{"g1", "[", 
               RowBox[{"ms0", ",", " ", "ks0", ",", " ", "dz"}], "]"}], ",", 
              " ", 
              RowBox[{"gm", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", " ", "2"}], "]"}], "]"}]}], "]"}], ",", 
            "     ", 
            RowBox[{"(*", " ", 
             RowBox[{"u_x", " ", "from", " ", "f_x"}], " ", "*)"}], "\n", 
            "       ", 
            RowBox[{"relErr", "[", 
             RowBox[{
              RowBox[{"dg1", "[", 
               RowBox[{"ms0", ",", " ", "ks0", ",", " ", "dz"}], "]"}], ",", 
              " ", 
              RowBox[{"gm", "[", 
               RowBox[{"[", 
                RowBox[{"9", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}], 
           "}"}]}], "]"}]}], "]"}], ",", " ", 
      RowBox[{"(*", " ", 
       RowBox[{"2", " ", "e_zx", " ", "from", " ", "f_x"}], " ", "*)"}], "\n",
       "    ", 
      RowBox[{"{", 
       RowBox[{"e", ",", " ", 
        RowBox[{"ref", "[", "\"\<whole_space\>\"", "]"}]}], "}"}]}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"worst1", " ", "=", " ", 
   RowBox[{"Max", "[", "checks1", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  [1] whole space dz != 0: g and dg/dz, P and S, vs the \
package: worst \>\"", ",", " ", 
    RowBox[{"sci", "[", "worst1", "]"}], ",", "\n", "  ", "\"\< -> \>\"", ",",
     " ", 
    RowBox[{"pass", "[", 
     RowBox[{"worst1", " ", "<", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "6"}]}]}], "]"}]}], "]"}], ";"}]}], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"a28b9967-9a00-4eae-9617-76b06a294fca"],


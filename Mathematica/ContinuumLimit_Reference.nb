Cell["[4] Born series in the contrast, and the thin layer.", "Section",ExpressionUUID->"1a908d46-cd00-4b3d-bbac-13b0f693ad98"],

Cell["\<\
Scale the layer's modulus and density contrasts by eps; expand the reflected \
field at the source side.  These closed forms are what the discrete chain \
must reproduce in the limit.\
\>", "Text",ExpressionUUID->"b20a7094-f743-489f-83ae-ba19643bc159"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "eps", ",", " ", "dm", ",", " ", "dr", ",", " ", "kk", ",", " ", "mm", ",",
     " ", "rr0", ",", " ", "zz", ",", " ", "dd"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bornR", "[", 
    RowBox[{
    "m0_", ",", " ", "r0v_", ",", " ", "dmv_", ",", " ", "drv_", ",", " ", 
     "dd_", ",", " ", "zs_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "m1v", ",", " ", "r1v", ",", " ", "k0v", ",", " ", "k1v", ",", " ", "u",
        ",", " ", "e"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"m1v", " ", "=", " ", 
       RowBox[{"m0", " ", "+", " ", 
        RowBox[{"eps", " ", "dmv"}]}]}], ";", " ", 
      RowBox[{"r1v", " ", "=", " ", 
       RowBox[{"r0v", " ", "+", " ", 
        RowBox[{"eps", " ", "drv"}]}]}], ";", "\n", "  ", 
      RowBox[{"k0v", " ", "=", " ", 
       RowBox[{"om", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"r0v", "/", "m0"}], "]"}]}]}], ";", " ", 
      RowBox[{"k1v", " ", "=", " ", 
       RowBox[{"om", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"r1v", "/", "m1v"}], "]"}]}]}], ";", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "e"}], "}"}], " ", "=", " ", 
       RowBox[{"layerField", "[", 
        RowBox[{
        "m0", ",", " ", "k0v", ",", " ", "m1v", ",", " ", "k1v", ",", " ", 
         "zs", ",", " ", "dd"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"u", "[", "zs", "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  [4] Born series: the reflected field at the source \
depth, P, in powers of the contrast\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dLam", " ", "=", " ", 
   RowBox[{
    RowBox[{"ref", "[", "\"\<contrast_SI\>\"", "]"}], "[", "\"\<dlambda\>\"", 
    "]"}]}], ";", " ", 
  RowBox[{"dMu", " ", "=", " ", 
   RowBox[{
    RowBox[{"ref", "[", "\"\<contrast_SI\>\"", "]"}], "[", "\"\<dmu\>\"", 
    "]"}]}], ";", " ", 
  RowBox[{"dRho", " ", "=", " ", 
   RowBox[{
    RowBox[{"ref", "[", "\"\<contrast_SI\>\"", "]"}], "[", "\"\<drho\>\"", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bornP", " ", "=", " ", 
   RowBox[{"bornR", "[", 
    RowBox[{"mp0", ",", " ", "r0", ",", " ", 
     RowBox[{"dLam", " ", "+", " ", 
      RowBox[{"2", " ", "dMu"}]}], ",", " ", "dRho", ",", " ", "dLayer", ",", 
     " ", "zSrc"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"serP", " ", "=", " ", 
   RowBox[{"Series", "[", 
    RowBox[{"bornP", ",", " ", 
     RowBox[{"{", 
      RowBox[{"eps", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"exactP", " ", "=", " ", 
   RowBox[{"bornP", " ", "/.", " ", 
    RowBox[{"eps", " ", "->", " ", "1"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"c0", " ", "=", " ", 
   RowBox[{"SeriesCoefficient", "[", 
    RowBox[{"serP", ",", " ", "0"}], "]"}]}], ";", " ", 
  RowBox[{"c1", " ", "=", " ", 
   RowBox[{"SeriesCoefficient", "[", 
    RowBox[{"serP", ",", " ", "1"}], "]"}]}], ";", " ", 
  RowBox[{"c2", " ", "=", " ", 
   RowBox[{"SeriesCoefficient", "[", 
    RowBox[{"serP", ",", " ", "2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<      eps^0 \>\"", ",", " ", 
    RowBox[{"sci", "[", 
     RowBox[{"N", "[", "c0", "]"}], "]"}], ",", " ", "\"\<   eps^1 \>\"", ",",
     " ", 
    RowBox[{"sci", "[", 
     RowBox[{"N", "[", "c1", "]"}], "]"}], ",", " ", "\"\<   eps^2 \>\"", ",",
     "\n", "  ", 
    RowBox[{"sci", "[", 
     RowBox[{"N", "[", "c2", "]"}], "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<      exact - (eps^0 + eps^1) relative to eps^1: \>\"", ",", 
    " ", 
    RowBox[{"sci", "[", 
     RowBox[{"relErr", "[", 
      RowBox[{
       RowBox[{"exactP", " ", "-", " ", "c0"}], ",", " ", "c1"}], "]"}], 
     "]"}], ",", "\n", 
    "  ", "\"\<   (the second-order share at this contrast)\>\""}], "]"}], 
  ";"}]}], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"e04e97f9-13a2-4a39-94d2-41244e6107f1"],

Cell[BoxData[
 TemplateBox[{
  "\"  [4] Born series: the reflected field at the source depth, P, in powers \
of the contrast\""},
  "RowDefault"]], "Print",ExpressionUUID->"a755e389-2cd1-464a-8949-\
9a6e1a491ae1"],

Cell[BoxData[
 TemplateBox[{
  "\"      eps^0 \"", "\"-3.33e-14 + 6.67e-10 I\"", "\"   eps^1 \"", 
   "\"-7.92e-13 - 2.55e-13 I\"", "\"   eps^2 \"", "\"3.11e-14 + 1.03e-14 I\""},
  "RowDefault"]], "Print",ExpressionUUID->"c3beef97-8c86-4d69-b96f-\
967f3614f397"],

Cell[BoxData[
 TemplateBox[{

Cell["[4] Born series in the contrast, and the thin layer.", "Section",ExpressionUUID->"8148be3e-bcf3-408a-a36f-5360d635c667"],

Cell["\<\
Scale the layer's modulus and density contrasts by eps; expand the reflected \
field at the source side.  These closed forms are what the discrete chain \
must reproduce in the limit.\
\>", "Text",ExpressionUUID->"0ff1b9b8-3c59-4f24-9650-b0b0bfe59d33"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "eps", ",", " ", "dm", ",", " ", "dr", ",", " ", "kk", ",", " ", "mm", ",",
     " ", "rr0", ",", " ", "zz", ",", " ", "dd"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bornR", "[", 
    RowBox[{
    "m0_", ",", " ", "r0v_", ",", " ", "dmv_", ",", " ", "drv_", ",", " ", 
     "dd_", ",", " ", "zs_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "m1v", ",", " ", "r1v", ",", " ", "k0v", ",", " ", "k1v", ",", " ", "u",
        ",", " ", "e"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"m1v", " ", "=", " ", 
       RowBox[{"m0", " ", "+", " ", 
        RowBox[{"eps", " ", "dmv"}]}]}], ";", " ", 
      RowBox[{"r1v", " ", "=", " ", 
       RowBox[{"r0v", " ", "+", " ", 
        RowBox[{"eps", " ", "drv"}]}]}], ";", "\n", "  ", 
      RowBox[{"k0v", " ", "=", " ", 
       RowBox[{"om", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"r0v", "/", "m0"}], "]"}]}]}], ";", " ", 
      RowBox[{"k1v", " ", "=", " ", 
       RowBox[{"om", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"r1v", "/", "m1v"}], "]"}]}]}], ";", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "e"}], "}"}], " ", "=", " ", 
       RowBox[{"layerField", "[", 
        RowBox[{
        "m0", ",", " ", "k0v", ",", " ", "m1v", ",", " ", "k1v", ",", " ", 
         "zs", ",", " ", "dd"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"u", "[", "zs", "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  [4] Born series: the reflected field at the source \
depth, P, in powers of the contrast\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dLam", " ", "=", " ", 
   RowBox[{
    RowBox[{"ref", "[", "\"\<contrast_SI\>\"", "]"}], "[", "\"\<dlambda\>\"", 
    "]"}]}], ";", " ", 
  RowBox[{"dMu", " ", "=", " ", 
   RowBox[{
    RowBox[{"ref", "[", "\"\<contrast_SI\>\"", "]"}], "[", "\"\<dmu\>\"", 
    "]"}]}], ";", " ", 
  RowBox[{"dRho", " ", "=", " ", 
   RowBox[{
    RowBox[{"ref", "[", "\"\<contrast_SI\>\"", "]"}], "[", "\"\<drho\>\"", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bornP", " ", "=", " ", 
   RowBox[{"bornR", "[", 
    RowBox[{"mp0", ",", " ", "r0", ",", " ", 
     RowBox[{"dLam", " ", "+", " ", 
      RowBox[{"2", " ", "dMu"}]}], ",", " ", "dRho", ",", " ", "dLayer", ",", 
     " ", "zSrc"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"serP", " ", "=", " ", 
   RowBox[{"Series", "[", 
    RowBox[{"bornP", ",", " ", 
     RowBox[{"{", 
      RowBox[{"eps", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"exactP", " ", "=", " ", 
   RowBox[{"bornP", " ", "/.", " ", 
    RowBox[{"eps", " ", "->", " ", "1"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"c0", " ", "=", " ", 
   RowBox[{"SeriesCoefficient", "[", 
    RowBox[{"serP", ",", " ", "0"}], "]"}]}], ";", " ", 
  RowBox[{"c1", " ", "=", " ", 
   RowBox[{"SeriesCoefficient", "[", 
    RowBox[{"serP", ",", " ", "1"}], "]"}]}], ";", " ", 
  RowBox[{"c2", " ", "=", " ", 
   RowBox[{"SeriesCoefficient", "[", 
    RowBox[{"serP", ",", " ", "2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<      eps^0 \>\"", ",", " ", 
    RowBox[{"sci", "[", 
     RowBox[{"N", "[", "c0", "]"}], "]"}], ",", " ", "\"\<   eps^1 \>\"", ",",
     " ", 
    RowBox[{"sci", "[", 
     RowBox[{"N", "[", "c1", "]"}], "]"}], ",", " ", "\"\<   eps^2 \>\"", ",",
     "\n", "  ", 
    RowBox[{"sci", "[", 
     RowBox[{"N", "[", "c2", "]"}], "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<      exact - (eps^0 + eps^1) relative to eps^1: \>\"", ",", 
    " ", 
    RowBox[{"sci", "[", 
     RowBox[{"relErr", "[", 
      RowBox[{
       RowBox[{"exactP", " ", "-", " ", "c0"}], ",", " ", "c1"}], "]"}], 
     "]"}], ",", "\n", 
    "  ", "\"\<   (the second-order share at this contrast)\>\""}], "]"}], 
  ";"}]}], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"ba8b0c56-8da4-4e77-84c7-abf737ed4b18"],

Cell[BoxData[
 TemplateBox[{
  "\"  [4] Born series: the reflected field at the source depth, P, in powers \
of the contrast\""},
  "RowDefault"]], "Print",ExpressionUUID->"ee6f7617-a25e-4fc0-9375-\
27d9d538e864"],

Cell[BoxData[
 TemplateBox[{
  "\"      eps^0 \"", "\"-3.33e-14 + 6.67e-10 I\"", "\"   eps^1 \"", 
   "\"-7.92e-13 - 2.55e-13 I\"", "\"   eps^2 \"", "\"3.11e-14 + 1.03e-14 I\""},
  "RowDefault"]], "Print",ExpressionUUID->"596f5188-8e33-4e9b-9a62-\
91bf68699713"],

Cell[BoxData[
 TemplateBox[{
  "\"      exact - (eps^0 + eps^1) relative to eps^1: \"", "\"0.037\"", 
   "\"   (the second-order share at this contrast)\""},
  "RowDefault"]], "Print",ExpressionUUID->"e0b4271b-77d2-4a28-be0f-\
b61b7e47f9d8"],

Cell["thin layer: the first-order reflection vs D, symbolic", "Text",ExpressionUUID->"094a0a82-da8e-4a25-8655-c8f666779cc3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"dz0", ",", " ", "kx"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"firstOrderThin", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{"c1", " ", "/.", " ", 
       RowBox[{"dLayer", " ", "->", " ", "dz0"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"dz0", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}], "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<      first-order term, D -> 0 (leading orders shown \
numerically for D = 2 m): \>\"", ",", "\n", "  ", 
    RowBox[{"sci", "[", 
     RowBox[{
      RowBox[{"Normal", "[", "firstOrderThin", "]"}], " ", "/.", " ", 
      RowBox[{"dz0", " ", "->", " ", "dLayer"}]}], "]"}], ",", 
    " ", "\"\< vs exact first order \>\"", ",", " ", 
    RowBox[{"sci", "[", 
     RowBox[{"N", "[", "c1", "]"}], "]"}]}], "]"}], ";"}]}], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"9d3223c7-4181-4ce3-acb8-3d01deb178ab"],

Cell[BoxData[
 TemplateBox[{
  "\"      first-order term, D -> 0 (leading orders shown numerically for D = \
2 m): \"", "\"-7.92e-13 - 2.55e-13 I\"", "\" vs exact first order \"", 
   "\"-7.92e-13 - 2.55e-13 I\""},
  "RowDefault"]], "Print",ExpressionUUID->"e060a3c2-4bea-4a8f-841d-\
1b5b6de6bae4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"allPass", " ", "=", " ", 
   RowBox[{
    RowBox[{"worst1", " ", "<", " ", 
     RowBox[{"10", "^", 
      RowBox[{"-", "6"}]}]}], " ", "&&", " ", 
    RowBox[{"worst3", " ", "<", " ", 
     RowBox[{"10", "^", 
      RowBox[{"-", "6"}]}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<==== ContinuumLimit_Reference: \>\"", ",", " ", 
    RowBox[{"If", "[", 
     RowBox[{
     "allPass", ",", " ", "\"\<ALL CHECKS PASS\>\"", ",", 
      " ", "\"\<CHECKS FAILED\>\""}], "]"}], ",", " ", "\"\< ====\>\""}], 
   "]"}], ";"}]}], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"101d5eb4-94b4-4af4-bb8b-4aea33ef8920"],

Cell[BoxData[
 TemplateBox[{
  "\"==== ContinuumLimit_Reference: \"", "\"ALL CHECKS PASS\"", "\" ====\""},
  "RowDefault"]], "Print",ExpressionUUID->"cdcbba31-72ab-4b67-91b3-\

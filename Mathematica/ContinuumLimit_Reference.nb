              RowBox[{"#1", ",", " ", "\"\<e\>\"", ",", " ", "#3"}], "}"}], 
             "]"}]}], "]"}], " ", "&"}], ")"}]}]}], "]"}], ",", " ", 
     "OutputForm"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"588f1086-0785-44ae-a804-76dc590795fd"],


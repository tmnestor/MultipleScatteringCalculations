Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"mP", "[", 
    RowBox[{"a_", ",", " ", "r_"}], "]"}], " ", ":=", " ", 
   RowBox[{"r", " ", 
    RowBox[{"a", "^", "2"}]}]}], ";", " ", 
  RowBox[{
   RowBox[{"mS", "[", 
    RowBox[{"b_", ",", " ", "r_"}], "]"}], " ", ":=", " ", 
   RowBox[{"r", " ", 
    RowBox[{"b", "^", "2"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kOf", "[", "v_", "]"}], " ", ":=", " ", 
   RowBox[{"om", "/", "v"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"g1", "[", 
    RowBox[{"m_", ",", " ", "k_", ",", " ", "dz_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"I", "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", "m", " ", "k"}], ")"}]}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", "k", " ", 
      RowBox[{"Abs", "[", "dz", "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dg1", "[", 
     RowBox[{"m_", ",", " ", "k_", ",", " ", "dz_"}], "]"}], " ", ":=", " ", 
    RowBox[{"I", " ", "k", " ", 
     RowBox[{"Sign", "[", "dz", "]"}], " ", 
     RowBox[{"g1", "[", 
      RowBox[{"m", ",", " ", "k", ",", " ", "dz"}], "]"}]}]}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"d", "/", "dz"}], " ", "of", " ", "g1"}], ",", " ", 

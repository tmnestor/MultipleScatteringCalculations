Cell["[4] Born series in the contrast, and the thin layer.", "Section",ExpressionUUID->"6899b8ec-1223-4ada-8154-3f4a70fba76e"],

Cell["\<\
Scale the layer's modulus and density contrasts by eps; expand the reflected \
field at the source side.  These closed forms are what the discrete chain \
must reproduce in the limit.\
\>", "Text",ExpressionUUID->"34dba120-987f-49a3-a67c-f9a123ac5169"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "eps", ",", " ", "dm", ",", " ", "dr", ",", " ", "kk", ",", " ", "mm", ",",
     " ", "rr0", ",", " ", "zz", ",", " ", "dd"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bornR", "[", 
    RowBox[{
    "m0_", ",", " ", "r0v_", ",", " ", "dmv_", ",", " ", "drv_", ",", " ", 
     "dd_", ",", " ", "zs_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "m1v", ",", " ", "r1v", ",", " ", "k0v", ",", " ", "k1v", ",", " ", "u",
        ",", " ", "e"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"m1v", " ", "=", " ", 
       RowBox[{"m0", " ", "+", " ", 
        RowBox[{"eps", " ", "dmv"}]}]}], ";", " ", 
      RowBox[{"r1v", " ", "=", " ", 
       RowBox[{"r0v", " ", "+", " ", 
        RowBox[{"eps", " ", "drv"}]}]}], ";", "\n", "  ", 
      RowBox[{"k0v", " ", "=", " ", 
       RowBox[{"om", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"r0v", "/", "m0"}], "]"}]}]}], ";", " ", 
      RowBox[{"k1v", " ", "=", " ", 
       RowBox[{"om", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"r1v", "/", "m1v"}], "]"}]}]}], ";", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "e"}], "}"}], " ", "=", " ", 
       RowBox[{"layerField", "[", 
        RowBox[{
        "m0", ",", " ", "k0v", ",", " ", "m1v", ",", " ", "k1v", ",", " ", 
         "zs", ",", " ", "dd"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"u", "[", "zs", "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  [4] Born series: the reflected field at the source \
depth, P, in powers of the contrast\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dLam", " ", "=", " ", 
   RowBox[{
    RowBox[{"ref", "[", "\"\<contrast_SI\>\"", "]"}], "[", "\"\<dlambda\>\"", 
    "]"}]}], ";", " ", 
  RowBox[{"dMu", " ", "=", " ", 
   RowBox[{
    RowBox[{"ref", "[", "\"\<contrast_SI\>\"", "]"}], "[", "\"\<dmu\>\"", 
    "]"}]}], ";", " ", 
  RowBox[{"dRho", " ", "=", " ", 
   RowBox[{
    RowBox[{"ref", "[", "\"\<contrast_SI\>\"", "]"}], "[", "\"\<drho\>\"", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bornP", " ", "=", " ", 
   RowBox[{"bornR", "[", 
    RowBox[{"mp0", ",", " ", "r0", ",", " ", 
     RowBox[{"dLam", " ", "+", " ", 
      RowBox[{"2", " ", "dMu"}]}], ",", " ", "dRho", ",", " ", "dLayer", ",", 
     " ", "zSrc"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"serP", " ", "=", " ", 
   RowBox[{"Series", "[", 
    RowBox[{"bornP", ",", " ", 
     RowBox[{"{", 
      RowBox[{"eps", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"exactP", " ", "=", " ", 
   RowBox[{"bornP", " ", "/.", " ", 
    RowBox[{"eps", " ", "->", " ", "1"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"c0", " ", "=", " ", 
   RowBox[{"SeriesCoefficient", "[", 
    RowBox[{"serP", ",", " ", "0"}], "]"}]}], ";", " ", 
  RowBox[{"c1", " ", "=", " ", 
   RowBox[{"SeriesCoefficient", "[", 
    RowBox[{"serP", ",", " ", "1"}], "]"}]}], ";", " ", 
  RowBox[{"c2", " ", "=", " ", 
   RowBox[{"SeriesCoefficient", "[", 
    RowBox[{"serP", ",", " ", "2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<      eps^0 \>\"", ",", " ", 
    RowBox[{"sci", "[", 
     RowBox[{"N", "[", "c0", "]"}], "]"}], ",", " ", "\"\<   eps^1 \>\"", ",",
     " ", 
    RowBox[{"sci", "[", 
     RowBox[{"N", "[", "c1", "]"}], "]"}], ",", " ", "\"\<   eps^2 \>\"", ",",
     "\n", "  ", 
    RowBox[{"sci", "[", 
     RowBox[{"N", "[", "c2", "]"}], "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<      exact - (eps^0 + eps^1) relative to eps^1: \>\"", ",", 
    " ", 
    RowBox[{"sci", "[", 
     RowBox[{"relErr", "[", 
      RowBox[{
       RowBox[{"exactP", " ", "-", " ", "c0"}], ",", " ", "c1"}], "]"}], 
     "]"}], ",", "\n", 
    "  ", "\"\<   (the second-order share at this contrast)\>\""}], "]"}], 
  ";"}]}], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"84fb2b2b-46ec-4576-909a-a3cb39c5adfa"],

Cell[BoxData[
 TemplateBox[{
  "\"  [4] Born series: the reflected field at the source depth, P, in powers \
of the contrast\""},
  "RowDefault"]], "Print",ExpressionUUID->"02f005ff-1780-46ad-816e-\
386bbd6fbacc"],

Cell[BoxData[
 TemplateBox[{
  "\"      eps^0 \"", "\"-3.33e-14 + 6.67e-10 I\"", "\"   eps^1 \"", 
   "\"-7.92e-13 - 2.55e-13 I\"", "\"   eps^2 \"", "\"3.11e-14 + 1.03e-14 I\""},
  "RowDefault"]], "Print",ExpressionUUID->"6d03255d-fc06-49e0-af23-\
4073343b189a"],

Cell[BoxData[
 TemplateBox[{
  "\"      exact - (eps^0 + eps^1) relative to eps^1: \"", "\"0.037\"", 

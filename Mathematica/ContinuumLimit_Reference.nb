  "RowDefault"]], "Print",ExpressionUUID->"1424e20b-6128-497d-bad2-\
7afa001458c0"],

Cell["thin layer: the first-order reflection vs D, symbolic", "Text",ExpressionUUID->"84ec01e1-79bb-4fbe-b513-98394db664f7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"dz0", ",", " ", "kx"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"firstOrderThin", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{"c1", " ", "/.", " ", 
       RowBox[{"dLayer", " ", "->", " ", "dz0"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"dz0", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}], "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<      first-order term, D -> 0 (leading orders shown \
numerically for D = 2 m): \>\"", ",", "\n", "  ", 
    RowBox[{"sci", "[", 
     RowBox[{
      RowBox[{"Normal", "[", "firstOrderThin", "]"}], " ", "/.", " ", 
      RowBox[{"dz0", " ", "->", " ", "dLayer"}]}], "]"}], ",", 
    " ", "\"\< vs exact first order \>\"", ",", " ", 
    RowBox[{"sci", "[", 
     RowBox[{"N", "[", "c1", "]"}], "]"}]}], "]"}], ";"}]}], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"9dca0518-b9f9-4079-9bfc-e44e8846d41e"],

Cell[BoxData[
 TemplateBox[{
  "\"      first-order term, D -> 0 (leading orders shown numerically for D = \
2 m): \"", "\"-7.92e-13 - 2.55e-13 I\"", "\" vs exact first order \"", 
   "\"-7.92e-13 - 2.55e-13 I\""},
  "RowDefault"]], "Print",ExpressionUUID->"ce2f6399-a1fe-439b-9289-\
60fa750ac186"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"allPass", " ", "=", " ", 
   RowBox[{
    RowBox[{"worst1", " ", "<", " ", 
     RowBox[{"10", "^", 
      RowBox[{"-", "6"}]}]}], " ", "&&", " ", 
    RowBox[{"worst3", " ", "<", " ", 
     RowBox[{"10", "^", 
      RowBox[{"-", "6"}]}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<==== ContinuumLimit_Reference: \>\"", ",", " ", 
    RowBox[{"If", "[", 
     RowBox[{
     "allPass", ",", " ", "\"\<ALL CHECKS PASS\>\"", ",", 
      " ", "\"\<CHECKS FAILED\>\""}], "]"}], ",", " ", "\"\< ====\>\""}], 
   "]"}], ";"}]}], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"a06aca95-ae56-44d9-a420-e3c04bdf4e7e"],


Cell["\<\
[2] whole space, dz = 0: the strain-from-force entry is a one-sided limit.\
\>", "Section",ExpressionUUID->"460b3187-f946-4a5d-86cd-04486af627fb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"e0", " ", "=", " ", 
   RowBox[{"SelectFirst", "[", 
    RowBox[{
     RowBox[{"ref", "[", "\"\<whole_space\>\"", "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", "\"\<dz\>\"", "]"}], " ", "==", " ", "0"}], " ", 
      "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"g0m", " ", "=", " ", 
   RowBox[{"mat", "[", 
    RowBox[{"e0", "[", "\"\<G\>\"", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"above", " ", "=", " ", 
   RowBox[{"dg1", "[", 
    RowBox[{"mp0", ",", " ", "kp0", ",", " ", 
     RowBox[{"-", 
      RowBox[{"10", "^", 
       RowBox[{"-", "9"}]}]}]}], "]"}]}], ";", " ", 
  RowBox[{"below", " ", "=", " ", 
   RowBox[{"dg1", "[", 
    RowBox[{"mp0", ",", " ", "kp0", ",", " ", 
     RowBox[{"10", "^", 
      RowBox[{"-", "9"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  [2] whole space dz = 0: package e_zz from f_z = \>\"", ",", 
    " ", 
    RowBox[{"sci", "[", 
     RowBox[{"g0m", "[", 
      RowBox[{"[", 
       RowBox[{"4", ",", " ", "1"}], "]"}], "]"}], "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 

         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"#3", " ", "==", " ", "\"\<\>\""}], ",", " ", "#1", ",", 
            " ", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"#1", ",", " ", "\"\<e\>\"", ",", " ", "#3"}], "}"}], 
             "]"}]}], "]"}], " ", "&"}], ")"}]}]}], "]"}], ",", " ", 
     "OutputForm"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"664d7f79-8307-49f0-856e-7748eb906987"],


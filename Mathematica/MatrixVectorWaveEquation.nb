    RowBox[{"opMatEqualQ", "[", 
     RowBox[{
      RowBox[{"opMatT", "[", "a21op", "]"}], ",", " ", "a21op", ",", " ", 
      "3"}], "]"}]}], "]"}], ";"}]}], "Input",ExpressionUUID->"bed93574-3ae6-\
4a81-bbd5-a4ff5022c41b"],

Cell["\<\
Part 6.  The source vector, completing d3 q = A q + d.

   d1 = f + (1/(i w)) d_a U_ab h_b                                      \
(D.18)
   d2 = C33^{-1} C_3l h_l                                               (D.19)

   with q1 = -tau_3, q2 = v                                             (D.10)

   h_kl is the deformation-rate density; h_l is its l-th column, (h_l)_k = \
h_kl.\
\>", "Text",ExpressionUUID->"e717c9b9-1076-4773-8139-f280e3d9e65c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"hvec", "[", "l_", "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"hh", "[", 
       RowBox[{"kk", ",", " ", "l"}], "]"}], "[", 
      RowBox[{"x1", ",", " ", "x2", ",", " ", "x3"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"kk", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fvec", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ff", "[", "ii", "]"}], "[", 
       RowBox[{"x1", ",", " ", "x2", ",", " ", "x3"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"ii", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"d1src", " ", "=", " ", 
   RowBox[{"Simplify", "[", "\n", "   ", 
    RowBox[{"fvec", " ", "+", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"I", " ", "w"}], ")"}]}], ")"}], " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"umat", "[", 
            RowBox[{"al", ",", " ", "be"}], "]"}], ".", 
           RowBox[{"hvec", "[", "be", "]"}]}], ",", " ", 
          RowBox[{"xv", "[", 
           RowBox[{"[", "al", "]"}], "]"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"al", ",", " ", "2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"be", ",", " ", "2"}], "}"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"d2src", " ", "=", " ", 
    RowBox[{"Simplify", "[", 
     RowBox[{"c33inv", ".", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"cmat", "[", 
          RowBox[{"3", ",", " ", "l"}], "]"}], ".", 
         RowBox[{"hvec", "[", "l", "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"l", ",", " ", "3"}], "}"}]}], "]"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<--- Part 6: source vector (D.18)-(D.19) \
--------------------------\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"disp", "[", 
   RowBox[{"\"\<d1 =\>\"", ",", " ", "d1src"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"disp", "[", 
   RowBox[{"\"\<d2 =\>\"", ",", " ", "d2src"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"report", "[", 
   RowBox[{"\"\<d vanishes with the sources (no spurious inhomogeneous \
term)\>\"", ",", "\n", "  ", 
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{"d1src", ",", " ", "d2src"}], "]"}], " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"ff", "[", "_", "]"}], " ", "->", " ", 
          RowBox[{"(", 
           RowBox[{"0", " ", "&"}], ")"}]}], ",", " ", 

Cell["\<\
Part 2.  Eliminating the in-plane tractions: the reduced stiffness U.

   U_al = C_al - C_a3 C33^{-1} C_3l                                     (D.17)

   U is what survives after tau_1 and tau_2 have been removed using the
   x3-derivative relation (D.14).  Its two structural properties, U_a3 = O \
and
   U_ab^t = U_ba, are what make the symmetry relations (16)-(18) hold, so \
they
   are checked, not assumed.  The isotropic U_ab is where nu1 and nu2 are
   BORN --- they are not independent definitions.\
\>", "Text",ExpressionUUID->"6961bef7-d032-479c-a15b-0c1aacc8458a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"umat", "[", 
     RowBox[{"al_", ",", " ", "l_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"cmat", "[", 
       RowBox[{"al", ",", " ", "l"}], "]"}], " ", "-", " ", 
      RowBox[{
       RowBox[{"cmat", "[", 
        RowBox[{"al", ",", " ", "3"}], "]"}], ".", "c33inv", ".", 
       RowBox[{"cmat", "[", 
        RowBox[{"3", ",", " ", "l"}], "]"}]}]}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<--- Part 2: reduced stiffness U_al = C_al - C_a3 C33^-1 \
C_3l ------\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"disp", "[", 
   RowBox[{"\"\<U11 =\>\"", ",", " ", 
    RowBox[{"umat", "[", 
     RowBox[{"1", ",", " ", "1"}], "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"disp", "[", 
   RowBox[{"\"\<U12 =\>\"", ",", " ", 
    RowBox[{"umat", "[", 
     RowBox[{"1", ",", " ", "2"}], "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"disp", "[", 
   RowBox[{"\"\<U21 =\>\"", ",", " ", 
    RowBox[{"umat", "[", 
     RowBox[{"2", ",", " ", "1"}], "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"disp", "[", 
    RowBox[{"\"\<U22 =\>\"", ",", " ", 
     RowBox[{"umat", "[", 
      RowBox[{"2", ",", " ", "2"}], "]"}]}], "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"report", "[", 
    RowBox[{"\"\<U_a3 = O for a = 1,2  (D.17)\>\"", ",", "\n", "  ", 
     RowBox[{"And", " ", "@@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Simplify", "[", 
          RowBox[{"umat", "[", 
           RowBox[{"al", ",", " ", "3"}], "]"}], "]"}], " ", "===", " ", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", " ", 
           RowBox[{"{", 
            RowBox[{"3", ",", " ", "3"}], "}"}]}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"al", ",", " ", "2"}], "}"}]}], "]"}]}]}], "]"}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"report", "[", 
    RowBox[{"\"\<U_ab^t = U_ba  (D.17)\>\"", ",", "\n", "  ", 
     RowBox[{"And", " ", "@@", " ", 
      RowBox[{"Flatten", "@", 
       RowBox[{"Table", "[", "\n", "     ", 
        RowBox[{
         RowBox[{
          RowBox[{"Simplify", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{"umat", "[", 
              RowBox[{"al", ",", " ", "be"}], "]"}], "]"}], " ", "-", " ", 
            RowBox[{"umat", "[", 
             RowBox[{"be", ",", " ", "al"}], "]"}]}], "]"}], " ", "===", " ", 
          
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", " ", 
            RowBox[{"{", 
             RowBox[{"3", ",", " ", "3"}], "}"}]}], "]"}]}], ",", "\n", 
         "     ", 
         RowBox[{"{", 
          RowBox[{"al", ",", " ", "2"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"be", ",", " ", "2"}], "}"}]}], "]"}]}]}]}], "]"}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"report", "[", 
    RowBox[{"\"\<U_ab has a null third row and column (tau_33 fully \
eliminated)\>\"", ",", "\n", "  ", 
     RowBox[{"And", " ", "@@", " ", 
      RowBox[{"Flatten", "@", 
       RowBox[{"Table", "[", "\n", "     ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Simplify", "[", 
             RowBox[{
              RowBox[{"umat", "[", 
               RowBox[{"al", ",", " ", "be"}], "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", " ", "All"}], "]"}], "]"}], "]"}], " ", "===",
             " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], ",", "\n", 
           "      ", 
           RowBox[{
            RowBox[{"Simplify", "[", 
             RowBox[{
              RowBox[{"umat", "[", 
               RowBox[{"al", ",", " ", "be"}], "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", "3"}], "]"}], "]"}], "]"}], " ", "===",
             " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}]}], "}"}], ",",
          "\n", "     ", 
         RowBox[{"{", 
          RowBox[{"al", ",", " ", "2"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"be", ",", " ", "2"}], "}"}]}], "]"}]}]}]}], "]"}], ";"}], 
  "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"nu1", ",", " ", 
    RowBox[{"nu2", " ", "read", " ", "off", " ", "U"}], ",", " ", 
    RowBox[{
     RowBox[{"then", " ", "compared", " ", "with", " ", 
      RowBox[{"(", 
       RowBox[{"J", ".9"}], ")"}]}], "-", 
     RowBox[{"(", 
      RowBox[{"J", ".10"}], ")"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"nu1", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"umat", "[", 
      RowBox[{"1", ",", " ", "1"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nu2", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"umat", "[", 
      RowBox[{"1", ",", " ", "2"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<nu1 read off U11[[1,1]] = \>\"", ",", " ", 
    RowBox[{"tidy", "[", "nu1", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<nu2 read off U12[[1,2]] = \>\"", ",", " ", 
    RowBox[{"tidy", "[", "nu2", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"report", "[", 
   RowBox[{"\"\<nu1 = 4 mu (lam+mu)/(lam+2mu)   (J.9)\>\"", ",", "\n", "  ", 
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{"nu1", " ", "-", " ", 
       RowBox[{"4", " ", "mu", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"lam", " ", "+", " ", "mu"}], ")"}], "/", "kc"}]}]}], "]"}],
      " ", "===", " ", "0"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"report", "[", 
   RowBox[{"\"\<nu2 = 2 mu lam/(lam+2mu)        (J.10)\>\"", ",", "\n", "  ", 
    
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{"nu2", " ", "-", " ", 
       RowBox[{"2", " ", "mu", " ", 
        RowBox[{"lam", "/", "kc"}]}]}], "]"}], " ", "===", " ", "0"}]}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"report", "[", 
   RowBox[{"\"\<nu1 - nu2 = 2 mu  (thesis footnote: zeta - chi = 2 mu)\>\"", ",",
     "\n", "  ", 
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{"nu1", " ", "-", " ", "nu2", " ", "-", " ", 
       RowBox[{"2", " ", "mu"}]}], "]"}], " ", "===", " ", "0"}]}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"3d7d4a29-ffc1-4b4c-8e4e-e5027668084e"],

Cell["\<\
Part 3.  The operator matrices, built from the general Appendix-D formulae.

   A11 = -d_a C_a3 C33^{-1}                                             \
(D.20)
   A12 =  i w rho - (1/(i w)) d_a U_ab d_b                              \
(D.21)
   A21 =  i w C33^{-1}                                                  \
(D.22)
   A22 = -C33^{-1} C_3b d_b                                             (D.23)

   Sum over repeated Greek indices runs over 1,2 only.

   Read the operator ordering carefully.  In (D.20) d_a stands to the LEFT of
   the stiffness, so it differentiates the product (C_a3 C33^{-1}) f.  In
   (D.23) d_b stands to the RIGHT, so it differentiates f alone.  In (D.21)
   the middle factor U_ab sits BETWEEN the two derivatives.  For a laterally
   invariant medium these distinctions collapse; for a laterally varying one
   they are the physics.\
\>", "Text",ExpressionUUID->"23195f4f-9801-44cf-8302-a4eb80fb30a0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"a11op", " ", "=", " ", 
    RowBox[{"Table", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"plusOp", " ", "@@", " ", 
       RowBox[{"Table", "[", "\n", "     ", 
        RowBox[{
         RowBox[{"scalOp", "[", 
          RowBox[{
           RowBox[{"-", "1"}], ",", " ", 
           RowBox[{"compOp", "[", 
            RowBox[{
             RowBox[{"dOp", "[", "al", "]"}], ",", " ", 
             RowBox[{"multOp", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"cmat", "[", 
                  RowBox[{"al", ",", " ", "3"}], "]"}], ".", "c33inv"}], 
                ")"}], "[", 
               RowBox[{"[", 
                RowBox[{"ii", ",", " ", "kk"}], "]"}], "]"}], "]"}]}], 
            "]"}]}], "]"}], ",", "\n", "     ", 
         RowBox[{"{", 
          RowBox[{"al", ",", " ", "2"}], "}"}]}], "]"}]}], ",", "\n", "   ", 
      RowBox[{"{", 
       RowBox[{"ii", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"kk", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"a12op", " ", "=", " ", 
    RowBox[{"Table", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"plusOp", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"multOp", "[", 
         RowBox[{"I", " ", "w", " ", "rho", " ", 
          RowBox[{"dl", "[", 
           RowBox[{"ii", ",", " ", "kk"}], "]"}]}], "]"}], ",", "\n", "    ", 
        
        RowBox[{"Sequence", " ", "@@", " ", 
         RowBox[{"Flatten", "[", "\n", "      ", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"scalOp", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "1"}], "/", 
                RowBox[{"(", 
                 RowBox[{"I", " ", "w"}], ")"}]}], ",", "\n", "        ", 
               RowBox[{"compOp", "[", 
                RowBox[{
                 RowBox[{"dOp", "[", "al", "]"}], ",", " ", 
                 RowBox[{"multOp", "[", 
                  RowBox[{
                   RowBox[{"umat", "[", 
                    RowBox[{"al", ",", " ", "be"}], "]"}], "[", 
                   RowBox[{"[", 
                    RowBox[{"ii", ",", " ", "kk"}], "]"}], "]"}], "]"}], ",", 
                 " ", 

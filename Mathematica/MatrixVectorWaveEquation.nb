    RowBox[{
     RowBox[{
     "At", " ", "normal", " ", "incidence", " ", "the", " ", "six", " ", 
      "eigenvalues", " ", "are"}], " ", "+", 
     RowBox[{
      RowBox[{"-", "i"}], " ", 
      RowBox[{"w", "/", "alpha"}], " ", "once", " ", "each", " ", "and"}], 
     "\n", "   ", "+", 
     RowBox[{
      RowBox[{"-", "i"}], " ", 
      RowBox[{"w", "/", "beta"}], " ", "twice", " ", "each"}]}], ",", " ", 
    RowBox[{
    "so", " ", "their", " ", "squares", " ", "carry", " ", "multiplicities", " ",
      "2", " ", "and", " ", "4."}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"evNormal", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Eigenvalues", "[", 
     RowBox[{"a6", " ", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"k1", " ", "->", " ", "0"}], ",", " ", 
        RowBox[{"k2", " ", "->", " ", "0"}]}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<eigenvalues at normal incidence: \>\"", ",", " ", 
    "evNormal"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"report", "[", 
    RowBox[{"\"\<normal incidence: +-i w/alpha (once), +-i w/beta (twice)\>\"",
      ",", "\n", "  ", 
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{"evNormal", "^", "2"}], "]"}], "]"}], " ", "===", "\n", "   ", 
      RowBox[{"Sort", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "rhoC"}], " ", 
          RowBox[{
           RowBox[{"w", "^", "2"}], "/", "kcC"}]}], ",", " ", 
         RowBox[{
          RowBox[{"-", "rhoC"}], " ", 
          RowBox[{
           RowBox[{"w", "^", "2"}], "/", "kcC"}]}], ",", "\n", "         ", 
         RowBox[{
          RowBox[{"-", "rhoC"}], " ", 
          RowBox[{
           RowBox[{"w", "^", "2"}], "/", "muC"}]}], ",", " ", 
         RowBox[{
          RowBox[{"-", "rhoC"}], " ", 
          RowBox[{
           RowBox[{"w", "^", "2"}], "/", "muC"}]}], ",", " ", 
         RowBox[{
          RowBox[{"-", "rhoC"}], " ", 
          RowBox[{
           RowBox[{"w", "^", "2"}], "/", "muC"}]}], ",", " ", 
         RowBox[{
          RowBox[{"-", "rhoC"}], " ", 
          RowBox[{
           RowBox[{"w", "^", "2"}], "/", "muC"}]}]}], "}"}], "]"}]}]}], "]"}],
    ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "bar", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  \>\"", ",", " ", "nPass", ",", " ", "\"\< passed, \>\"", ",",
     " ", "nFail", ",", " ", "\"\< failed\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "bar", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"nFail", " ", ">", " ", "0"}], ",", " ", 
    RowBox[{"Exit", "[", "1", "]"}]}], "]"}], ";"}]}], "Input",ExpressionUUID->\

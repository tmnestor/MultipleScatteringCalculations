   RowBox[{"\"\<A11^t = -A22   (16)\>\"", ",", " ", 
    RowBox[{"opMatEqualQ", "[", 
     RowBox[{
      RowBox[{"opMatT", "[", "a11op", "]"}], ",", " ", 
      RowBox[{"opMatScal", "[", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", "a22op"}], "]"}], ",", " ", "3"}], 
     "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{

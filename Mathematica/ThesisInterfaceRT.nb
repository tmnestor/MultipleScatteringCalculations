       {
        RowBox[{"-", "0.04592924131304489`"}], "0.06549314434882116`", 
        RowBox[{"0.`", "\[VeryThinSpace]", "-", 
         RowBox[{"0.008611971993767713`", " ", "\[ImaginaryI]"}]}]},
       {
        RowBox[{"0.`", "\[VeryThinSpace]", "-", 
         RowBox[{"0.022383143474567598`", " ", "\[ImaginaryI]"}]}], 
        RowBox[{"0.`", "\[VeryThinSpace]", "-", 

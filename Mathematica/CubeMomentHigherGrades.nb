\>", "Text",ExpressionUUID->"0e2a72c7-1bd5-4bda-9f93-1174fe838993"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"reps", "[", 
    RowBox[{"dd_", ",", " ", "ww_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Select", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"ds", ",", " ", "ws"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"ds", ",", " ", 
           RowBox[{"DeleteDuplicates", "[", 
            RowBox[{"Sort", " ", "/@", " ", 
             RowBox[{"Tuples", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
               "dd"}], "]"}]}], "]"}]}], "}"}], ",", "\n", "     ", 
         RowBox[{"{", 
          RowBox[{"ws", ",", " ", 
           RowBox[{"DeleteDuplicates", "[", 
            RowBox[{"Sort", " ", "/@", " ", 
             RowBox[{"Tuples", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
               "ww"}], "]"}]}], "]"}]}], "}"}]}], "]"}], ",", " ", "1"}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Range", "[", "3", "]"}], ",", " ", 
        RowBox[{"Function", "[", 
         RowBox[{"ax", ",", " ", 
          RowBox[{"EvenQ", "[", 
           RowBox[{"Count", "[", 
            RowBox[{
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", " ", "ax"}], 
            "]"}], "]"}]}], "]"}]}], "]"}], " ", "&"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"4e9e27fe-4434-4395-a08b-064e95312881"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"checkGrade", "[", 
    RowBox[{"{", 
     RowBox[{"dd_", ",", " ", "ww_"}], "}"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"t0", " ", "=", " ", 
        RowBox[{"AbsoluteTime", "[", "]"}]}], ",", " ", 
       RowBox[{"okA", " ", "=", " ", "True"}], ",", " ", 
       RowBox[{"okB", " ", "=", " ", "True"}], ",", " ", 
       RowBox[{"okC", " ", "=", " ", "True"}], ",", " ", "rs", ",", " ", 
       RowBox[{"nA", " ", "=", " ", "0"}], ",", " ", 
       RowBox[{"nB", " ", "=", " ", "0"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", "a", ")"}], " ", "and", " ", 
        RowBox[{"(", "b", ")"}]}], ":", " ", 
       RowBox[{
        RowBox[{
        "add", " ", "a", " ", "traced", " ", "pair", " ", "to", " ", "a", " ",
          "rest", " ", "list", " ", "of", " ", "length", " ", "dd"}], " ", "-",
         " ", "2"}]}], " ", "*)"}], "\n", "  ", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"dd", " ", ">=", " ", "2"}], ",", "\n", "   ", 
        RowBox[{"Do", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"rest", " ", "=", " ", 
               RowBox[{"pr", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
              RowBox[{"w", " ", "=", " ", 
               RowBox[{"pr", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", "\n", "     ", 
            RowBox[{"(*", " ", 
             RowBox[{
              RowBox[{"(", "b", ")"}], " ", "kernel", " ", 
              RowBox[{"1", "/", "r"}]}], " ", "*)"}], "\n", "     ", 
            RowBox[{
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"lhs", " ", "=", " ", 
                  RowBox[{"Sum", "[", 
                   RowBox[{
                    RowBox[{"eC", "[", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", " ", 
                    RowBox[{"Join", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"p", ",", " ", "p"}], "}"}], ",", " ", "rest"}], 
                    "]"}], ",", " ", "w"}], "]"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"p", ",", " ", "3"}], "}"}]}], "]"}]}], ",", "\n",
                  "       ", 
                 RowBox[{"rhs", " ", "=", " ", 
                  RowBox[{
                   RowBox[{"-", "4"}], " ", "Pi", " ", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], "^", 
                    RowBox[{"Length", "[", "rest", "]"}]}], " ", 
                   RowBox[{"derivAtZero", "[", 
                    RowBox[{"rest", ",", " ", "w"}], "]"}]}]}]}], "}"}], ",", 
               "\n", "      ", 
               RowBox[{
                RowBox[{"nB", "++"}], ";", " ", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"!", " ", 
                   RowBox[{"exactZero", "[", 
                    RowBox[{"lhs", " ", "-", " ", "rhs"}], "]"}]}], ",", " ", 
                  
                  RowBox[{
                   RowBox[{"okB", " ", "=", " ", "False"}], ";", " ", 
                   RowBox[{"Print", "[", 
                    
                    RowBox[{"\"\<      (b) fails at rest \>\"", ",", " ", 
                    "rest", ",", " ", "\"\< w \>\"", ",", " ", "w"}], 
                    "]"}]}]}], "]"}]}]}], "]"}], ";", "\n", "     ", 
             RowBox[{"(*", " ", 
              RowBox[{
               RowBox[{"(", "a", ")"}], " ", "kernel", " ", "r"}], " ", 
              "*)"}], "\n", "     ", 
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"lhs", " ", "=", " ", 
                  RowBox[{"Sum", "[", 
                   RowBox[{
                    RowBox[{"eC", "[", 
                    RowBox[{"1", ",", " ", 
                    RowBox[{"Join", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"p", ",", " ", "p"}], "}"}], ",", " ", "rest"}], 
                    "]"}], ",", " ", "w"}], "]"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"p", ",", " ", "3"}], "}"}]}], "]"}]}], ",", " ", 
                 
                 RowBox[{"rhs", " ", "=", " ", 
                  RowBox[{"2", " ", 
                   RowBox[{"eC", "[", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", " ", "rest", ",", " ", "w"}], 
                    "]"}]}]}]}], "}"}], ",", "\n", "      ", 
               RowBox[{
                RowBox[{"nA", "++"}], ";", " ", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"!", " ", 
                   RowBox[{"exactZero", "[", 
                    RowBox[{"lhs", " ", "-", " ", "rhs"}], "]"}]}], ",", " ", 
                  
                  RowBox[{
                   RowBox[{"okA", " ", "=", " ", "False"}], ";", " ", 
                   RowBox[{"Print", "[", 
                    
                    RowBox[{"\"\<      (a) fails at rest \>\"", ",", " ", 
                    "rest", ",", " ", "\"\< w \>\"", ",", " ", "w"}], 
                    "]"}]}]}], "]"}]}]}], "]"}]}]}], "]"}], ",", "\n", "    ", 
          RowBox[{"{", 
           RowBox[{"pr", ",", " ", 
            RowBox[{"Flatten", "[", 
             RowBox[{
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"ds", ",", " ", "ws"}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"ds", ",", " ", 
                  RowBox[{"DeleteDuplicates", "[", 
                   RowBox[{"Sort", " ", "/@", " ", 
                    RowBox[{"Tuples", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", 
                    " ", 
                    RowBox[{"dd", " ", "-", " ", "2"}]}], "]"}]}], "]"}]}], 
                 "}"}], ",", "\n", "        ", 
                RowBox[{"{", 
                 RowBox[{"ws", ",", " ", 
                  RowBox[{"DeleteDuplicates", "[", 
                   RowBox[{"Sort", " ", "/@", " ", 
                    RowBox[{"Tuples", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", 
                    " ", "ww"}], "]"}]}], "]"}]}], "}"}]}], "]"}], ",", " ", 
              "1"}], "]"}]}], "}"}]}], "]"}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"(", "c", ")"}], " ", "parity", " ", "on", " ", "one", " ", 
        "odd", " ", "component"}], " ", "*)"}], "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"dd", " ", "+", " ", "ww"}], " ", ">=", " ", "1"}], ",", 
        "\n", "   ", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ds", " ", "=", " ", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"1", ",", " ", "dd"}], "]"}]}], ",", " ", 
            RowBox[{"ws", " ", "=", " ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"ww", " ", ">", " ", "0"}], ",", " ", 
               RowBox[{"Join", "[", 
                RowBox[{
                 RowBox[{"ConstantArray", "[", 
                  RowBox[{"1", ",", " ", 
                   RowBox[{"ww", " ", "-", " ", "1"}]}], "]"}], ",", " ", 
                 RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
               RowBox[{"{", "}"}]}], "]"}]}]}], "}"}], ",", "\n", "    ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"ww", " ", ">", " ", "0"}], ",", " ", 
            RowBox[{"okC", " ", "=", " ", 
             RowBox[{"exactZero", "[", 
              RowBox[{"eC", "[", 
               RowBox[{
                RowBox[{"-", "1"}], ",", " ", "ds", ",", " ", "ws"}], "]"}], 
              "]"}]}]}], "]"}]}], "]"}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"rs", " ", "=", " ", 
       RowBox[{"reps", "[", 
        RowBox[{"dd", ",", " ", "ww"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"dd", " ", "<", " ", "2"}], ",", "\n", "   ", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ok", ",", " ", "n", ",", " ", "worst"}], "}"}], ",", "\n",
           "    ", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"ok", ",", " ", "n", ",", " ", "worst"}], "}"}], " ", "=",
             " ", 
            RowBox[{"nintCheck", "[", 
             RowBox[{"dd", ",", " ", "ww"}], "]"}]}], ";", "\n", "    ", 
           RowBox[{"okA", " ", "=", " ", 
            RowBox[{"okB", " ", "=", " ", "ok"}]}], ";", "\n", "    ", 
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\<    grade (\>\"", ",", " ", "dd", ",", 
             " ", "\"\<,\>\"", ",", " ", "ww", ",", " ", "\"\<): \>\"", ",", 
             " ", 
             RowBox[{"Length", "[", "rs", "]"}], ",", 
             " ", "\"\< non-vanishing index classes;  no trace rule (D < 2); \
\>\"", ",", "\n", 
             "     ", "\"\<against numerical integration over the cube x\>\"",
              ",", " ", "n", ",", 
             " ", "\"\< (largest relative difference \>\"", ",", "\n", 
             "     ", 
             RowBox[{"eNote", "[", "worst", "]"}], ",", " ", "\"\<) \>\"", ",",
              " ", 
             RowBox[{"pass", "[", "okA", "]"}], ",", 
             " ", "\"\<   (c) parity \>\"", ",", " ", 
             RowBox[{"pass", "[", "okC", "]"}], ",", " ", "\"\<   \>\"", ",", 
             "\n", "     ", 
             RowBox[{"Round", "[", 
              RowBox[{
               RowBox[{"AbsoluteTime", "[", "]"}], " ", "-", " ", "t0"}], 
              "]"}], ",", " ", "\"\< s\>\""}], "]"}]}]}], "]"}], ",", "\n", 
        "   ", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<    grade (\>\"", ",", " ", "dd", ",", " ", "\"\<,\>\"",
           ",", " ", "ww", ",", " ", "\"\<): \>\"", ",", " ", 
          RowBox[{"Length", "[", "rs", "]"}], ",", 
          " ", "\"\< non-vanishing index classes;  (a) chain x\>\"", ",", " ",
           "nA", ",", " ", "\"\< \>\"", ",", "\n", "    ", 
          RowBox[{"pass", "[", "okA", "]"}], ",", 
          " ", "\"\<   (b) delta rule x\>\"", ",", " ", "nB", ",", 
          " ", "\"\< \>\"", ",", " ", 
          RowBox[{"pass", "[", "okB", "]"}], ",", 
          " ", "\"\<   (c) parity \>\"", ",", " ", 
          RowBox[{"pass", "[", "okC", "]"}], ",", " ", "\"\<   \>\"", ",", 
          "\n", "    ", 
          RowBox[{"Round", "[", 
           RowBox[{
            RowBox[{"AbsoluteTime", "[", "]"}], " ", "-", " ", "t0"}], "]"}], 
          ",", " ", "\"\< s\>\""}], "]"}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"okA", " ", "&&", " ", "okB", " ", "&&", " ", "okC"}]}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"5758cb10-9832-4c4e-9145-c7437dba9bba"],

Cell["\<\
the tensor's own d_i d_n acts on the kernel r (and r^3, ... dynamically), so \
a moment of grade (D, W) also needs E[1; D + 2 derivatives; W].  Gate: the \
chain rule on those, Sum_p E[1;{p,p}+rest;w] = 2 E[-1;rest;w], with rest of \
length D: every traced component of the D + 2 derivative moment against the \
gated 1/r moment.\
\>", "Text",ExpressionUUID->"27be2b93-1847-42f5-954f-285cc20bf766"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"checkTensorKernel", "[", 
    RowBox[{"{", 
     RowBox[{"dd_", ",", " ", "ww_"}], "}"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"t0", " ", "=", " ", 
        RowBox[{"AbsoluteTime", "[", "]"}]}], ",", " ", 
       RowBox[{"ok", " ", "=", " ", "True"}], ",", " ", 
       RowBox[{"n", " ", "=", " ", "0"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"Do", "[", "\n", "   ", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"lhs", " ", "=", " ", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{"eC", "[", 
                RowBox[{"1", ",", " ", 
                 RowBox[{"Join", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"p", ",", " ", "p"}], "}"}], ",", " ", 
                   RowBox[{"pr", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", " ", 
                 RowBox[{"pr", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"p", ",", " ", "3"}], "}"}]}], "]"}]}], ",", " ", 
            RowBox[{"rhs", " ", "=", " ", 
             RowBox[{"2", " ", 
              RowBox[{"eC", "[", 
               RowBox[{
                RowBox[{"-", "1"}], ",", " ", 
                RowBox[{"pr", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                RowBox[{"pr", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}]}]}], "}"}], ",", 
          "\n", "    ", 
          RowBox[{
           RowBox[{"n", "++"}], ";", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"!", " ", 
              RowBox[{"exactZero", "[", 
               RowBox[{"lhs", " ", "-", " ", "rhs"}], "]"}]}], ",", " ", 
             RowBox[{
              RowBox[{"ok", " ", "=", " ", "False"}], ";", " ", 
              RowBox[{"Print", "[", 
               
               RowBox[{"\"\<      tensor-kernel chain fails at rest \>\"", ",",
                 " ", 
                RowBox[{"pr", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", " ", "\"\< w \>\"", ",",
                 " ", 
                RowBox[{"pr", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}]}], "]"}]}]}], 
         "]"}], ",", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{"pr", ",", " ", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"ds", ",", " ", "ws"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"ds", ",", " ", 

Cell["\<\
a second argument restricts the run to grades with D + W >= minSum and skips \
[2]: for a second kernel working on the heavy grades while the first does the \
light ones (the cache on disk is shared)\
\>", "Text",ExpressionUUID->"a2f98e35-4c39-4a3b-ad02-c277d4ea5419"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"minSum", " ", "=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "$nbScriptCommandLine", "]"}], " ", ">", " ", 
      "2"}], ",", " ", 
     RowBox[{"ToExpression", "[", 
      RowBox[{"$nbScriptCommandLine", "[", 
       RowBox[{"[", "3", "]"}], "]"}], "]"}], ",", " ", "0"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"minSum", " ", "==", " ", "0"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"Print", "[", "]"}], ";", "\n", "  ", 
     RowBox[{
     "Print", "[", "\"\<[2] the new grades of q = 3 (fourth order with both \
contrasts)\>\"", "]"}], ";", "\n", "  ", 
     RowBox[{"ok3", " ", "=", " ", 
      RowBox[{"checkGrade", " ", "/@", " ", 
       RowBox[{"Complement", "[", 
        RowBox[{
         RowBox[{"grades", "[", "3", "]"}], ",", " ", 
         RowBox[{"grades", "[", "2", "]"}]}], "]"}]}]}], ";", "\n", "  ", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<    all gates on the four new grades: \>\"", ",", " ", 
       RowBox[{"pass", "[", 
        RowBox[{"And", " ", "@@", " ", "ok3"}], "]"}]}], "]"}], ";", "\n", 
     "  ", 
     RowBox[{
     "Print", "[", "\"\<    the same grades, the kernel of the tensor's \
second term:\>\"", "]"}], ";", "\n", "  ", 
     RowBox[{"ok3t", " ", "=", " ", 
      RowBox[{"checkTensorKernel", " ", "/@", " ", 
       RowBox[{"Complement", "[", 
        RowBox[{
         RowBox[{"grades", "[", "3", "]"}], ",", " ", 
         RowBox[{"grades", "[", "2", "]"}]}], "]"}]}]}], ";", "\n", "  ", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<    tensor-kernel gates on the four new grades: \>\"", ",",
        " ", 
       RowBox[{"pass", "[", 
        RowBox[{"And", " ", "@@", " ", "ok3t"}], "]"}]}], "]"}]}]}], "]"}], 
  ";"}]}], "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"6d7c300d-9b7a-411b-8548-6d23e5033f21"],


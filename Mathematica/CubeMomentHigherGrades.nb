Cell["\<\
a small number on one line, e.g. 1.1e-14 (ScientificForm prints its exponent \
on the line above)\
\>", "Text",ExpressionUUID->"eabe19fd-742c-4126-aa58-89572b5619b6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"eNote", "[", "v_", "]"}], " ", ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"v", " ", "==", " ", "0"}], ",", " ", "\"\<0\>\"", ",", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"e", " ", "=", " ", 
         RowBox[{"Floor", "[", 
          RowBox[{"Log10", "[", "v", "]"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{"ToString", "[", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{"v", "/", 
             RowBox[{"10", "^", "e"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "1"}], "}"}]}], "]"}], "]"}], " ", "<>", 
        " ", "\"\<e\>\"", " ", "<>", " ", 
        RowBox[{"ToString", "[", "e", "]"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"maxSum", " ", "=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "$nbScriptCommandLine", "]"}], " ", ">", " ", 
      "1"}], ",", " ", 
     RowBox[{"ToExpression", "[", 
      RowBox[{"$nbScriptCommandLine", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", " ", "6"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"3b0e2146-5949-49a3-acde-747626fc35fc"],

Cell["\<\
every scalar moment used here is stored on disk (Mathematica/cache/, never \
committed): the symbolic face integrals at four and more derivatives take \
minutes each, and the tensor assembly will ask for them again\
\>", "Text",ExpressionUUID->"faf23130-1c7b-4d58-b85a-73a9b56703ee"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"eC", "[", 
    RowBox[{"m_", ",", " ", "ds_List", ",", " ", "w_List"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", "Print", "}"}], ",", "\n", "   ", 
     RowBox[{"cached", "[", 
      RowBox[{
       RowBox[{"\"\<E_\>\"", " ", "<>", " ", 
        RowBox[{"ToString", "[", "m", "]"}], " ", "<>", " ", "\"\<_d\>\"", 
        " ", "<>", " ", 
        RowBox[{"StringJoin", "[", 
         RowBox[{"ToString", " ", "/@", " ", 
          RowBox[{"Sort", "[", "ds", "]"}]}], "]"}], " ", "<>", 
        " ", "\"\<_w\>\"", " ", "<>", " ", 
        RowBox[{"StringJoin", "[", 
         RowBox[{"ToString", " ", "/@", " ", 
          RowBox[{"Sort", "[", "w", "]"}]}], "]"}]}], ",", "\n", "    ", 
       RowBox[{"E$", "[", 
        RowBox[{"m", ",", " ", 
         RowBox[{"Sort", "[", "ds", "]"}], ",", " ", 
         RowBox[{"Sort", "[", "w", "]"}]}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"fa5a5039-5f88-4337-ac22-f93467a38ab9"],

Cell["\<\
an ordinary integral, for the grades with fewer than two derivatives, where \
no trace rule applies: the integrand d^D (1/r) w is integrable for D <= 1, \
and every non-vanishing index class of the grade is integrated numerically \
over the cube and compared with its closed form.  The integrand is not smooth \
at the corner r = 0 of the octant, so the corner is resolved in Duffy \
coordinates (as in CubeT27Assemble.wl): plain GlobalAdaptive reached the \
closed form of grade (1,3) to 1.7e-12 but warned NIntegrate::eincr. Returns \
{pass, classes checked, largest relative difference}.\
\>", "Text",ExpressionUUID->"900a9096-0e53-418f-8dc1-912725253ef8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"nintCheck", "[", 
    RowBox[{"dd_", ",", " ", "ww_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rs", ",", " ", 
       RowBox[{"xs", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}]}], ",", " ", 
       "rel"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"rs", " ", "=", " ", 
       RowBox[{"reps", "[", 
        RowBox[{"dd", ",", " ", "ww"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"rs", " ", "===", " ", 
         RowBox[{"{", "}"}]}], ",", " ", 
        RowBox[{"Return", "[", 
         RowBox[{"{", 
          RowBox[{"True", ",", " ", "0", ",", " ", "0"}], "}"}], "]"}]}], 
       "]"}], ";", "\n", "  ", 
      RowBox[{"rel", " ", "=", " ", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ds", ",", " ", "ws"}], "}"}], ",", " ", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"val", ",", " ", "num", ",", " ", "f"}], "}"}], ",", 
            "\n", "      ", 
            RowBox[{
             RowBox[{"val", " ", "=", " ", 
              RowBox[{"N", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"eC", "[", 
                  RowBox[{
                   RowBox[{"-", "1"}], ",", " ", "ds", ",", " ", "ws"}], 
                  "]"}], " ", "/.", " ", 
                 RowBox[{"Del", " ", "->", " ", "1"}]}], ",", " ", "20"}], 
               "]"}]}], ";", "\n", "      ", 
             RowBox[{"f", " ", "=", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"Times", " ", "@@", " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"xs", "[", 
                    RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", 
                   " ", "ws"}], ")"}]}], ")"}], " ", 
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{"1", "/", 
                  RowBox[{"Sqrt", "[", 
                   RowBox[{
                    RowBox[{"x", "^", "2"}], " ", "+", " ", 
                    RowBox[{"y", "^", "2"}], " ", "+", " ", 
                    RowBox[{"z", "^", "2"}]}], "]"}]}], ",", " ", 
                 RowBox[{"Sequence", " ", "@@", " ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"xs", "[", 
                    RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", 
                    " ", "ds"}], ")"}]}]}], "]"}]}]}], ";", "\n", "      ", 
             RowBox[{"num", " ", "=", " ", 
              RowBox[{"8", " ", 
               RowBox[{"NIntegrate", "[", 
                RowBox[{"f", ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"x", ",", " ", "0", ",", " ", 
                   RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"y", ",", " ", "0", ",", " ", 
                   RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"z", ",", " ", "0", ",", " ", 
                   RowBox[{"1", "/", "2"}]}], "}"}], ",", "\n", "         ", 
                 RowBox[{"Method", " ", "->", " ", 
                  RowBox[{"{", 
                   RowBox[{"\"\<GlobalAdaptive\>\"", ",", " ", 
                    
                    RowBox[{"\"\<SingularityHandler\>\"", " ", "->", 
                    " ", "\"\<DuffyCoordinates\>\""}]}], "}"}]}], ",", "\n", 
                 "         ", 
                 RowBox[{"PrecisionGoal", " ", "->", " ", "10"}], ",", " ", 
                 RowBox[{"AccuracyGoal", " ", "->", " ", "12"}], ",", " ", 
                 RowBox[{"MaxRecursion", " ", "->", " ", "25"}], ",", " ", 
                 RowBox[{"WorkingPrecision", " ", "->", " ", "20"}]}], 
                "]"}]}]}], ";", "\n", "      ", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"val", " ", "-", " ", "num"}], "]"}], "/", 
              RowBox[{"Max", "[", 
               RowBox[{"1", ",", " ", 
                RowBox[{"Abs", "[", "val", "]"}]}], "]"}]}]}]}], "]"}]}], 
         "]"}], " ", "@@@", " ", "rs"}]}], ";", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", "rel", "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "8"}]}]}], ",", " ", 
        RowBox[{"Length", "[", "rs", "]"}], ",", " ", 
        RowBox[{"Max", "[", "rel", "]"}]}], "}"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"efe4efba-c8d9-4a3c-96db-16b598e926cf"],

Cell["\<\
the zero test between closed forms.  The engine's zeroQ evaluates at 50 extra \
digits and falls back on Simplify; at the higher weights the integrator \
returns logarithms the Pell reduction does not recognise (Log[Sqrt[3] - 1], \
Log[1 + Sqrt[3]], ArcTanh), an exact zero is then not certified, and Simplify \
can take the kernel down.  Here the difference is evaluated with 3000 extra \
digits: an exact zero returns a zero of that accuracy.  \
(CubeMomentCanonical.wl puts every stored form into one canonical basis \
afterwards.)\
\>", "Text",ExpressionUUID->"a8dedcca-bf57-4e5a-8ef9-2d885de9e9b8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"exactZero", "[", "e_", "]"}], " ", ":=", " ", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"$MaxExtraPrecision", " ", "=", " ", "3000"}], "}"}], ",", "\n",
      "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"v", " ", "=", " ", 
         RowBox[{"Quiet", "[", 
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"e", " ", "/.", " ", 
             RowBox[{"Del", " ", "->", " ", 
              RowBox[{"37", "/", "29"}]}]}], ",", " ", "40"}], "]"}], "]"}]}],
         "}"}], ",", " ", 
       RowBox[{
        RowBox[{"Abs", "[", "v", "]"}], " ", "<", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "30"}]}]}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"ceeb3dfb-4b0b-4131-b8ac-026189af1159"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"grades", "[", "q_", "]"}], " ", ":=", " ", 
   RowBox[{"Union", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"EvenQ", "[", 
            RowBox[{"m", " ", "+", " ", "w"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"m", ",", " ", "w"}], "}"}], ",", " ", "Nothing"}], "]"}],
          ",", " ", 
         RowBox[{"{", 
          RowBox[{"m", ",", " ", "0", ",", " ", "q"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"w", ",", " ", "0", ",", " ", "q"}], "}"}]}], "]"}], ",", 
       " ", "1"}], "]"}], ",", "\n", "   ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"EvenQ", "[", 
            RowBox[{"m", " ", "+", " ", "1", " ", "+", " ", "w"}], "]"}], ",",
            " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"m", " ", "+", " ", "1"}], ",", " ", "w"}], "}"}], ",", 
           " ", "Nothing"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"m", ",", " ", "0", ",", " ", "q"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"w", ",", " ", "0", ",", " ", 
           RowBox[{"q", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ",", " ", 
       "1"}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"0f95c6f2-922c-4dce-9605-0f87fb95bcf8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", \
"\"\<==============================================================\>\"", 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<MOMENTS BEYOND THE SIX\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", \
"\"\<==============================================================\>\"", 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<[1] grades (D, W) needed by the hierarchy of degree \
q\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<    q = \>\"", ",", " ", "q", ",", " ", "\"\<: \>\"", ",", 
      " ", 
      RowBox[{"Length", "[", 
       RowBox[{"grades", "[", "q", "]"}], "]"}], ",", 
      " ", "\"\< grades; new beyond q = \>\"", ",", " ", 
      RowBox[{"q", " ", "-", " ", "1"}], ",", " ", "\"\<: \>\"", ",", "\n", 
      "   ", 
      RowBox[{"Complement", "[", 
       RowBox[{
        RowBox[{"grades", "[", "q", "]"}], ",", " ", 
        RowBox[{"grades", "[", 
         RowBox[{"q", " ", "-", " ", "1"}], "]"}]}], "]"}]}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"q", ",", " ", "2", ",", " ", "5"}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<    q = 2 is the six: \>\"", ",", " ", 
    RowBox[{"grades", "[", "2", "]"}]}], "]"}], ";"}]}], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"2f574bc7-01bf-44db-bbc9-c3508bea3dc7"],


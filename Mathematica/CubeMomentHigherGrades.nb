Cell["\<\
(d_rest w)(0) for a monomial weight w = x_{w1}..x_{wW} and a derivative \
multi-index rest\
\>", "Text",ExpressionUUID->"b7cca6fc-555f-485b-b733-a928b14cd78c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"derivAtZero", "[", 
    RowBox[{"rest_List", ",", " ", "w_List"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"xs", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{"xa", ",", " ", "xb", ",", " ", "xc"}], "}"}]}], ",", " ", 
       "f"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"f", " ", "=", " ", 
       RowBox[{"Times", " ", "@@", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"xs", "[", 
            RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", " ", "w"}],
          ")"}]}]}], ";", "\n", "  ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"D", "[", 
         RowBox[{"f", ",", " ", 
          RowBox[{"Sequence", " ", "@@", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"xs", "[", 
               RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
             "rest"}], ")"}]}]}], "]"}], ")"}], " ", "/.", " ", 
       RowBox[{"Thread", "[", 
        RowBox[{"xs", " ", "->", " ", "0"}], "]"}]}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"08beb126-3a7b-4643-b782-fa696803b3f7"],

Cell["\<\

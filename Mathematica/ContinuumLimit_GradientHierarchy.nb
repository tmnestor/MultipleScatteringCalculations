Cell["\<\
[2] the first-order factor in closed form.  A source held to its Taylor \
polynomial of degree dg about the
cell centre radiates the exact first-order term times 1 + E, with t = k h:
    dg odd :  R and T alike   (-1)^((dg-1)/2) t^(dg+1)/(dg+2)!
    dg even:  R  (-1)^(dg/2) t^(dg+2)/(dg+2)! ,   T  (-1)^(dg/2+1) (dg+1) \
t^(dg+2)/(dg+3)!
The source degree is q for the density term and q - 1 for the modulus term.  \
Derived here symbolically
from  Int P_dg(I t x) Exp[-/+ I t x] dx  and compared with the scheme on one \
cell at a contrast of 10^-20,
where the second-order term is far below every factor tested. \
\>", "Program",ExpressionUUID->"86c92908-9ce8-492f-ad53-05d0b7ac1592"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"bornLead", "[", 
    RowBox[{"dg_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"OddQ", "[", "dg", "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1"}], "}"}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"dg", " ", "-", " ", "1"}], ")"}], "/", "2"}], ")"}]}], " ", 
      RowBox[{
       RowBox[{"t", "^", 
        RowBox[{"(", 
         RowBox[{"dg", " ", "+", " ", "1"}], ")"}]}], "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"dg", " ", "+", " ", "2"}], ")"}], "!"}]}]}], ",", "\n", 
     "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"dg", "/", "2"}], ")"}]}], " ", 
        RowBox[{
         RowBox[{"t", "^", 
          RowBox[{"(", 
           RowBox[{"dg", " ", "+", " ", "2"}], ")"}]}], "/", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"dg", " ", "+", " ", "2"}], ")"}], "!"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"dg", "/", "2"}], " ", "+", " ", "1"}], ")"}]}], " ", 
        RowBox[{"(", 
         RowBox[{"dg", " ", "+", " ", "1"}], ")"}], " ", 
        RowBox[{
         RowBox[{"t", "^", 
          RowBox[{"(", 
           RowBox[{"dg", " ", "+", " ", "2"}], ")"}]}], "/", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"dg", " ", "+", " ", "3"}], ")"}], "!"}]}]}]}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"symOk", " ", "=", " ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", " ", "6"}], "]"}], ",", " ", 
     RowBox[{"Function", "[", 
      RowBox[{"dg", ",", " ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "pp", ",", " ", "ft", ",", " ", "fr", ",", " ", "tt", ",", " ", 
           "xx", ",", " ", "lr", ",", " ", "lt", ",", " ", "ordr"}], "}"}], ",",
          "\n", "     ", 
         RowBox[{
          RowBox[{"pp", " ", "=", " ", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"I", " ", "tt", " ", "xx"}], ")"}], "^", "m"}], "/", 
              RowBox[{"m", "!"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"m", ",", " ", "0", ",", " ", "dg"}], "}"}]}], "]"}]}], 
          ";", "\n", "     ", 
          RowBox[{"ft", " ", "=", " ", 
           RowBox[{
            RowBox[{"Integrate", "[", 
             RowBox[{
              RowBox[{"pp", " ", 
               RowBox[{"Exp", "[", 
                RowBox[{
                 RowBox[{"-", "I"}], " ", "tt", " ", "xx"}], "]"}]}], ",", 
              " ", 
              RowBox[{"{", 
               RowBox[{"xx", ",", " ", 
                RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], "]"}], "/", 
            "2"}]}], ";", "\n", "     ", 
          RowBox[{"fr", " ", "=", " ", 
           RowBox[{
            RowBox[{"Integrate", "[", 
             RowBox[{
              RowBox[{"pp", " ", 
               RowBox[{"Exp", "[", 
                RowBox[{"I", " ", "tt", " ", "xx"}], "]"}]}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"xx", ",", " ", 
                RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], "]"}], "/", 
            RowBox[{"Integrate", "[", 
             RowBox[{
              RowBox[{"Exp", "[", 
               RowBox[{"2", " ", "I", " ", "tt", " ", "xx"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"xx", ",", " ", 
                RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], "]"}]}]}], ";", 
          "\n", "     ", 
          RowBox[{"ordr", " ", "=", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"OddQ", "[", "dg", "]"}], ",", " ", 
             RowBox[{"dg", " ", "+", " ", "1"}], ",", " ", 
             RowBox[{"dg", " ", "+", " ", "2"}]}], "]"}]}], ";", "\n", 
          "     ", 
          RowBox[{"lr", " ", "=", " ", 
           RowBox[{"Normal", "[", 
            RowBox[{"Series", "[", 
             RowBox[{
              RowBox[{"fr", " ", "-", " ", "1"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"tt", ",", " ", "0", ",", " ", "ordr"}], "}"}]}], 
             "]"}], "]"}]}], ";", " ", 
          RowBox[{"lt", " ", "=", " ", 
           RowBox[{"Normal", "[", 
            RowBox[{"Series", "[", 
             RowBox[{
              RowBox[{"ft", " ", "-", " ", "1"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"tt", ",", " ", "0", ",", " ", "ordr"}], "}"}]}], 
             "]"}], "]"}]}], ";", "\n", "     ", 
          RowBox[{
           RowBox[{"Simplify", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"lr", ",", " ", "lt"}], "}"}], " ", "-", " ", 
             RowBox[{"bornLead", "[", 
              RowBox[{"dg", ",", " ", "tt"}], "]"}]}], "]"}], " ", "===", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}]}]}]}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  [2a] the closed-form leading factor is the series of the \
cell integral, source degrees 0..6: \>\"", ",", " ", 
    RowBox[{"pass", "[", "symOk", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"AppendTo", "[", 
   RowBox[{"allOks", ",", " ", "symOk"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"omB", " ", "=", " ", "150"}], ",", " ", 
      RowBox[{"sc", " ", "=", " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "20"}]}]}], ",", " ", "t", ",", " ", 
      RowBox[{"okAll", " ", "=", " ", "True"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"t", " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"omB", "/", "al"}], ")"}], " ", 
       RowBox[{"dLayer", "/", "2"}]}]}], ";", "\n", "  ", 
     RowBox[{"Do", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"drho", " ", "=", " ", 
            RowBox[{
             RowBox[{"cs", "[", 
              RowBox[{"[", "2", "]"}], "]"}], " ", "sc"}]}], ",", " ", 
           RowBox[{"dm", " ", "=", " ", 
            RowBox[{
             RowBox[{"cs", "[", 
              RowBox[{"[", "3", "]"}], "]"}], " ", "sc"}]}], ",", " ", 
           RowBox[{"shift", " ", "=", " ", 
            RowBox[{"cs", "[", 
             RowBox[{"[", "4", "]"}], "]"}]}], ",", " ", "ex", ",", " ", 
           "got", ",", " ", "meas", ",", " ", "pred", ",", " ", "rel", ",", 
           " ", "ok"}], "}"}], ",", "\n", "    ", 
         RowBox[{
          RowBox[{"ex", " ", "=", " ", 
           RowBox[{"exactScat", "[", 
            RowBox[{"omB", ",", " ", "drho", ",", " ", "dm"}], "]"}]}], ";", 
          "\n", "    ", 
          RowBox[{"Do", "[", "\n", "     ", 
           RowBox[{
            RowBox[{
             RowBox[{"got", " ", "=", " ", 
              RowBox[{"solveHier", "[", 
               RowBox[{
               "omB", ",", " ", "1", ",", " ", "q", ",", " ", "drho", ",", 
                " ", "dm"}], "]"}]}], ";", "\n", "     ", 
             RowBox[{"meas", " ", "=", " ", 
              RowBox[{"Re", "[", 
               RowBox[{
                RowBox[{"got", "/", "ex"}], " ", "-", " ", "1"}], "]"}]}], ";",
              " ", 
             RowBox[{"pred", " ", "=", " ", 
              RowBox[{"N", "[", 
               RowBox[{
                RowBox[{"bornLead", "[", 
                 RowBox[{
                  RowBox[{"q", " ", "-", " ", "shift"}], ",", " ", "t"}], 
                 "]"}], ",", " ", "30"}], "]"}]}], ";", "\n", "     ", 
             RowBox[{"rel", " ", "=", " ", 
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"meas", " ", "-", " ", "pred"}], ")"}], "/", 
                "pred"}], "]"}]}], ";", " ", 
             RowBox[{"ok", " ", "=", " ", 
              RowBox[{
               RowBox[{"Max", "[", "rel", "]"}], " ", "<", " ", 
               RowBox[{"5", "/", "1000"}]}]}], ";", " ", 
             RowBox[{"okAll", " ", "=", " ", 
              RowBox[{"okAll", " ", "&&", " ", "ok"}]}], ";", "\n", "     ", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<    \>\"", ",", " ", 
               RowBox[{"cs", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", " ", "\"\< q = \>\"", ",",
                " ", "q", ",", " ", "\"\< (source degree \>\"", ",", " ", 
               RowBox[{"q", " ", "-", " ", "shift"}], ",", 
               " ", "\"\<):  R \>\"", ",", " ", 
               RowBox[{"sci", "[", 
                RowBox[{"meas", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
               " ", "\"\< vs \>\"", ",", " ", 
               RowBox[{"sci", "[", 
                RowBox[{"pred", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", "\n", 
               "      ", "\"\<   T \>\"", ",", " ", 
               RowBox[{"sci", "[", 
                RowBox[{"meas", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", 
               " ", "\"\< vs \>\"", ",", " ", 
               RowBox[{"sci", "[", 
                RowBox[{"pred", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", 
               " ", "\"\<   \>\"", ",", " ", 
               RowBox[{"pass", "[", "ok", "]"}]}], "]"}]}], ",", "\n", 
            "     ", 
            RowBox[{"{", 
             RowBox[{"q", ",", " ", "1", ",", " ", "6"}], "}"}]}], "]"}]}]}], 
        "]"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"cs", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            
            RowBox[{"\"\<density\>\"", ",", " ", "dRho0", ",", " ", "0", ",", 
             " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<modulus\>\"", ",", " ", "0", ",", " ", "dM0", ",", 
             " ", "1"}], "}"}]}], "}"}]}], "}"}]}], "]"}], ";", "\n", "  ", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<  [2b] scheme on one cell against the closed form, k h = \
\>\"", ",", " ", 
       RowBox[{"N", "[", "t", "]"}], ",", " ", "\"\<, to 0.5%: \>\"", ",", 
       " ", 
       RowBox[{"pass", "[", "okAll", "]"}]}], "]"}], ";", "\n", "  ", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"allOks", ",", " ", "okAll"}], "]"}]}]}], "]"}], 
  ";"}]}], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"935841a4-4547-4b5a-9bbb-88db54e95788"],


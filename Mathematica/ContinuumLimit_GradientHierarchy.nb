              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"mm", " ", "==", " ", 
                  RowBox[{"m", " ", "-", " ", "1"}]}], ",", " ", "own", ",", 
                 " ", "0"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"mm", ",", " ", "0", ",", " ", "q"}], "}"}]}], 
              "]"}]}], ";", "\n", "    ", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"aDer", ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "locA"}], "/", "mP"}], " ", "-", " ", 
               RowBox[{
                RowBox[{"kk", "^", "2"}], " ", 
                RowBox[{"aDer", "[", 
                 RowBox[{"[", 
                  RowBox[{"m", " ", "-", " ", "1"}], "]"}], "]"}]}]}]}], 
             "]"}], ";", "\n", "    ", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"bDer", ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "locB"}], "/", "mP"}], " ", "-", " ", 
               RowBox[{
                RowBox[{"kk", "^", "2"}], " ", 
                RowBox[{"bDer", "[", 
                 RowBox[{"[", 
                  RowBox[{"m", " ", "-", " ", "1"}], "]"}], "]"}]}]}]}], 
             "]"}]}], ",", "\n", "    ", 
           RowBox[{"{", 
            RowBox[{"m", ",", " ", "2", ",", " ", 
             RowBox[{"q", " ", "+", " ", "1"}]}], "}"}]}], "]"}], ";", "\n", 
         "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"big", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"i", " ", "-", " ", "1"}], ")"}], " ", "nu"}], " ", 
                "+", " ", "m", " ", "+", " ", "1"}], ",", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"j", " ", "-", " ", "1"}], ")"}], " ", "nu"}], " ",
                  "+", " ", "1"}], " ", ";;", " ", 
                RowBox[{"j", " ", "nu"}]}]}], "]"}], "]"}], " ", "-=", " ", 
            RowBox[{
             RowBox[{"a", " ", 
              RowBox[{"aDer", "[", 
               RowBox[{"[", 
                RowBox[{"m", " ", "+", " ", "1"}], "]"}], "]"}]}], " ", "+", 
             " ", 
             RowBox[{"b", " ", 
              RowBox[{"bDer", "[", 
               RowBox[{"[", 
                RowBox[{"m", " ", "+", " ", "2"}], "]"}], "]"}]}]}]}], ",", 
           " ", 
           RowBox[{"{", 
            RowBox[{"m", ",", " ", "0", ",", " ", "q"}], "}"}]}], "]"}]}], ",",
         "\n", "   ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "n"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "n"}], "}"}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"rhs", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"I", " ", "kk"}], ")"}], "^", "m"}], " ", 
             RowBox[{"Exp", "[", 
              RowBox[{"I", " ", "kk", " ", 
               RowBox[{"zc", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "n"}], "}"}], ",", " ", 

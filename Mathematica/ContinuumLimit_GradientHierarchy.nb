                "]"}], ",", " ", "q"}], "]"}]}], ";", "\n", "     ", 
            RowBox[{
             RowBox[{"a", " ", 
              RowBox[{"gi", " ", ".", " ", 
               RowBox[{"sol", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}]}], " ", "+", " ", 
             RowBox[{"b", " ", 
              RowBox[{
               RowBox[{"di", "[", 
                RowBox[{"[", 
                 RowBox[{"1", " ", ";;", " ", "q"}], "]"}], "]"}], " ", ".", 

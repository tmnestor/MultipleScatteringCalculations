Cell["the exact layer: continuity of u and M u' at both faces", "Text",ExpressionUUID->"0e5123d8-096e-4883-ab8f-a0b224d0b4e8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"exactScat", "[", 
    RowBox[{"om_", ",", " ", "drho_", ",", " ", "dm_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"k0", " ", "=", " ", 
        RowBox[{"om", "/", "al"}]}], ",", " ", 
       RowBox[{"m1", " ", "=", " ", 
        RowBox[{"mP", " ", "+", " ", "dm"}]}], ",", " ", 
       RowBox[{"rho1", " ", "=", " ", 
        RowBox[{"rho", " ", "+", " ", "drho"}]}], ",", " ", "k1", ",", " ", 
       "z0", ",", " ", "z1", ",", " ", "r", ",", " ", "aa", ",", " ", "bb", ",",
        " ", "t", ",", " ", "sol"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"k1", " ", "=", " ", 
       RowBox[{"om", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"rho1", "/", "m1"}], "]"}]}]}], ";", " ", 
      RowBox[{"z0", " ", "=", " ", 
       RowBox[{"mP", " ", "k0"}]}], ";", " ", 
      RowBox[{"z1", " ", "=", " ", 
       RowBox[{"m1", " ", "k1"}]}], ";", "\n", "  ", 
      RowBox[{"sol", " ", "=", " ", 
       RowBox[{"First", "@", 
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"1", " ", "+", " ", "r"}], " ", "==", " ", 
             RowBox[{"aa", " ", "+", " ", "bb"}]}], ",", " ", 
            RowBox[{
             RowBox[{"z0", " ", 
              RowBox[{"(", 
               RowBox[{"1", " ", "-", " ", "r"}], ")"}]}], " ", "==", " ", 
             RowBox[{"z1", " ", 
              RowBox[{"(", 
               RowBox[{"aa", " ", "-", " ", "bb"}], ")"}]}]}], ",", "\n", 
            "      ", 
            RowBox[{
             RowBox[{
              RowBox[{"aa", " ", 
               RowBox[{"Exp", "[", 
                RowBox[{"I", " ", "k1", " ", "dLayer"}], "]"}]}], " ", "+", 
              " ", 
              RowBox[{"bb", " ", 
               RowBox[{"Exp", "[", 
                RowBox[{
                 RowBox[{"-", "I"}], " ", "k1", " ", "dLayer"}], "]"}]}]}], 
             " ", "==", " ", "t"}], ",", "\n", "      ", 
            RowBox[{
             RowBox[{"z1", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"aa", " ", 
                 RowBox[{"Exp", "[", 
                  RowBox[{"I", " ", "k1", " ", "dLayer"}], "]"}]}], " ", "-", 
                " ", 
                RowBox[{"bb", " ", 
                 RowBox[{"Exp", "[", 
                  RowBox[{
                   RowBox[{"-", "I"}], " ", "k1", " ", "dLayer"}], "]"}]}]}], 
               ")"}]}], " ", "==", " ", 
             RowBox[{"z0", " ", "t"}]}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"r", ",", " ", "aa", ",", " ", "bb", ",", " ", "t"}], 
           "}"}]}], "]"}]}]}], ";", "\n", "  ", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"r", " ", "/.", " ", "sol"}], ")"}], " ", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "I"}], " ", "k0", " ", "zR"}], "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"t", " ", "/.", " ", "sol"}], ")"}], " ", 
            RowBox[{"Exp", "[", 
             RowBox[{"I", " ", "k0", " ", 
              RowBox[{"(", 
               RowBox[{"zT", " ", "-", " ", "dLayer"}], ")"}]}], "]"}]}], " ",
            "-", " ", 
           RowBox[{"Exp", "[", 
            RowBox[{"I", " ", "k0", " ", "zT"}], "]"}]}]}], "}"}], ",", " ", 
        "prec"}], "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"afc3fe17-c2c5-4264-8ddd-591eec73087a"],

Cell["\<\
closed-form integral of Exp[-I s k xi] xi^m/m! over (lo, hi), s = +1 or -1\
\>", "Text",ExpressionUUID->"a5e887a8-2887-4c5a-b30b-a8f8cf97b5f2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"fInt", "[", 
      RowBox[{"m", ",", " ", "s"}], "]"}], " ", "=", " ", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"kk", ",", " ", "lo", ",", " ", "hi"}], "}"}], ",", " ", 
       RowBox[{"Evaluate", "[", "\n", "     ", 
        RowBox[{
         RowBox[{"Integrate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "I"}], " ", "s", " ", "kq", " ", "xq"}], "]"}], " ", 
            RowBox[{
             RowBox[{"xq", "^", "m"}], "/", 
             RowBox[{"m", "!"}]}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"xq", ",", " ", "loq", ",", " ", "hiq"}], "}"}]}], "]"}], 
         " ", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"kq", " ", "->", " ", "kk"}], ",", " ", 
           RowBox[{"loq", " ", "->", " ", "lo"}], ",", " ", 
           RowBox[{"hiq", " ", "->", " ", "hi"}]}], "}"}]}], "]"}]}], "]"}]}],
     ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"m", ",", " ", "0", ",", " ", "6"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"s", ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", 
        RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "]"}], ";"}]], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"0674b14b-8046-4a3e-90da-bdb6edcec5f1"],

Cell["\<\
Int g(delta - xi) xi^m/m! and Int dg/dz(delta - xi) xi^m/m! over the cell \
(-h, h), m = 0..q\
\>", "Text",ExpressionUUID->"33d2e599-db9a-43cb-bcca-2adf44182d01"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"cellInts", "[", 
    RowBox[{"kk_", ",", " ", "h_", ",", " ", "delta_", ",", " ", "q_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"I", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "mP", " ", "kk"}], ")"}]}]}], ",", " ", "gi", ",",
        " ", "di", ",", " ", "pieces"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"pieces", " ", "=", " ", 
       RowBox[{"Which", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"delta", " ", ">=", " ", "h"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", 
            RowBox[{"-", "h"}], ",", " ", "h"}], "}"}], "}"}], ",", "\n", 
         "    ", 
         RowBox[{"delta", " ", "<=", " ", 
          RowBox[{"-", "h"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", " ", 
            RowBox[{"-", "h"}], ",", " ", "h"}], "}"}], "}"}], ",", "\n", 
         "    ", "True", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", 
             RowBox[{"-", "h"}], ",", " ", "delta"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", " ", "delta", ",", " ", "h"}], "}"}]}], 
          "}"}]}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"gi", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"c", " ", 
            RowBox[{"Exp", "[", 
             RowBox[{"I", " ", 
              RowBox[{"pc", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", "kk", " ", "delta"}], 
             "]"}], " ", 
            RowBox[{
             RowBox[{"fInt", "[", 
              RowBox[{"m", ",", " ", 
               RowBox[{"pc", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "[", 
             RowBox[{"kk", ",", " ", 
              RowBox[{"pc", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
              RowBox[{"pc", "[", 
               RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"pc", ",", " ", "pieces"}], "}"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"m", ",", " ", "0", ",", " ", "q"}], "}"}]}], "]"}]}], ";", 
      "\n", "  ", 
      RowBox[{"di", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"I", " ", "kk", " ", 
            RowBox[{"pc", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "c", " ", 
            RowBox[{"Exp", "[", 
             RowBox[{"I", " ", 
              RowBox[{"pc", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", "kk", " ", "delta"}], 
             "]"}], " ", 
            RowBox[{
             RowBox[{"fInt", "[", 
              RowBox[{"m", ",", " ", 
               RowBox[{"pc", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "[", 
             RowBox[{"kk", ",", " ", 
              RowBox[{"pc", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
              RowBox[{"pc", "[", 
               RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"pc", ",", " ", "pieces"}], "}"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"m", ",", " ", "0", ",", " ", "q"}], "}"}]}], "]"}]}], ";", 
      "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"gi", ",", " ", "di"}], "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"47aa92ff-a2e7-483e-919f-5b0f7d771788"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"solveHier", "[", 
    RowBox[{
    "om_", ",", " ", "n_", ",", " ", "q_", ",", " ", "drho_", ",", " ", 
     "dm_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"kk", " ", "=", " ", 
        RowBox[{"om", "/", "al"}]}], ",", " ", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{
         RowBox[{"om", "^", "2"}], " ", "drho"}]}], ",", " ", 
       RowBox[{"b", " ", "=", " ", "dm"}], ",", " ", 
       RowBox[{"d", " ", "=", " ", 
        RowBox[{"dLayer", "/", "n"}]}], ",", " ", "h", ",", " ", "zc", ",", 
       " ", 
       RowBox[{"nu", " ", "=", " ", 
        RowBox[{"q", " ", "+", " ", "1"}]}], ",", " ", "big", ",", " ", "rhs",
        ",", " ", "sol", ",", " ", "gi", ",", " ", "di", ",", " ", "aDer", ",",
        " ", "bDer", ",", " ", "own", ",", " ", "locA", ",", " ", "locB"}], 
      "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"h", " ", "=", " ", 
       RowBox[{"d", "/", "2"}]}], ";", " ", 
      RowBox[{"zc", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"j", " ", "-", " ", 
            RowBox[{"1", "/", "2"}]}], ")"}], " ", "d"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "n"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"big", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"IdentityMatrix", "[", 
          RowBox[{"n", " ", "nu"}], "]"}], ",", " ", "prec"}], "]"}]}], ";", 
      "\n", "  ", 
      RowBox[{"Do", "[", "\n", "   ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"evaluated", " ", "from", " ", "60"}], "-", 
          RowBox[{"digit", " ", 
           RowBox[{"arguments", ":", " ", 
            RowBox[{"from", " ", "exact", " ", "ones"}]}]}]}], ",", " ", 
         RowBox[{
         "entries", " ", "that", " ", "are", " ", "exactly", " ", "zero", " ",
           "but", " ", "not", " ", "recognised", " ", "as", "\n", "      ", 
          "zero", " ", 
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", 
            RowBox[{
             RowBox[{"E", "^", 
              RowBox[{"(", 
               RowBox[{"3", " ", 
                RowBox[{"I", "/", "100"}]}], ")"}]}], " ", "against", " ", 
             "its", " ", "partner"}]}], ")"}], " ", "made", " ", "N", " ", 
          "warn", " ", 
          RowBox[{"N", "::", "meprec"}]}], ",", " ", 
         RowBox[{
         "since", " ", "no", " ", "number", " ", "of", " ", "extra", " ", 
          "digits", " ", "gives", "\n", "      ", "a", " ", "zero", " ", "60",
           " ", "digits", " ", "of", " ", "relative", " ", "precision"}]}], 
        " ", "*)"}], "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"gi", ",", " ", "di"}], "}"}], " ", "=", " ", 
          RowBox[{"cellInts", "[", 
           RowBox[{
            RowBox[{"N", "[", 
             RowBox[{"kk", ",", " ", "prec"}], "]"}], ",", " ", 
            RowBox[{"N", "[", 
             RowBox[{"h", ",", " ", "prec"}], "]"}], ",", " ", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"zc", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", "-", " ", 
               RowBox[{"zc", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], ",", " ", "prec"}], "]"}], ",",
             " ", "q"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"own", " ", "=", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"i", " ", "==", " ", "j"}], ",", " ", "1", ",", " ", 
            "0"}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"aDer", " ", "=", " ", 
          RowBox[{"{", 
           RowBox[{"gi", ",", " ", "di"}], "}"}]}], ";", "\n", "   ", 
         RowBox[{"bDer", " ", "=", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"{", "0", "}"}], ",", " ", 
              RowBox[{"gi", "[", 
               RowBox[{"[", 
                RowBox[{"1", " ", ";;", " ", "q"}], "]"}], "]"}]}], "]"}], ",",
             " ", 
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"{", "0", "}"}], ",", " ", 
              RowBox[{"di", "[", 
               RowBox[{"[", 
                RowBox[{"1", " ", ";;", " ", "q"}], "]"}], "]"}]}], "]"}]}], 
           "}"}]}], ";", "\n", "   ", 
         RowBox[{"Do", "[", "\n", "    ", 
          RowBox[{
           RowBox[{
            RowBox[{"locA", " ", "=", " ", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"mm", " ", "==", " ", 
                  RowBox[{"m", " ", "-", " ", "2"}]}], ",", " ", "own", ",", 

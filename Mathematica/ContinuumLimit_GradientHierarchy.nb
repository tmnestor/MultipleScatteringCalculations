Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<==== ContinuumLimit_GradientHierarchy :: the gradient \
hierarchy as a scheme on the layer ====\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"om", " ", "=", " ", "300"}], ";", " ", 
  RowBox[{"ns", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "2", ",", " ", "4", ",", " ", "8", ",", " ", "16", ",", " ", "32"}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cases", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<density only\>\"", ",", " ", "dRho0", ",", " ", "0", ",", 
       " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "4"}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "4"}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "6"}], ",", " ", 
         RowBox[{"5", " ", "->", " ", "6"}], ",", " ", 
         RowBox[{"6", " ", "->", " ", "8"}]}], "|>"}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<modulus only\>\"", ",", " ", "0", ",", " ", "dM0", ",", 
       " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "2"}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "4"}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "4"}], ",", " ", 
         RowBox[{"5", " ", "->", " ", "6"}], ",", " ", 
         RowBox[{"6", " ", "->", " ", "6"}]}], "|>"}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<both\>\"", ",", " ", "dRho0", ",", " ", "dM0", ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "2"}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "4"}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "4"}], ",", " ", 
         RowBox[{"5", " ", "->", " ", "6"}], ",", " ", 
         RowBox[{"6", " ", "->", " ", "6"}]}], "|>"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"results", " ", "=", " ", 
   RowBox[{"<|", "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"label", " ", "=", " ", 
         RowBox[{"cs", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
        RowBox[{"drho", " ", "=", " ", 
         RowBox[{"cs", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
        RowBox[{"dm", " ", "=", " ", 
         RowBox[{"cs", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
        RowBox[{"want", " ", "=", " ", 
         RowBox[{"cs", "[", 
          RowBox[{"[", "4", "]"}], "]"}]}], ",", " ", "ex", ",", " ", "errs", 
        ",", " ", "ord", ",", " ", "ok", ",", " ", "kd"}], "}"}], ",", "\n", 
      "   ", 
      RowBox[{
       RowBox[{"ex", " ", "=", " ", 
        RowBox[{"exactScat", "[", 
         RowBox[{"om", ",", " ", "drho", ",", " ", "dm"}], "]"}]}], ";", "\n",
        "   ", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<  \>\"", ",", " ", "label", ",", 
         " ", "\"\<: relative error of the scattered field {R, T}\>\""}], 
        "]"}], ";", "\n", "   ", 
       RowBox[{"Do", "[", "\n", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"errs", " ", "=", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"solveHier", "[", 
                  RowBox[{
                  "om", ",", " ", "n", ",", " ", "q", ",", " ", "drho", ",", 
                   " ", "dm"}], "]"}], " ", "-", " ", "ex"}], ")"}], "/", 
               "ex"}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"n", ",", " ", "ns"}], "}"}]}], "]"}]}], ";", "\n", 
          "    ", 
          RowBox[{"ord", " ", "=", " ", 
           RowBox[{"Log", "[", 
            RowBox[{"2", ",", " ", 
             RowBox[{
              RowBox[{"errs", "[", 
               RowBox[{"[", 
                RowBox[{"-", "2"}], "]"}], "]"}], "/", 
              RowBox[{"errs", "[", 
               RowBox[{"[", 
                RowBox[{"-", "1"}], "]"}], "]"}]}]}], "]"}]}], ";", "\n", 
          "    ", 
          RowBox[{"ok", " ", "=", " ", 
           RowBox[{"AllTrue", "[", 
            RowBox[{"ord", ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"#", " ", "-", " ", 
                 RowBox[{"want", "[", "q", "]"}]}], "]"}], " ", "<", " ", 
               "0.3"}], " ", "&"}]}], "]"}]}], ";", "\n", "    ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"allOks", ",", " ", "ok"}], "]"}], ";", "\n", "    ", 
          RowBox[{"kd", " ", "=", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"om", "/", "al"}], ")"}], " ", 
            RowBox[{"dLayer", "/", 
             RowBox[{"Last", "[", "ns", "]"}]}]}]}], ";", "\n", "    ", 
          RowBox[{"Print", "[", 
           
           RowBox[{"\"\<    q = \>\"", ",", " ", "q", ",", 
            " ", "\"\<:  n = 16 \>\"", ",", " ", 
            RowBox[{"sci", " ", "/@", " ", 
             RowBox[{"errs", "[", 
              RowBox[{"[", 
               RowBox[{"-", "2"}], "]"}], "]"}]}], ",", 
            " ", "\"\<   n = 32 \>\"", ",", " ", 
            RowBox[{"sci", " ", "/@", " ", 
             RowBox[{"errs", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}]}], ",", "\n", 
            "     ", "\"\<   order \>\"", ",", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"NumberForm", "[", 
                 RowBox[{
                  RowBox[{"N", "[", "#", "]"}], ",", " ", "4"}], "]"}], " ", 
                "&"}], " ", "/@", " ", "ord"}], ",", " ", "OutputForm"}], 
             "]"}], ",", " ", "\"\<   predicted \>\"", ",", " ", 
            RowBox[{"want", "[", "q", "]"}], ",", " ", "\"\<   \>\"", ",", 
            " ", 
            RowBox[{"pass", "[", "ok", "]"}], ",", "\n", 
            "     ", "\"\<   error/(k d)^order at n = 32: \>\"", ",", " ", 
            RowBox[{"sci", " ", "/@", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"errs", "[", 
                RowBox[{"[", 
                 RowBox[{"-", "1"}], "]"}], "]"}], "/", 
               RowBox[{"kd", "^", 
                RowBox[{"want", "[", "q", "]"}]}]}], ")"}]}]}], "]"}], ";", 
          "\n", "    ", 
          RowBox[{
           RowBox[{"results", "[", 
            RowBox[{"label", " ", "<>", " ", "\"\< q=\>\"", " ", "<>", " ", 
             RowBox[{"ToString", "[", "q", "]"}]}], "]"}], " ", "=", " ", 
           RowBox[{"N", "[", 
            RowBox[{"errs", ",", " ", "17"}], "]"}]}]}], ",", "\n", "    ", 
         RowBox[{"{", 
          RowBox[{"q", ",", " ", "1", ",", " ", "6"}], "}"}]}], "]"}]}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"cs", ",", " ", "cases"}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  [1] every order as predicted (36 orders): \>\"", ",", " ", 
    RowBox[{"pass", "[", 
     RowBox[{"And", " ", "@@", " ", "allOks"}], "]"}]}], "]"}], 
  ";"}]}], "Input",

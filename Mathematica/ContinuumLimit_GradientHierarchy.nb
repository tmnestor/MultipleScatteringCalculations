              RowBox[{
               RowBox[{"N", "[", 
                RowBox[{"kk", ",", " ", "prec"}], "]"}], ",", " ", 
               RowBox[{"N", "[", 
                RowBox[{"h", ",", " ", "prec"}], "]"}], ",", " ", 
               RowBox[{"N", "[", 
                RowBox[{
                 RowBox[{"zo", " ", "-", " ", 

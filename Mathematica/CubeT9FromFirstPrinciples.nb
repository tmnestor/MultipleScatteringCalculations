Cell["\<\
3.  THE ISOTROPIC-PLUS-CUBIC DECOMPOSITION

   A rank-4 tensor with cubic (O_h) symmetry and the symmetries of I has \
three
   independent components:

       I_{ijkl} = A d_ij d_kl + B (d_ik d_jl + d_il d_jk) + C E_{ijkl}

   with E the all-indices-equal structure. Reading them off:\
\>", "Text",ExpressionUUID->"ddbe0293-51df-4ff5-ba3c-d60a83c2c554"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Acub", " ", "=", " ", 
   RowBox[{"Simplify", "[", "I0011", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Bcub", " ", "=", " ", 
   RowBox[{"Simplify", "[", "I0101", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Ccub", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"I0000", " ", "-", " ", "Acub", " ", "-", " ", 
     RowBox[{"2", " ", "Bcub"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<[3] A = \>\"", ",", " ", "Acub"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<    B = \>\"", ",", " ", "Bcub"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<    C = \>\"", ",", " ", "Ccub"}], "]"}], ";"}]}], "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"0f084dea-2d18-412a-b153-4d7bd298f81f"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"[3] A = \"\>", "\[InvisibleSpace]", 
   FractionBox[
    RowBox[{
     RowBox[{
      SqrtBox["3"], " ", 
      RowBox[{"(", 
       RowBox[{"lam", "+", "mu"}], ")"}]}], "-", 
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{"lam", "+", 
        RowBox[{"2", " ", "mu"}]}], ")"}], " ", "\[Pi]"}]}], 
    RowBox[{"6", " ", "mu", " ", 
     RowBox[{"(", 
      RowBox[{"lam", "+", 
       RowBox[{"2", " ", "mu"}]}], ")"}], " ", "\[Pi]"}]]}],
  SequenceForm[
  "[3] A = ", 
   Rational[1, 6] $CellContext`mu^(-1) ($CellContext`lam + 
     2 $CellContext`mu)^(-1) 
   Pi^(-1) (3^Rational[1, 2] ($CellContext`lam + $CellContext`mu) - 
    2 ($CellContext`lam + 2 $CellContext`mu) Pi)],
  Editable->False]], "Print",
 CellChangeTimes->{3.998442541994163*^9},
 CellLabel->
  "During evaluation of \
In[17]:=",ExpressionUUID->"68b9964d-6b7b-4c0c-b6c0-58b7766bc6b1"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"    B = \"\>", "\[InvisibleSpace]", 
   FractionBox[
    RowBox[{"lam", "+", "mu"}], 
    RowBox[{"2", " ", 
     SqrtBox["3"], " ", "mu", " ", 
     RowBox[{"(", 
      RowBox[{"lam", "+", 
       RowBox[{"2", " ", "mu"}]}], ")"}], " ", "\[Pi]"}]]}],
  SequenceForm[
  "    B = ", Rational[1, 2] 
   3^Rational[-1, 
      2] $CellContext`mu^(-1) ($CellContext`lam + $CellContext`mu) \
($CellContext`lam + 2 $CellContext`mu)^(-1)/Pi],
  Editable->False]], "Print",
 CellChangeTimes->{3.998442541995022*^9},

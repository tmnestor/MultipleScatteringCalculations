Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"    shear strain concentration A_e = \"\>", "\[InvisibleSpace]", 
   FractionBox[
    RowBox[{"3", " ", "mu", " ", 
     RowBox[{"(", 
      RowBox[{"lam", "+", 
       RowBox[{"2", " ", "mu"}]}], ")"}], " ", "\[Pi]"}], 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], " ", "dmu", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"mu", " ", 
         RowBox[{"(", 
          RowBox[{
           SqrtBox["3"], "-", 
           RowBox[{"2", " ", "\[Pi]"}]}], ")"}]}], "+", 
        RowBox[{"lam", " ", 
         RowBox[{"(", 
          RowBox[{
           SqrtBox["3"], "-", "\[Pi]"}], ")"}]}]}], ")"}]}], "+", 
     RowBox[{"3", " ", "mu", " ", 
      RowBox[{"(", 
       RowBox[{"lam", "+", 
        RowBox[{"2", " ", "mu"}]}], ")"}], " ", "\[Pi]"}]}]]}],
  SequenceForm[
  "    shear strain concentration A_e = ", 
   3 $CellContext`mu ($CellContext`lam + 2 $CellContext`mu) 
   Pi/((-2) $CellContext`dmu ($CellContext`mu (3^Rational[1, 2] - 2 
       Pi) + $CellContext`lam (3^Rational[1, 2] - Pi)) + 
   3 $CellContext`mu ($CellContext`lam + 2 $CellContext`mu) Pi)],
  Editable->False]], "Print",
 CellChangeTimes->{3.998442542080017*^9},
 CellLabel->
  "During evaluation of \
In[28]:=",ExpressionUUID->"17c8f4ba-6a54-45e8-a11f-74da27a97e64"]

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"    C = \"\>", "\[InvisibleSpace]", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"lam", "+", "mu"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"5", " ", 
         SqrtBox["3"]}], "-", 
        RowBox[{"2", " ", "\[Pi]"}]}], ")"}]}], 
     RowBox[{"6", " ", "mu", " ", 
      RowBox[{"(", 
       RowBox[{"lam", "+", 
        RowBox[{"2", " ", "mu"}]}], ")"}], " ", "\[Pi]"}]]}]}],
  SequenceForm[
  "    C = ", 
   Rational[-1, 
     6] $CellContext`mu^(-1) ($CellContext`lam + $CellContext`mu) \
($CellContext`lam + 2 $CellContext`mu)^(-1) (5 3^Rational[1, 2] - 2 Pi)/Pi],
  Editable->False]], "Print",
 CellChangeTimes->{3.9984425419956713`*^9},

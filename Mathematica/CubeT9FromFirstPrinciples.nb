Cell["\<\
6.  THE SELF-CONSISTENT SYSTEM AND THE T-MATRIX

   With the affine ansatz the strain sector closes on itself:

       (delta_pr delta_ij - M_{in,pk} dc_{nkrj}) d_r u_j = d_p u^0_i ,
       M_{in,pk} = Int_cell d_p d_k G_in dV ,

   whose inverse is the strain concentration tensor. The effective contrast \
is
   then dc* = dc . A, and the cell T-matrix is T0 = V dc*.\
\>", "Text",ExpressionUUID->"140f7383-0960-4215-8e7c-f55e764b68c7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"delta", "[", 
    RowBox[{"i_", ",", " ", "j_"}], "]"}], " ", ":=", " ", 
   RowBox[{"KroneckerDelta", "[", 
    RowBox[{"i", ",", " ", "j"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Mt", "[", 
    RowBox[{"i_", ",", " ", "n_", ",", " ", "p_", ",", " ", "k_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{
    RowBox[{"Acub", " ", 
     RowBox[{"delta", "[", 
      RowBox[{"p", ",", " ", "k"}], "]"}], " ", 
     RowBox[{"delta", "[", 
      RowBox[{"i", ",", " ", "n"}], "]"}]}], " ", "+", "\n", "   ", 
    RowBox[{"Bcub", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"delta", "[", 
         RowBox[{"p", ",", " ", "i"}], "]"}], " ", 
        RowBox[{"delta", "[", 
         RowBox[{"k", ",", " ", "n"}], "]"}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"delta", "[", 
         RowBox[{"p", ",", " ", "n"}], "]"}], " ", 
        RowBox[{"delta", "[", 
         RowBox[{"k", ",", " ", "i"}], "]"}]}]}], ")"}]}], " ", "+", "\n", 
    "   ", 
    RowBox[{"Ccub", " ", 
     RowBox[{"Boole", "[", 
      RowBox[{
      "p", " ", "==", " ", "k", " ", "==", " ", "i", " ", "==", " ", "n"}], 
      "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dC", "[", 
    RowBox[{"i_", ",", " ", "j_", ",", " ", "k_", ",", " ", "l_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{
    RowBox[{"dlam", " ", 
     RowBox[{"delta", "[", 
      RowBox[{"i", ",", " ", "j"}], "]"}], " ", 
     RowBox[{"delta", "[", 
      RowBox[{"k", ",", " ", "l"}], "]"}]}], " ", "+", "\n", "   ", 
    RowBox[{"dmu", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"delta", "[", 
         RowBox[{"i", ",", " ", "k"}], "]"}], " ", 
        RowBox[{"delta", "[", 
         RowBox[{"j", ",", " ", "l"}], "]"}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"delta", "[", 
         RowBox[{"i", ",", " ", "l"}], "]"}], " ", 
        RowBox[{"delta", "[", 
         RowBox[{"j", ",", " ", "k"}], "]"}]}]}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"eta", "[", 
     RowBox[{"p_", ",", " ", "i_"}], "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{"3", " ", 
      RowBox[{"(", 
       RowBox[{"i", " ", "-", " ", "1"}], ")"}]}], " ", "+", " ", "p"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"A22", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{"0", ",", " ", 
     RowBox[{"{", "9", "}"}], ",", " ", 
     RowBox[{"{", "9", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"A22", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"eta", "[", 
         RowBox[{"r", ",", " ", "j"}], "]"}], ",", " ", 
        RowBox[{"eta", "[", 
         RowBox[{"p", ",", " ", "i"}], "]"}]}], "]"}], "]"}], " ", "=", "\n", 
     "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"delta", "[", 
        RowBox[{"p", ",", " ", "r"}], "]"}], " ", 
       RowBox[{"delta", "[", 
        RowBox[{"i", ",", " ", "j"}], "]"}]}], " ", "-", " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Mt", "[", 
          RowBox[{"i", ",", " ", "n", ",", " ", "p", ",", " ", "k"}], "]"}], " ", 
         RowBox[{"dC", "[", 
          RowBox[{"n", ",", " ", "k", ",", " ", "r", ",", " ", "j"}], "]"}]}],
         ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}]}], ",", "\n", " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", "3"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "3"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"j", ",", " ", "3"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"r", ",", " ", "3"}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"A22", " ", "=", " ", 
   RowBox[{"Simplify", "[", "A22", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<[6] 9x9 system assembled. Distinct entries: \>\"", ",", "\n",
      "  ", 
     RowBox[{"Length", "[", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Flatten", "[", "A22", "]"}], "]"}], "]"}]}], "]"}], ";"}], 
  "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"the", " ", "shear", " ", 
    RowBox[{"block", ":", " ", 
     RowBox[{"symmetric", " ", "combination", " ", "of", " ", 
      RowBox[{"(", 
       RowBox[{"p", ",", "i"}], ")"}], " ", "and", " ", 
      RowBox[{"(", 
       RowBox[{"i", ",", "p"}], ")"}]}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"shearAmp", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"A22", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"eta", "[", 
           RowBox[{"1", ",", " ", "2"}], "]"}], ",", " ", 
          RowBox[{"eta", "[", 
           RowBox[{"1", ",", " ", "2"}], "]"}]}], "]"}], "]"}], " ", "+", " ", 
       RowBox[{"A22", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"eta", "[", 
           RowBox[{"1", ",", " ", "2"}], "]"}], ",", " ", 
          RowBox[{"eta", "[", 
           RowBox[{"2", ",", " ", "1"}], "]"}]}], "]"}], "]"}]}], ")"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<    shear strain concentration A_e = \>\"", ",", " ", 
    "shearAmp"}], "]"}], ";"}]}], "Input",
 CellLabel->"In[28]:=",ExpressionUUID->"e9702059-ee2b-494e-9adc-b83bfd2a902e"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"[6] 9x9 system assembled. Distinct entries: \"\>", "\[InvisibleSpace]",
    "5"}],
  SequenceForm["[6] 9x9 system assembled. Distinct entries: ", 5],
  Editable->False]], "Print",

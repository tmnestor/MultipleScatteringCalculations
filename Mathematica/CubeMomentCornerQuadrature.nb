Cell["\<\
the closed form, from the store (as CubeMomentHigherGrades.wl reads it)\
\>", "Text",ExpressionUUID->"9c15abd4-075a-4596-83eb-d6d59e998f79"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"eC", "[", 
    RowBox[{"m_", ",", " ", "ds_List", ",", " ", "w_List"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", "Print", "}"}], ",", "\n", "   ", 
     RowBox[{"cached", "[", 
      RowBox[{
       RowBox[{"\"\<E_\>\"", " ", "<>", " ", 
        RowBox[{"ToString", "[", "m", "]"}], " ", "<>", " ", "\"\<_d\>\"", 
        " ", "<>", " ", 
        RowBox[{"StringJoin", "[", 
         RowBox[{"ToString", " ", "/@", " ", 
          RowBox[{"Sort", "[", "ds", "]"}]}], "]"}], " ", "<>", 
        " ", "\"\<_w\>\"", " ", "<>", " ", 
        RowBox[{"StringJoin", "[", 
         RowBox[{"ToString", " ", "/@", " ", 
          RowBox[{"Sort", "[", "w", "]"}]}], "]"}]}], ",", "\n", "    ", 
       RowBox[{"E$", "[", 
        RowBox[{"m", ",", " ", 
         RowBox[{"Sort", "[", "ds", "]"}], ",", " ", 
         RowBox[{"Sort", "[", "w", "]"}]}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"6bb64724-63e7-4b7a-86b8-c06b30d4266d"],

Cell["\<\
the non-vanishing index classes of a grade: sorted derivative and weight \
lists, every axis an even count\
\>", "Text",ExpressionUUID->"d10eee79-a233-4e3e-848b-521a82db7487"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"reps", "[", 
    RowBox[{"dd_", ",", " ", "ww_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Select", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"ds", ",", " ", "ws"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"ds", ",", " ", 
           RowBox[{"DeleteDuplicates", "[", 
            RowBox[{"Sort", " ", "/@", " ", 
             RowBox[{"Tuples", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
               "dd"}], "]"}]}], "]"}]}], "}"}], ",", "\n", "     ", 
         RowBox[{"{", 
          RowBox[{"ws", ",", " ", 
           RowBox[{"DeleteDuplicates", "[", 
            RowBox[{"Sort", " ", "/@", " ", 
             RowBox[{"Tuples", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
               "ww"}], "]"}]}], "]"}]}], "}"}]}], "]"}], ",", " ", "1"}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Range", "[", "3", "]"}], ",", " ", 
        RowBox[{"Function", "[", 
         RowBox[{"ax", ",", " ", 
          RowBox[{"EvenQ", "[", 
           RowBox[{"Count", "[", 
            RowBox[{
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", " ", "ax"}], 
            "]"}], "]"}]}], "]"}]}], "]"}], " ", "&"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"83e02714-2ef4-4f16-a367-19cafd019b6c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"xs", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"integrand", "[", 
    RowBox[{"ds_", ",", " ", "ws_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"Times", " ", "@@", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"xs", "[", 
          RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", " ", "ws"}], 
       ")"}]}], ")"}], " ", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"x", "^", "2"}], " ", "+", " ", 
         RowBox[{"y", "^", "2"}], " ", "+", " ", 
         RowBox[{"z", "^", "2"}]}], "]"}]}], ",", " ", 
      RowBox[{"Sequence", " ", "@@", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"xs", "[", 
           RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", " ", "ds"}],
         ")"}]}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"common", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"PrecisionGoal", " ", "->", " ", "10"}], ",", " ", 
     RowBox[{"AccuracyGoal", " ", "->", " ", "12"}], ",", " ", 
     RowBox[{"MaxRecursion", " ", "->", " ", "25"}], ",", " ", 
     RowBox[{"WorkingPrecision", " ", "->", " ", "20"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"methods", " ", "=", " ", 
   RowBox[{"<|", "\n", "   ", 
    RowBox[{
     RowBox[{"\"\<plain\>\"", " ", "->", " ", "\"\<GlobalAdaptive\>\""}], ",",
      "\n", "   ", 
     RowBox[{"\"\<duffy\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<GlobalAdaptive\>\"", ",", " ", 
        RowBox[{"\"\<SingularityHandler\>\"", " ", "->", 
         " ", "\"\<DuffyCoordinates\>\""}]}], "}"}]}], ",", "\n", "   ", 
     RowBox[{"\"\<maxerr\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<GlobalAdaptive\>\"", ",", " ", 
        RowBox[{"\"\<MaxErrorIncreases\>\"", " ", "->", " ", 
         RowBox[{"10", "^", "4"}]}]}], "}"}]}]}], "|>"}]}], ";"}]}], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"9855a9be-2522-4ea3-90b9-86ec76f3ca28"],

Cell["\<\
one integration: {value, the names of the messages it issued, seconds}; \
NIntegrate holds its arguments, so the integrand and the options go in \
evaluated.  The handler sees every message, also those switched off by \
default (General::newsym), which no run would ever print: a message whose \
name evaluates to $Off[...] is not recorded\
\>", "Text",ExpressionUUID->"351834cf-96de-4e39-852a-5585070cac0b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"recordMessage", ",", " ", "HoldFirst"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"recordMessage", "[", "names_Symbol", "]"}], "[", "h_", "]"}], 
   " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"mn", " ", "=", " ", 
       RowBox[{"Extract", "[", 
        RowBox[{"h", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", "HoldForm"}], 
        "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", 
         RowBox[{"ReleaseHold", "[", "mn", "]"}], "]"}], " ", "=!=", " ", 
        "$Off"}], ",", " ", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"names", ",", " ", 
         RowBox[{"ToString", "[", "mn", "]"}]}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"integrate", "[", 
    RowBox[{"g_", ",", " ", "method_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"names", " ", "=", " ", 
        RowBox[{"{", "}"}]}], ",", " ", "v", ",", " ", "t"}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "v"}], "}"}], " ", "=", " ", 
       RowBox[{"AbsoluteTiming", "[", 
        RowBox[{"Internal`HandlerBlock", "[", "\n", "      ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<Message\>\"", ",", " ", 
            RowBox[{"recordMessage", "[", "names", "]"}]}], "}"}], ",", "\n", 
          "      ", 
          RowBox[{"Quiet", "[", 
           RowBox[{"8", " ", 
            RowBox[{"NIntegrate", "[", 
             RowBox[{
              RowBox[{"Evaluate", "[", "g", "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"x", ",", " ", "0", ",", " ", 
                RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"y", ",", " ", "0", ",", " ", 
                RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"z", ",", " ", "0", ",", " ", 
                RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
              RowBox[{"Method", " ", "->", " ", "method"}], ",", "\n", 
              "         ", 
              RowBox[{"Evaluate", "[", 
               RowBox[{"Sequence", " ", "@@", " ", "common"}], "]"}]}], 
             "]"}]}], "]"}]}], "]"}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"{", 
       RowBox[{"v", ",", " ", 
        RowBox[{"DeleteCases", "[", 
         RowBox[{
          RowBox[{"DeleteDuplicates", "[", "names", "]"}], ",", " ", 
          
          RowBox[{"\"\<$Off[]\>\"", " ", "|", 
           " ", "\"\<General::stop\>\""}]}], "]"}], ",", " ", "t"}], 
       "}"}]}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"a8434189-d0a6-4053-afaf-107a99f9b899"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", \
"\"\<==============================================================\>\"", 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<ADAPTIVE CUBATURE AT THE CORNER OF THE OCTANT\>\"", 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", \
"\"\<==============================================================\>\"", 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rows", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"dd", " ", "=", " ", 
         RowBox[{"grade", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
        RowBox[{"ww", " ", "=", " ", 
         RowBox[{"grade", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", "\n", "   ", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<  grade (\>\"", ",", " ", "dd", ",", " ", "\"\<,\>\"", ",",
          " ", "ww", ",", " ", "\"\<): \>\"", ",", " ", 
         RowBox[{"Length", "[", 
          RowBox[{"reps", "[", 
           RowBox[{"dd", ",", " ", "ww"}], "]"}], "]"}], ",", 
         " ", "\"\< classes\>\""}], "]"}], ";", "\n", "   ", 
       RowBox[{"Do", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"ds", " ", "=", " ", 
              RowBox[{"cl", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
             RowBox[{"ws", " ", "=", " ", 
              RowBox[{"cl", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", "ref", ",", " ", 
             "g", ",", " ", "res", ",", " ", "line"}], "}"}], ",", "\n", 
           "     ", 
           RowBox[{
            RowBox[{"ref", " ", "=", " ", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"eC", "[", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", " ", "ds", ",", " ", "ws"}], "]"}],
                 " ", "/.", " ", 
                RowBox[{"Del", " ", "->", " ", "1"}]}], ",", " ", "30"}], 
              "]"}]}], ";", "\n", "     ", 
            RowBox[{"g", " ", "=", " ", 
             RowBox[{"integrand", "[", 
              RowBox[{"ds", ",", " ", "ws"}], "]"}]}], ";", "\n", "     ", 
            RowBox[{"res", " ", "=", " ", 
             RowBox[{"AssociationMap", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"integrate", "[", 
                 RowBox[{"g", ",", " ", 
                  RowBox[{"methods", "[", "#", "]"}]}], "]"}], " ", "&"}], ",",
                " ", 
               RowBox[{"{", 
                RowBox[{"\"\<plain\>\"", ",", " ", "\"\<duffy\>\""}], "}"}]}],
               "]"}]}], ";", "\n", "     ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"res", "[", "\"\<plain\>\"", "]"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}], " ", "=!=", " ", 
               RowBox[{"{", "}"}]}], ",", " ", 
              RowBox[{
               RowBox[{"res", "[", "\"\<maxerr\>\"", "]"}], " ", "=", " ", 
               RowBox[{"integrate", "[", 
                RowBox[{"g", ",", " ", 
                 RowBox[{"methods", "[", "\"\<maxerr\>\"", "]"}]}], "]"}]}]}],
              "]"}], ";", "\n", "     ", 
            RowBox[{"line", " ", "=", " ", 
             RowBox[{"\"\<    d \>\"", " ", "<>", " ", 
              RowBox[{"ToString", "[", "ds", "]"}], " ", "<>", 
              " ", "\"\< w \>\"", " ", "<>", " ", 
              RowBox[{"ToString", "[", "ws", "]"}], " ", "<>", 
              " ", "\"\<:\>\""}]}], ";", "\n", "     ", 
            RowBox[{"Do", "[", "\n", "      ", 
             RowBox[{
              RowBox[{"With", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"r", " ", "=", " ", 
                   RowBox[{"res", "[", "k", "]"}]}], ",", " ", 
                  RowBox[{"rel", " ", "=", " ", 
                   RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"res", "[", "k", "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "ref"}], 
                    "]"}], "/", 
                    RowBox[{"Max", "[", 

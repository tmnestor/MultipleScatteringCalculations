Cell["the summary the papers cite", "Text",ExpressionUUID->"872f3166-ec20-4035-a965-d81bdff643fe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Print", "[", "\"\<  summary, over every class:\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", " ", "=", " ", 
        RowBox[{"Select", "[", 
         RowBox[{"rows", ",", " ", 
          RowBox[{
           RowBox[{"#method", " ", "==", " ", "k"}], " ", "&"}]}], "]"}]}], 
       "}"}], ",", "\n", "   ", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<    \>\"", ",", " ", "k", ",", " ", "\"\<: \>\"", ",", 
        " ", 
        RowBox[{"Length", "[", "r", "]"}], ",", " ", "\"\< integrations, \>\"",
         ",", " ", 
        RowBox[{"Count", "[", 
         RowBox[{"r", ",", " ", 
          RowBox[{"_", "?", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"#messages", " ", "=!=", " ", 
              RowBox[{"{", "}"}]}], " ", "&"}], ")"}]}]}], "]"}], ",", 
        " ", "\"\< with a message (\>\"", ",", "\n", "    ", 
        RowBox[{"StringRiffle", "[", 
         RowBox[{
          RowBox[{"DeleteDuplicates", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{
             RowBox[{"#messages", " ", "&"}], " ", "/@", " ", "r"}], "]"}], 
           "]"}], ",", " ", "\"\<, \>\""}], "]"}], ",", 
        " ", "\"\<), largest relative error \>\"", ",", "\n", "    ", 
        RowBox[{"eNote", "[", 
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", "\"\<relative_error\>\"", "]"}], " ", "&"}], 
           " ", "/@", " ", "r"}], "]"}], "]"}], ",", " ", "\"\<, total \>\"", 
        ",", " ", 
        RowBox[{"Round", "[", 
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{"#seconds", " ", "&"}], " ", "/@", " ", "r"}], "]"}], 
         "]"}], ",", " ", "\"\< s\>\""}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"k", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<plain\>\"", ",", " ", "\"\<duffy\>\"", ",", 
        " ", "\"\<maxerr\>\""}], "}"}]}], "}"}]}], "]"}], ";"}]}], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"7b567f09-1cce-46af-83a8-682f9b65ad19"],


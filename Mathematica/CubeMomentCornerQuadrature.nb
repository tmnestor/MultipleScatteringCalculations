Cell[BoxData[{
 RowBox[{
  RowBox[{"okDuffy", " ", "=", " ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{"rows", ",", " ", 
       RowBox[{
        RowBox[{"#method", " ", "==", " ", "\"\<duffy\>\""}], " ", "&"}]}], 
      "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"#messages", " ", "===", " ", 
        RowBox[{"{", "}"}]}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"#", "[", "\"\<relative_error\>\"", "]"}], " ", "<", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "12"}]}]}]}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"okPlain", " ", "=", " ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{"rows", ",", " ", 
       RowBox[{
        RowBox[{"#method", " ", "==", " ", "\"\<plain\>\""}], " ", "&"}]}], 
      "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", "\"\<relative_error\>\"", "]"}], " ", "<", " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "8"}]}]}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  Duffy coordinates: no message and agreement below 1e-12 on \
every class: \>\"", ",", " ", 
    RowBox[{"pass", "[", "okDuffy", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  plain GlobalAdaptive: within the check's 1e-8 on every \
class, messages or not: \>\"", ",", " ", 
    RowBox[{"pass", "[", "okPlain", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"DirectoryName", "[", "$nbInputFileName", "]"}], ",", 
       " ", "\"\<CubeMoment_corner_quadrature.json\>\""}], "}"}], "]"}], ",", 
    " ", "rows", ",", " ", "\"\<JSON\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  exported CubeMoment_corner_quadrature.json\>\"", "]"}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"okDuffy", " ", "&&", " ", "okPlain"}], ",", 
     " ", "\"\<ALL PASS\>\"", ",", " ", "\"\<SOME FAILED\>\""}], "]"}], "]"}],
   ";"}]}], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"d8071d99-f9ca-4557-b515-02d4fddae493"],


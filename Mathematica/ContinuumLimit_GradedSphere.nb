Cell["\<\
the benchmark: gate contrast, radius 10 m, core b = a/2, smoothstep shell\
\>", "Section",ExpressionUUID->"97d817b8-5c52-455b-ba6c-c45dd052fab1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"smooth", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"10", " ", 
     RowBox[{"x", "^", "3"}]}], " ", "-", " ", 
    RowBox[{"15", " ", 
     RowBox[{"x", "^", "4"}]}], " ", "+", " ", 
    RowBox[{"6", " ", 
     RowBox[{"x", "^", "5"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"aB", " ", "=", " ", "10"}], ";", " ", 
  RowBox[{"bB", " ", "=", " ", "5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bgB", " ", "=", " ", 
   RowBox[{"background", "[", 
    RowBox[{"5000", ",", " ", "3000", ",", " ", "2500"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dB", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"2", " ", 
      RowBox[{"10", "^", "9"}]}], ",", " ", 
     RowBox[{"1", " ", 
      RowBox[{"10", "^", "9"}]}], ",", " ", "100"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"profG", " ", "=", " ", 
   RowBox[{"Function", "[", 
    RowBox[{"x", ",", " ", 
     RowBox[{"Piecewise", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", 
          RowBox[{"x", " ", "<", " ", "bB"}]}], "}"}], "}"}], ",", " ", 
       RowBox[{"smooth", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"aB", " ", "-", " ", "x"}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"aB", " ", "-", " ", "bB"}], ")"}]}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"matG", " ", "=", " ", 
   RowBox[{"material", "[", 
    RowBox[{"bgB", ",", " ", "dB", ",", " ", "profG"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"omAt", "[", "kSa_", "]"}], " ", ":=", " ", 
   RowBox[{"kSa", " ", 
    RowBox[{"3000", "/", "aB"}]}]}], ";"}]}], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"0efaf8b7-0f21-4af3-b6bd-fca04c22dd40"],

Cell["\<\
[3] two-shell stepped sphere with the benchmark's contrast: propagator with a \
break vs the closed form\
\>", "Text",ExpressionUUID->"503d5b3a-fe3b-497e-903e-05dc72f39091"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"om0", " ", "=", " ", 
       RowBox[{"omAt", "[", "1", "]"}]}], ",", " ", 
      RowBox[{"fs", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", 
         RowBox[{"3", "/", "4"}], ",", " ", 
         RowBox[{"1", "/", "4"}]}], "}"}]}], ",", " ", 
      RowBox[{"rs", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{"bB", ",", " ", 
         RowBox[{"15", "/", "2"}], ",", " ", "aB"}], "}"}]}], ",", " ", 
      "step", ",", " ", 
      RowBox[{"worst", " ", "=", " ", "0"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"step", " ", "=", " ", 
      RowBox[{"Function", "[", 
       RowBox[{"x", ",", " ", 
        RowBox[{"Piecewise", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", 
              RowBox[{"x", " ", "<", " ", "bB"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"3", "/", "4"}], ",", " ", 
              RowBox[{"x", " ", "<", " ", 
               RowBox[{"15", "/", "2"}]}]}], "}"}]}], "}"}], ",", " ", 
          RowBox[{"1", "/", "4"}]}], "]"}]}], "]"}]}], ";", "\n", "  ", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"ode", ",", " ", "cf"}], "}"}], ",", "\n", "     ", 
         RowBox[{
          RowBox[{"ode", " ", "=", " ", 
           RowBox[{"TSSphereTMatrix", "[", 
            RowBox[{"n", ",", " ", "om0", ",", " ", "bgB", ",", " ", 
             RowBox[{"material", "[", 
              RowBox[{"bgB", ",", " ", "dB", ",", " ", "step"}], "]"}], ",", 
             " ", 
             RowBox[{"{", 
              RowBox[{"bB", ",", " ", "aB"}], "}"}], ",", " ", 
             RowBox[{"\"\<Breaks\>\"", " ", "->", " ", 
              RowBox[{"{", 
               RowBox[{"15", "/", "2"}], "}"}]}], ",", " ", 
             RowBox[{"WorkingPrecision", " ", "->", " ", "60"}]}], "]"}]}], ";",
           "\n", "     ", 
          RowBox[{"cf", " ", "=", " ", 
           RowBox[{"TSShellsTMatrix", "[", 
            RowBox[{
            "n", ",", " ", "om0", ",", " ", "bgB", ",", " ", "rs", ",", " ", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"bgB", " ", "+", " ", 
                RowBox[{"f", " ", "dB"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"f", ",", " ", "fs"}], "}"}]}], "]"}], ",", " ", 
             RowBox[{"WorkingPrecision", " ", "->", " ", "60"}]}], "]"}]}], ";",
           "\n", "     ", 
          RowBox[{"worst", " ", "=", " ", 
           RowBox[{"Max", "[", 
            RowBox[{"worst", ",", " ", 
             RowBox[{
              RowBox[{"Max", "[", 
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"ode", "[", "\"\<Tpsv\>\"", "]"}], " ", "-", " ", 
                 RowBox[{"cf", "[", "\"\<Tpsv\>\"", "]"}]}], "]"}], "]"}], "/", 
              RowBox[{"Max", "[", 
               RowBox[{"Abs", "[", 
                RowBox[{"cf", "[", "\"\<Tpsv\>\"", "]"}], "]"}], "]"}]}], ",",
              "\n", "       ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"n", " ", ">", " ", "0"}], ",", " ", 
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{
                  RowBox[{"ode", "[", "\"\<Tsh\>\"", "]"}], " ", "-", " ", 
                  RowBox[{"cf", "[", "\"\<Tsh\>\"", "]"}]}], "]"}], "/", 
                RowBox[{"Abs", "[", 
                 RowBox[{"cf", "[", "\"\<Tsh\>\"", "]"}], "]"}]}], ",", " ", 
               "0"}], "]"}]}], "]"}]}]}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}], ";", 
     "\n", "  ", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<  [3] two-shell stepped sphere, k_S a = 1, n = 0..6: \
propagator with a break vs closed form \>\"", ",", " ", 
       RowBox[{"sci", "[", "worst", "]"}], ",", "\n", "   ", "\"\< -> \>\"", ",",
        " ", 
       RowBox[{"chk", "[", 
        RowBox[{"worst", " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "20"}]}]}], "]"}]}], "]"}]}]}], "]"}], ";"}]], "Input",\

 CellLabel->"In[12]:=",ExpressionUUID->"6fe7be7c-611b-478b-ad46-ab9adfd5fc94"],

Cell[BoxData[
 TemplateBox[{
  "\"  [3] two-shell stepped sphere, k_S a = 1, n = 0..6: propagator with a \
break vs closed form \"", "\"3.84e-26\"", "\" -> \"", "\"PASS\""},
  "RowDefault"]], "Print",ExpressionUUID->"15decd30-d933-4319-be53-\
6bbb64dda6e5"],

Cell["\<\
[4], [5] the graded sphere: unitarity per order, and precision\
\>", "Text",ExpressionUUID->"941c660d-ff81-4421-81ce-e4881edcac1d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nMax", " ", "=", " ", "14"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"graded", " ", "=", " ", 
   RowBox[{"Association", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"kSa", " ", "->", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"TSSphereTMatrix", "[", 
          RowBox[{"n", ",", " ", 
           RowBox[{"omAt", "[", "kSa", "]"}], ",", " ", "bgB", ",", " ", 
           "matG", ",", " ", 
           RowBox[{"{", 
            RowBox[{"bB", ",", " ", "aB"}], "}"}], ",", " ", 
           RowBox[{"WorkingPrecision", " ", "->", " ", "90"}]}], "]"}], ",", 
         "\n", "      ", 
         RowBox[{"{", 
          RowBox[{"n", ",", " ", "0", ",", " ", "nMax"}], "}"}]}], "]"}]}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"kSa", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "2"}], ",", " ", "1"}], "}"}]}], "}"}]}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"worstU", " ", "=", " ", "0"}], ",", " ", 
      RowBox[{"worstP", " ", "=", " ", "0"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"rows", " ", "=", " ", 
            RowBox[{"graded", "[", "kSa", "]"}]}], ",", " ", "hi"}], "}"}], ",",
          "\n", "     ", 
         RowBox[{
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"row", " ", "=", " ", 
                 RowBox[{"rows", "[", 
                  RowBox[{"[", 
                   RowBox[{"n", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", 
                " ", "W", ",", " ", "S"}], "}"}], ",", "\n", "        ", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"n", " ", ">=", " ", "1"}], ",", "\n", "         ", 
                RowBox[{
                 RowBox[{"W", " ", "=", " ", 
                  RowBox[{"DiagonalMatrix", "[", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Sqrt", "[", "5000", "]"}], ",", " ", 
                    RowBox[{"Sqrt", "[", 
                    RowBox[{"3000", " ", "n", " ", 
                    RowBox[{"(", 
                    RowBox[{"n", " ", "+", " ", "1"}], ")"}]}], "]"}]}], 
                    "}"}], "]"}]}], ";", "\n", "         ", 
                 RowBox[{"S", " ", "=", " ", 
                  RowBox[{"W", " ", ".", " ", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
                    
                    RowBox[{"2", " ", 
                    RowBox[{"row", "[", "\"\<Tpsv\>\"", "]"}]}]}], ")"}], " ",
                    ".", " ", 
                   RowBox[{"Inverse", "[", "W", "]"}]}]}], ";", "\n", 
                 "         ", 
                 RowBox[{"worstU", " ", "=", " ", 
                  RowBox[{"Max", "[", 
                   RowBox[{"worstU", ",", " ", 
                    RowBox[{"Norm", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"ConjugateTranspose", "[", "S", "]"}], " ", ".", 
                    " ", "S"}], " ", "-", " ", 
                    RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], ",", 
                    " ", 
                    RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"1", " ", "+", " ", 
                    RowBox[{"2", " ", 
                    RowBox[{"row", "[", "\"\<Tsh\>\"", "]"}]}]}], "]"}], " ", 
                    "-", " ", "1"}], "]"}]}], "]"}]}]}], ",", "\n", 
                "         ", 
                RowBox[{"worstU", " ", "=", " ", 
                 RowBox[{"Max", "[", 
                  RowBox[{"worstU", ",", " ", 
                   RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"1", " ", "+", " ", 
                    RowBox[{"2", " ", 
                    RowBox[{
                    RowBox[{"row", "[", "\"\<Tpsv\>\"", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}]}], "]"}], 
                    " ", "-", " ", "1"}], "]"}]}], "]"}]}]}], "]"}]}], "]"}], 
            ",", " ", 
            RowBox[{"{", 
             RowBox[{"n", ",", " ", "0", ",", " ", "nMax"}], "}"}]}], "]"}], ";",
           "\n", "     ", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"hi", " ", "=", " ", 
              RowBox[{"TSSphereTMatrix", "[", 
               RowBox[{"n", ",", " ", 
                RowBox[{"omAt", "[", "kSa", "]"}], ",", " ", "bgB", ",", " ", 
                "matG", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"bB", ",", " ", "aB"}], "}"}], ",", " ", 
                RowBox[{"WorkingPrecision", " ", "->", " ", "120"}]}], 
               "]"}]}], ";", "\n", "      ", 
             RowBox[{"worstP", " ", "=", " ", 
              RowBox[{"Max", "[", 
               RowBox[{"worstP", ",", " ", 
                RowBox[{
                 RowBox[{"Max", "[", 
                  RowBox[{"Abs", "[", 
                   RowBox[{
                    RowBox[{"hi", "[", "\"\<Tpsv\>\"", "]"}], " ", "-", " ", 
                    RowBox[{
                    RowBox[{"rows", "[", 
                    RowBox[{"[", 
                    RowBox[{"n", " ", "+", " ", "1"}], "]"}], "]"}], 
                    "[", "\"\<Tpsv\>\"", "]"}]}], "]"}], "]"}], "/", 
                 RowBox[{"Max", "[", 
                  RowBox[{"Abs", "[", 
                   RowBox[{"hi", "[", "\"\<Tpsv\>\"", "]"}], "]"}], "]"}]}]}],
                "]"}]}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"n", ",", " ", 
              RowBox[{"{", 
               RowBox[{"0", ",", " ", "1", ",", " ", "2", ",", " ", "5"}], 
               "}"}]}], "}"}]}], "]"}]}]}], "]"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"kSa", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "2"}], ",", " ", "1"}], "}"}]}], "}"}]}], "]"}], 
     ";", "\n", "  ", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<  [4] graded sphere, k_S a = 0.5 and 1, n = 0..\>\"", ",", 
       " ", "nMax", ",", " ", "\"\<: worst unitarity defect \>\"", ",", " ", 
       RowBox[{"sci", "[", "worstU", "]"}], ",", " ", "\"\< -> \>\"", ",", 
       "\n", "   ", 
       RowBox[{"chk", "[", 
        RowBox[{"worstU", " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "35"}]}]}], "]"}]}], "]"}], ";", "\n", "  ", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<  [5] 90 vs 120 digits: \>\"", ",", " ", 
       RowBox[{"sci", "[", "worstP", "]"}], ",", " ", "\"\< -> \>\"", ",", 
       " ", 
       RowBox[{"chk", "[", 
        RowBox[{"worstP", " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "35"}]}]}], "]"}]}], "]"}]}]}], "]"}], ";"}]}], "Input",\

 CellLabel->"In[13]:=",ExpressionUUID->"78a62ff3-3972-4f6c-8932-6008a7cdfcac"],


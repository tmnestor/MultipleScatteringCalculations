Cell["\<\
the background and a contrast profile: moduli and density as functions of r\
\>", "Text",ExpressionUUID->"f33576bd-c7ec-4ddc-94c1-cdd560607332"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"background", "[", 
    RowBox[{"al_", ",", " ", "be_", ",", " ", "rh_"}], "]"}], " ", ":=", " ", 
   
   RowBox[{"{", 
    RowBox[{
     RowBox[{"rh", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"al", "^", "2"}], " ", "-", " ", 
        RowBox[{"2", " ", 
         RowBox[{"be", "^", "2"}]}]}], ")"}]}], ",", " ", 
     RowBox[{"rh", " ", 
      RowBox[{"be", "^", "2"}]}], ",", " ", "rh"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"material", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"lam0_", ",", " ", "mu0_", ",", " ", "rho0_"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"dl_", ",", " ", "dm_", ",", " ", "dr_"}], "}"}], ",", " ", 
     "f_"}], "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"x", ",", " ", 
       RowBox[{"lam0", " ", "+", " ", 
        RowBox[{"dl", " ", 
         RowBox[{"f", "[", "x", "]"}]}]}]}], "]"}], ",", " ", 
     RowBox[{"Function", "[", 
      RowBox[{"x", ",", " ", 
       RowBox[{"mu0", " ", "+", " ", 
        RowBox[{"dm", " ", 
         RowBox[{"f", "[", "x", "]"}]}]}]}], "]"}], ",", " ", 
     RowBox[{"Function", "[", 
      RowBox[{"x", ",", " ", 
       RowBox[{"rho0", " ", "+", " ", 
        RowBox[{"dr", " ", 
         RowBox[{"f", "[", "x", "]"}]}]}]}], "]"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"50dbb4ea-62d0-429a-a0e7-ac142180821d"],

Cell["\<\
[2] a uniform shell is the homogeneous sphere of MieTmatrixReference.wl\
\>", "Section",ExpressionUUID->"e464f61b-7a51-4c74-b265-04437586fe1e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"refJ", " ", "=", " ", 
   RowBox[{"Import", "[", 
    RowBox[{
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"DirectoryName", "[", "$nbInputFileName", "]"}], ",", 
        " ", "\"\<MieTmatrixReference.json\>\""}], "}"}], "]"}], ",", 
     " ", "\"\<RawJSON\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"g", " ", "=", " ", 
       RowBox[{
        RowBox[{"refJ", "[", "\"\<tmatrices\>\"", "]"}], "[", "\"\<gate\>\"", 
        "]"}]}], ",", " ", 
      RowBox[{"s", " ", "=", " ", 
       RowBox[{"11", "/", "10"}]}], ",", " ", 
      RowBox[{"om0", " ", "=", " ", "60"}], ",", " ", 
      RowBox[{"a", " ", "=", " ", "120"}], ",", " ", "bg", ",", " ", 
      RowBox[{"worst", " ", "=", " ", "0"}], ",", " ", "cpx", ",", " ", 
      "mat"}], "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"bg", " ", "=", " ", 
      RowBox[{"background", "[", 
       RowBox[{"5000", ",", " ", "3000", ",", " ", "2500"}], "]"}]}], ";", 
     "\n", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"the", " ", "reference", " ", "scales", " ", "alpha"}], ",", 
       " ", "beta", ",", " ", 
       RowBox[{"rho", " ", "by", " ", "s", " ", 
        RowBox[{"inside", ":", " ", 
         RowBox[{"moduli", " ", "by", " ", 
          RowBox[{"s", "^", "3"}]}]}]}]}], " ", "*)"}], "\n", "  ", 
     RowBox[{"mat", " ", "=", " ", 
      RowBox[{"material", "[", 
       RowBox[{"bg", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"s", "^", "3"}], " ", "-", " ", "1"}], ")"}], " ", 
           RowBox[{"bg", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"s", "^", "3"}], " ", "-", " ", "1"}], ")"}], " ", 
           RowBox[{"bg", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"s", " ", "-", " ", "1"}], ")"}], " ", 
           RowBox[{"bg", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}], ",", " ", 
        RowBox[{"1", " ", "&"}]}], "]"}]}], ";", "\n", "  ", 
     RowBox[{
      RowBox[{"cpx", "[", "v_", "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"v", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
       RowBox[{"I", " ", 
        RowBox[{"v", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}]}]}], ";", "\n", "  ", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"mine", " ", "=", " ", 
            RowBox[{"TSSphereTMatrix", "[", 
             RowBox[{
             "n", ",", " ", "om0", ",", " ", "bg", ",", " ", "mat", ",", " ", 
              
              RowBox[{"{", 
               RowBox[{
                RowBox[{"a", "/", "2"}], ",", " ", "a"}], "}"}], ",", " ", 
              RowBox[{"WorkingPrecision", " ", "->", " ", "60"}]}], "]"}]}], ",",
            " ", 
           RowBox[{"want", " ", "=", " ", 
            RowBox[{"g", "[", 
             RowBox[{"[", 
              RowBox[{"n", " ", "+", " ", "1"}], "]"}], "]"}]}]}], "}"}], ",",
          "\n", "     ", 
         RowBox[{"worst", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"worst", ",", " ", 
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"mine", "[", "\"\<Tpsv\>\"", "]"}], " ", "-", " ", 
                RowBox[{"Map", "[", 
                 RowBox[{"cpx", ",", " ", 
                  RowBox[{"want", "[", "\"\<Tpsv\>\"", "]"}], ",", " ", 
                  RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}], "]"}], "/", 
             RowBox[{"Max", "[", 
              RowBox[{"Abs", "[", 
               RowBox[{"Map", "[", 
                RowBox[{"cpx", ",", " ", 
                 RowBox[{"want", "[", "\"\<Tpsv\>\"", "]"}], ",", " ", 
                 RowBox[{"{", "2", "}"}]}], "]"}], "]"}], "]"}]}], ",", "\n", 
            "       ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"n", " ", ">", " ", "0"}], ",", " ", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"mine", "[", "\"\<Tsh\>\"", "]"}], " ", "-", " ", 
                 RowBox[{"cpx", "[", 
                  RowBox[{"want", "[", "\"\<Tsh\>\"", "]"}], "]"}]}], "]"}], "/", 
               RowBox[{"Abs", "[", 
                RowBox[{"cpx", "[", 
                 RowBox[{"want", "[", "\"\<Tsh\>\"", "]"}], "]"}], "]"}]}], ",",
               " ", "0"}], "]"}]}], "]"}]}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "0", ",", " ", "12"}], "}"}]}], "]"}], ";", 
     "\n", "  ", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<  [2] uniform shell (integrated across b = a/2 .. a) vs \
MieTmatrixReference 'gate', n = 0..12: \>\"", ",", " ", 
       RowBox[{"sci", "[", "worst", "]"}], ",", "\n", "   ", "\"\< -> \>\"", ",",
        " ", 
       RowBox[{"chk", "[", 
        RowBox[{"worst", " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "17"}]}]}], "]"}]}], "]"}]}]}], "]"}], ";"}]}], "Input",\

 CellLabel->"In[10]:=",ExpressionUUID->"aeee9ba6-c70e-4216-a399-2870328fd5cd"],


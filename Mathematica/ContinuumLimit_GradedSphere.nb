\>", "Text",ExpressionUUID->"a54454bf-6361-4b75-a485-3c6120215f46"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"reim", "[", "z_", "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"Re", "[", "z", "]"}], ",", " ", "20"}], "]"}], ",", " ", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"Im", "[", "z", "]"}], ",", " ", "20"}], "]"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"DirectoryName", "[", "$nbInputFileName", "]"}], ",", 
       " ", "\"\<ContinuumLimit_graded_sphere_tmatrix.json\>\""}], "}"}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<conventions\>\"", " ", "->", 
       " ", "\"\<T maps incident potential coefficients (P,S) to scattered \
(P,S); SH scalar likewise\>\""}], ",", "\n", "    ", 
      RowBox[{"\"\<profile\>\"", " ", "->", 
       " ", "\"\<core r < b carries the contrast; for b < r < a it is \
multiplied by s((a-r)/(a-b)), s = 10x^3-15x^4+6x^5\>\""}], ",", "\n", "    ", 
      
      RowBox[{"\"\<radius\>\"", " ", "->", " ", "aB"}], ",", " ", 
      RowBox[{"\"\<core\>\"", " ", "->", " ", "bB"}], ",", " ", 
      RowBox[{"\"\<alpha\>\"", " ", "->", " ", "5000"}], ",", " ", 
      RowBox[{"\"\<beta\>\"", " ", "->", " ", "3000"}], ",", " ", 
      RowBox[{"\"\<rho\>\"", " ", "->", " ", "2500"}], ",", "\n", "    ", 
      RowBox[{"\"\<contrast\>\"", " ", "->", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Dlambda\>\"", " ", "->", " ", 
          RowBox[{"2", " ", 
           RowBox[{"10", "^", "9"}]}]}], ",", " ", 
         RowBox[{"\"\<Dmu\>\"", " ", "->", " ", 
          RowBox[{"1", " ", 
           RowBox[{"10", "^", "9"}]}]}], ",", " ", 
         RowBox[{"\"\<Drho\>\"", " ", "->", " ", "100"}]}], "|>"}]}], ",", 
      "\n", "    ", 
      RowBox[{"\"\<sets\>\"", " ", "->", " ", 
       RowBox[{"Association", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ToString", "[", 
            RowBox[{"N", "[", "kSa", "]"}], "]"}], " ", "->", " ", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<kSa\>\"", " ", "->", " ", 
              RowBox[{"N", "[", "kSa", "]"}]}], ",", " ", 
             RowBox[{"\"\<omega\>\"", " ", "->", " ", 
              RowBox[{"N", "[", 
               RowBox[{"omAt", "[", "kSa", "]"}], "]"}]}], ",", "\n", 
             "        ", 
             RowBox[{"\"\<tmatrices\>\"", " ", "->", " ", 
              RowBox[{"MapIndexed", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"<|", 
                  RowBox[{
                   RowBox[{"\"\<n\>\"", " ", "->", " ", 
                    RowBox[{
                    RowBox[{"First", "[", "#2", "]"}], " ", "-", " ", "1"}]}],
                    ",", " ", 
                   RowBox[{"\"\<Tpsv\>\"", " ", "->", " ", 
                    RowBox[{"Map", "[", 
                    RowBox[{"reim", ",", " ", 
                    RowBox[{"#1", "[", "\"\<Tpsv\>\"", "]"}], ",", " ", 
                    RowBox[{"{", "2", "}"}]}], "]"}]}], ",", " ", 
                   RowBox[{"\"\<Tsh\>\"", " ", "->", " ", 
                    RowBox[{"reim", "[", 
                    RowBox[{"#1", "[", "\"\<Tsh\>\"", "]"}], "]"}]}]}], 
                  "|>"}], " ", "&"}], ",", "\n", "          ", 
                RowBox[{"graded", "[", "kSa", "]"}]}], "]"}]}]}], "|>"}]}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{"kSa", ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"1", "/", "2"}], ",", " ", "1"}], "}"}]}], "}"}]}], 
         "]"}], "]"}]}]}], "|>"}], ",", " ", "\"\<JSON\>\""}], "]"}], 
  ";"}]}], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"1cd3a3de-b7ab-43ba-b6d1-99576448b670"],


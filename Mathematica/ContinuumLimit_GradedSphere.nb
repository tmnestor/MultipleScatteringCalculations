Cell["\<\
[6] N homogeneous shells, each at the contrast of its mid-radius, converge to \
the graded sphere at 1/N^2\
\>", "Text",ExpressionUUID->"f38db034-b6e6-4760-9d82-1aff2ea90542"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"nn", " ", "=", " ", "2"}], ",", " ", "errs", ",", " ", 
      RowBox[{"ns", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "8", ",", " ", "16"}], "}"}]}], ",", " ", 
      "want", ",", " ", "ord"}], "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"want", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"graded", "[", "1", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"nn", " ", "+", " ", "1"}], "]"}], "]"}], "[", "\"\<Tpsv\>\"",
        "]"}]}], ";", "\n", "  ", 
     RowBox[{"errs", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"rs", ",", " ", "mids", ",", " ", "mats"}], "}"}], ",", 
          "\n", "     ", 
          RowBox[{
           RowBox[{"rs", " ", "=", " ", 
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"{", "bB", "}"}], ",", " ", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"bB", " ", "+", " ", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"aB", " ", "-", " ", "bB"}], ")"}], " ", 
                  RowBox[{"i", "/", "nsh"}]}]}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"i", ",", " ", "nsh"}], "}"}]}], "]"}]}], "]"}]}], ";",
            "\n", "     ", 
           RowBox[{"mids", " ", "=", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"bB", " ", "+", " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"aB", " ", "-", " ", "bB"}], ")"}], " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"i", " ", "-", " ", 
                   RowBox[{"1", "/", "2"}]}], ")"}], "/", "nsh"}]}]}], ",", 
              " ", 
              RowBox[{"{", 
               RowBox[{"i", ",", " ", "nsh"}], "}"}]}], "]"}]}], ";", "\n", 
           "     ", 
           RowBox[{"mats", " ", "=", " ", 
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"bgB", " ", "+", " ", "dB"}], "}"}], ",", " ", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"bgB", " ", "+", " ", 
                 RowBox[{
                  RowBox[{"profG", "[", "m", "]"}], " ", "dB"}]}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"m", ",", " ", "mids"}], "}"}]}], "]"}]}], "]"}]}], ";",
            "\n", "     ", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"TSShellsTMatrix", "[", 
                 RowBox[{"nn", ",", " ", 
                  RowBox[{"omAt", "[", "1", "]"}], ",", " ", "bgB", ",", " ", 
                  "rs", ",", " ", "mats", ",", " ", 
                  RowBox[{"WorkingPrecision", " ", "->", " ", "60"}]}], "]"}],
                 "[", "\"\<Tpsv\>\"", "]"}], " ", "-", " ", "want"}], "]"}], 
             "]"}], "/", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", "want", "]"}], "]"}]}]}]}], "]"}], ",", "\n",
         "    ", 
        RowBox[{"{", 
         RowBox[{"nsh", ",", " ", "ns"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
     RowBox[{"ord", " ", "=", " ", 
      RowBox[{"N", "[", 
       RowBox[{"Log", "[", 
        RowBox[{"2", ",", " ", 
         RowBox[{
          RowBox[{"Most", "[", "errs", "]"}], "/", 
          RowBox[{"Rest", "[", "errs", "]"}]}]}], "]"}], "]"}]}], ";", "\n", 
     "  ", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<  [6] N-shell closed form vs the graded sphere (k_S a = 1, \
n = 2), N = \>\"", ",", " ", "ns", ",", " ", "\"\<: \>\"", ",", " ", 
       RowBox[{"sci", " ", "/@", " ", "errs"}], ",", "\n", 
       "   ", "\"\<  order \>\"", ",", " ", "ord", ",", " ", "\"\< -> \>\"", ",",
        " ", 
       RowBox[{"chk", "[", 
        RowBox[{"AllTrue", "[", 
         RowBox[{"ord", ",", " ", 
          RowBox[{
           RowBox[{"1.8", " ", "<", " ", "#", " ", "<", " ", "2.2"}], " ", 
           "&"}]}], "]"}], "]"}]}], "]"}]}]}], "]"}], ";"}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"59a732f7-3f11-4fb0-a7dc-81383b3f5395"],

Cell[BoxData[
 TemplateBox[{
  "\"  [6] N-shell closed form vs the graded sphere (k_S a = 1, n = 2), N = \
\"", 
   RowBox[{"{", 
     RowBox[{"4", ",", "8", ",", "16"}], "}"}], "\": \"", 
   RowBox[{"{", 
     RowBox[{"\"0.00362\"", ",", "\"0.000981\"", ",", "\"0.00025\""}], "}"}], 
   "\"  order \"", 
   RowBox[{"{", 
     RowBox[{"1.8824656985226902`", ",", "1.9699201136974485`"}], "}"}], 
   "\" -> \"", "\"PASS\""},
  "RowDefault"]], "Print",ExpressionUUID->"0f131dcc-b175-45c0-bba4-\
45bf1c07c5f5"],


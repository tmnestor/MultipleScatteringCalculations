     RowBox[{"denominators", ".", " ", "Naively"}], "\n", "   ", "printing", " ", 
     RowBox[{"Inverse", "[", "B", "]"}], " ", "instead", " ", "gives", " ", 
     "every", " ", "entry", " ", "over", " ", "the", " ", "full", " ", 
     "determinant"}], ",", " ", 
    RowBox[{
    "and", "\n", "   ", "multiplying", " ", "back", " ", "through", " ", "by",
      " ", "det", " ", "and", " ", "expanding", " ", "does", " ", "NOT", " ", 
     
     RowBox[{"cancel", " ", "--"}], " ", "it", "\n", "   ", "distributes"}], ",",
     " ", 
    RowBox[{
    "and", " ", "the", " ", "4", "x4", " ", "came", " ", "out", " ", "at", " ",
      "2.9", " ", "MB", " ", "of", " ", "unusable", " ", 
     RowBox[{"output", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"adjugate", "[", "B_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"nn", " ", "=", " ", 
         RowBox[{"Length", "[", "B", "]"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"nn", " ", "==", " ", "1"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"{", "1", "}"}], "}"}], ",", "\n", "     ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "^", 
             RowBox[{"(", 
              RowBox[{"ii", " ", "+", " ", "jj"}], ")"}]}], " ", 
            RowBox[{"Det", "[", 
             RowBox[{
              RowBox[{"Drop", "[", 
               RowBox[{
                RowBox[{"Transpose", "[", "B", "]"}], ",", " ", 
                RowBox[{"{", "ii", "}"}], ",", " ", "None"}], "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", 
                RowBox[{"Drop", "[", 
                 RowBox[{
                  RowBox[{"Range", "[", "nn", "]"}], ",", " ", 
                  RowBox[{"{", "jj", "}"}]}], "]"}]}], "]"}], "]"}], "]"}]}], 
           ",", "\n", "       ", 
           RowBox[{"{", 
            RowBox[{"ii", ",", " ", "nn"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"jj", ",", " ", "nn"}], "}"}]}], "]"}]}], "]"}]}], 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"B", " ", "=", " ", 
        RowBox[{"blocks", "[", "key", "]"}]}], ";", " ", 
       RowBox[{"nn", " ", "=", " ", 
        RowBox[{"Length", "[", "B", "]"}]}], ";", "\n", "   ", 
       RowBox[{"Print", "[", "]"}], ";", "\n", "   ", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<--- \>\"", ",", " ", "key", ",", 
         " ", "\"\<^-1 = adj/det   (\>\"", ",", " ", "nn", ",", 
         " ", "\"\<x\>\"", ",", " ", "nn", ",", " ", "\"\<, appears \>\"", ",",
          "\n", "     ", 
         RowBox[{"dims", "[", "key", "]"}], ",", 
         " ", "\"\< times in M^-1) ---\>\""}], "]"}], ";", "\n", "   ", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<    det = \>\"", ",", " ", 
         RowBox[{"Factor", "[", 
          RowBox[{"Det", "[", "B", "]"}], "]"}]}], "]"}], ";", "\n", "   ", 
       RowBox[{"adj", " ", "=", " ", 
        RowBox[{"Factor", " ", "/@", " ", 
         RowBox[{"adjugate", "[", "B", "]"}]}]}], ";", "\n", "   ", 
       RowBox[{"Print", "[", "\"\<    adj =\>\"", "]"}], ";", "\n", "   ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<      [\>\"", ",", " ", "ii", ",", " ", "\"\<,\>\"", ",",
            " ", "jj", ",", " ", "\"\<]  \>\"", ",", " ", 
           RowBox[{"adj", "[", 
            RowBox[{"[", 
             RowBox[{"ii", ",", " ", "jj"}], "]"}], "]"}]}], "]"}], ",", " ", 
         
         RowBox[{"{", 
          RowBox[{"ii", ",", " ", "nn"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"jj", ",", " ", "nn"}], "}"}]}], "]"}], ";", "\n", "   ", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<    check adj.B == det I : \>\"", ",", "\n", "     ", 
         RowBox[{
          RowBox[{"Simplify", "[", 
           RowBox[{
            RowBox[{"adj", " ", ".", " ", "B"}], " ", "-", " ", 
            RowBox[{
             RowBox[{"Det", "[", "B", "]"}], " ", 
             RowBox[{"IdentityMatrix", "[", "nn", "]"}]}]}], "]"}], " ", "===",
           " ", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", " ", 
            RowBox[{"{", 
             RowBox[{"nn", ",", " ", "nn"}], "}"}]}], "]"}]}]}], "]"}]}], ",",
       "\n", " ", 
      RowBox[{"{", 
       RowBox[{"key", ",", " ", 
        RowBox[{"Keys", "[", "irreps", "]"}]}], "}"}]}], "]"}], ";"}], "\n", 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", " ", "verification"}]}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"MEMORY", "-", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"LEAN", " ", "--"}], "--"}], "--"}], "--"}], "--"}], "\n",
         "   ", "\:26a0", " ", "NOT", " ", "a", " ", "symbolic", " ", 
        RowBox[{"Det", "[", "M", "]"}]}]}], ":", " ", 
      RowBox[{
      "the", " ", "determinant", " ", "of", " ", "a", " ", "27", "x27", " ", 
       "matrix", " ", "in", " ", "19", " ", "parameters", "\n", "   ", "is", " ",
        "an", " ", "astronomically", " ", "large", " ", "expression", " ", 
       "and", " ", "exhausts", " ", 
       RowBox[{"memory", ".", " ", "Exact"}], " ", "RATIONAL", "\n", "   ", 
       "parameter", " ", "points", " ", "cost", " ", "nothing", " ", "and", " ",
        "prove", " ", "MORE"}]}], ",", " ", 
     RowBox[{
     "because", " ", "the", " ", "characteristic", "\n", "   ", "polynomial", 
      " ", "can", " ", "be", " ", "compared", " ", "rather", " ", "than", " ",
       "just", " ", "the", " ", 
      RowBox[{"determinant", " ", "--"}], " ", "see", "\n", "   ", 
      RowBox[{"CubeT27CommutantVerify", ".", "wl"}]}], ",", " ", 
     RowBox[{
     "which", " ", "does", " ", "this", " ", "at", " ", "five", " ", 
      "independent", " ", 
      RowBox[{"points", "."}]}]}], "     ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<[5] verification at an exact rational point (see \
CubeT27CommutantVerify.wl\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<    for the full characteristic-polynomial identity at \
five points):\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sub", " ", "=", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{"vars", " ", "->", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"RandomInteger", "[", 
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "40"}], "}"}], "]"}], "/", 
          RowBox[{"RandomInteger", "[", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "5"}], "}"}], "]"}]}], ",", " ", 
         RowBox[{"Length", "[", "vars", "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dm", " ", "=", " ", 
     RowBox[{"Det", "[", 
      RowBox[{"M", " ", "/.", " ", "sub"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"db", " ", "=", " ", 
     RowBox[{"Times", " ", "@@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Det", "[", 
          RowBox[{
           RowBox[{"blocks", "[", "key", "]"}], " ", "/.", " ", "sub"}], 
          "]"}], "^", 
         RowBox[{"dims", "[", "key", "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"key", ",", " ", 
          RowBox[{"Keys", "[", "irreps", "]"}]}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<    Det[M] == prod det(B_lambda)^d_lambda : \>\"", ",", " ", 
      RowBox[{"dm", " ", "===", " ", "db"}]}], "]"}], ";"}]}]}]], "Input",Expr\
